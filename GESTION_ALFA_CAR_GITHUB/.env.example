# ============================================================
# GESTION ALFA CAR - Configuration
# Copy this file to ".env" and fill in your real values.
# Never commit the actual .env file to git.
# ============================================================

# ----- Database -----
DB_HOST=localhost          # address of your MySQL/MariaDB server
DB_PORT=3306               # default MySQL port
DB_USER=root               # your database username
DB_PASSWORD=               # your database password (leave empty if none)
DB_NAME=GESTION_ALFA_CAR   # must match the database created by the SQL file

# ----- Session -----
SESSION_SECRET=change_this_to_a_long_random_string

# ----- App -----
PORT=3000                  # port the Node.js server listens on
NODE_ENV=development       # use "production" when deployed

# ----- Session timeout (milliseconds) -----
SESSION_TIMEOUT=3600000    # 1 hour
