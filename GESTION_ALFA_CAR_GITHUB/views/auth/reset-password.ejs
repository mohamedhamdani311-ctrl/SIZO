<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', { title: 'Réinitialiser le mot de passe', extraCss: [] }) %>
  <style>
    body { margin: 0; padding: 0; min-height: 100vh; font-family: 'Inter', sans-serif; background: #0a0a1a; display: flex; align-items: center; justify-content: center; }
    .auth-card { width: 100%; max-width: 440px; background: rgba(20, 20, 50, 0.6); backdrop-filter: blur(20px); border: 1px solid rgba(108,92,231,0.15); border-radius: 24px; padding: 2.5rem; box-shadow: 0 8px 40px rgba(0,0,0,0.3); margin: 2rem; }
    .auth-card .form-control { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; border-radius: 12px; padding: 14px 16px; font-size: 0.95rem; }
    .auth-card .form-control:focus { border-color: rgba(108,92,231,0.5); box-shadow: 0 0 0 3px rgba(108,92,231,0.1); }
    .auth-card .form-control::placeholder { color: rgba(255,255,255,0.3); }
    .auth-card label { color: rgba(255,255,255,0.7); font-weight: 500; font-size: 0.9rem; margin-bottom: 0.5rem; }
    .auth-btn { width: 100%; padding: 14px; background: linear-gradient(135deg, #6c5ce7, #a855f7); color: #fff; border: none; border-radius: 12px; font-weight: 700; font-size: 1rem; cursor: pointer; transition: all 0.4s ease; box-shadow: 0 4px 15px rgba(108,92,231,0.3); }
    .auth-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(108,92,231,0.5); }
    .strength-bar { height: 4px; border-radius: 2px; background: rgba(255,255,255,0.1); margin-top: 8px; overflow: hidden; }
    .strength-fill { height: 100%; border-radius: 2px; transition: all 0.3s ease; width: 0%; }
    .strength-text { font-size: 0.75rem; margin-top: 4px; }
  </style>
</head>
<body>
  <%- include('../partials/flash') %>

  <div class="auth-card">
    <div class="text-center mb-4">
      <a href="/" class="d-inline-flex align-items-center text-decoration-none mb-3">
        <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #6c5ce7, #00cec9); border-radius: 14px; display: flex; align-items: center; justify-content: center; margin-right: 10px;">
          <i class="fas fa-car-side text-white" style="font-size: 1.1rem;"></i>
        </div>
        <span style="font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 1.3rem; color: #fff;">ALFA <span style="background: linear-gradient(135deg, #6c5ce7, #00cec9); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">CAR</span></span>
      </a>
      <div style="width: 80px; height: 80px; background: rgba(108,92,231,0.1); border-radius: 20px; display: flex; align-items: center; justify-content: center; margin: 1rem auto;">
        <i class="fas fa-shield-alt" style="font-size: 2rem; color: #6c5ce7;"></i>
      </div>
      <h3 style="font-family: 'Poppins', sans-serif; font-weight: 700; color: #fff; margin-bottom: 0.3rem;">Nouveau Mot de Passe</h3>
      <p style="color: rgba(255,255,255,0.4); font-size: 0.9rem;">Choisissez un nouveau mot de passe sécurisé</p>
    </div>

    <form action="/auth/reset-password" method="POST" id="resetForm">
      <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>">

      <div class="mb-3">
        <label class="form-label"><i class="fas fa-lock me-1"></i>Nouveau mot de passe</label>
        <input type="password" class="form-control" name="password" id="newPassword" placeholder="Minimum 6 caractères" required minlength="6">
        <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
        <div class="strength-text" id="strengthText" style="color: rgba(255,255,255,0.4);"></div>
      </div>

      <div class="mb-4">
        <label class="form-label"><i class="fas fa-lock me-1"></i>Confirmer le mot de passe</label>
        <input type="password" class="form-control" name="confirmPassword" id="confirmPassword" placeholder="Confirmez votre nouveau mot de passe" required>
        <div id="matchError" style="display: none; color: #ff6b6b; font-size: 0.8rem; margin-top: 4px;">Les mots de passe ne correspondent pas</div>
      </div>

      <button type="submit" class="auth-btn mb-4">
        <i class="fas fa-save me-2"></i>Réinitialiser le Mot de Passe
      </button>
    </form>

    <div class="text-center">
      <a href="/auth/login" style="color: #6c5ce7; text-decoration: none; font-size: 0.9rem; font-weight: 500;">
        <i class="fas fa-arrow-left me-1"></i>Retour à la Connexion
      </a>
    </div>
  </div>

  <%- include('../partials/scripts', { extraScripts: [] }) %>

  <script>
    document.getElementById('newPassword').addEventListener('input', function() {
      var val = this.value;
      var strength = 0;
      var fill = document.getElementById('strengthFill');
      var text = document.getElementById('strengthText');
      if (val.length >= 6) strength++;
      if (val.length >= 8) strength++;
      if (/[A-Z]/.test(val)) strength++;
      if (/[0-9]/.test(val)) strength++;
      if (/[^A-Za-z0-9]/.test(val)) strength++;
      var colors = ['#ff4444', '#ff6b6b', '#ffa502', '#2ed573', '#00d4aa'];
      var labels = ['Très faible', 'Faible', 'Moyen', 'Fort', 'Très fort'];
      fill.style.width = (strength * 20) + '%';
      fill.style.background = colors[strength - 1] || '#ff4444';
      text.textContent = labels[strength - 1] || '';
      text.style.color = colors[strength - 1] || 'rgba(255,255,255,0.4)';
    });

    document.getElementById('resetForm').addEventListener('submit', function(e) {
      var pwd = document.getElementById('newPassword').value;
      var cpwd = document.getElementById('confirmPassword').value;
      if (pwd !== cpwd) {
        e.preventDefault();
        document.getElementById('matchError').style.display = 'block';
      }
    });

    document.getElementById('confirmPassword').addEventListener('input', function() {
      document.getElementById('matchError').style.display = 'none';
    });
  </script>
</body>
</html>
