<%- include('../partials/head', {title: 'Mes Factures', extraCss: '<link rel="stylesheet" href="/css/dashboard.css"><link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">'}) %>
<body data-theme="light">
<div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
        <div class="content-header">
            <button class="btn btn-link sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
            <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/client'}, {name:'Factures'}]}) %>
        </div>
        <div class="content-body">
            <h2 class="fw-bold mb-4"><i class="fas fa-file-invoice me-2"></i>Mes Factures</h2>
            <div class="card shadow-sm"><div class="card-body">
                <% if(typeof invoices!=='undefined' && invoices && invoices.length>0){ %>
                <div class="table-responsive"><table id="invoicesTable" class="table table-striped table-hover datatable">
                    <thead class="table-dark"><tr><th>#</th><th>N° Facture</th><th>Voiture</th><th>Montant</th><th>Date</th><th>Actions</th></tr></thead>
                    <tbody><% invoices.forEach(function(inv){ %>
                    <tr>
                        <td><%= inv.id_facture %></td>
                        <td><span class="fw-bold text-primary"><%= inv.numero_facture %></span></td>
                        <td><%= inv.marque||'' %> <%= inv.modele||'' %></td>
                        <td class="fw-bold"><%= inv.montant_total ? parseFloat(inv.montant_total).toLocaleString('fr-FR') : '0' %> MAD</td>
                        <td><%= inv.date_facture ? new Date(inv.date_facture).toLocaleDateString('fr-FR') : 'N/A' %></td>
                        <td>
                            <a href="/client/invoices/<%= inv.id_facture %>" class="btn btn-sm btn-info"><i class="fas fa-eye me-1"></i>Voir</a>
                            <button class="btn btn-sm btn-outline-secondary" onclick="window.open('/client/invoices/<%= inv.id_facture %>','_blank')"><i class="fas fa-print"></i></button>
                        </td>
                    </tr><% }); %></tbody>
                </table></div>
                <% }else{ %>
                <div class="text-center py-5"><i class="fas fa-file-invoice fa-4x text-muted mb-3"></i><h4 class="text-muted">Aucune facture</h4><p class="text-muted">Vos factures apparaîtront ici après validation de vos paiements.</p></div>
                <% } %>
            </div></div>
        </div>
    </main>
</div>
<%- include('../partials/flash') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/main.js"></script><script src="/js/dashboard.js"></script>
</body></html>
