<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Mes Factures', extraCss: ['/css/dashboard.css', 'https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; max-width: calc(100vw - 175px); box-sizing: border-box; overflow-x: hidden; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .page-title { font-family: 'Poppins', sans-serif; font-weight: 700; color: #212529; margin: 0 0 1.5rem; font-size: 1.5rem; }
    .table-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; }
    .table-card .table { color: #212529; font-size: 0.85rem; }
    .table-card .table thead th { background: #f0f0f5; color: #212529; border-color: #dee2e6; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
    .table-card .table td { border-color: #dee2e6; vertical-align: middle; color: #212529 !important; }
    .table-card .table tbody tr:hover { background: rgba(108,92,231,0.06); }
    .dataTables_wrapper .dataTables_filter input,
    .dataTables_wrapper .dataTables_length select { background: #fff; border: 1px solid #ced4da; color: #212529; border-radius: 8px; padding: 0.4rem 0.8rem; }
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate { color: #6c757d; margin-top: 1rem; }
    .dataTables_wrapper .dataTables_paginate .paginate_button { color: #495057 !important; background: #fff !important; border: 1px solid #dee2e6 !important; border-radius: 6px !important; margin: 0 2px; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: linear-gradient(135deg,#6c5ce7,#a855f7) !important; border-color: #6c5ce7 !important; color: #fff !important; }
    .dataTables_wrapper .dataTables_filter label,
    .dataTables_wrapper .dataTables_length label { color: #6c757d; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: #6c757d; }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; max-width: 100%; } }
  </style>
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle" id="sidebarToggle" style="color:#495057;font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/client/dashboard'}, {name:'Factures'}]}) %>
      </div>
      <div class="content-body">
        <h2 class="page-title"><i class="fas fa-file-invoice me-2" style="color:#6c5ce7;"></i>Mes Factures</h2>
        <div class="table-card">
          <% if (typeof invoices !== 'undefined' && invoices && invoices.length > 0) { %>
          <div class="table-responsive">
            <table id="invoicesTable" class="table table-striped table-hover" style="width:100%">
              <thead>
                <tr>
                  <th>#</th>
                  <th>N° Facture</th>
                  <th>Voiture</th>
                  <th>Montant</th>
                  <th>Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% invoices.forEach(function(inv) { %>
                <tr>
                  <td><%= inv.id_facture %></td>
                  <td><span class="fw-bold" style="color:#6c5ce7;"><%= inv.numero_facture %></span></td>
                  <td><strong><%= (inv.marque || '') + ' ' + (inv.modele || '') %></strong></td>
                  <td><strong><%= inv.montant_total ? parseFloat(inv.montant_total).toLocaleString('fr-FR') : '0' %> MAD</strong></td>
                  <td><%= inv.date_facture ? new Date(inv.date_facture).toLocaleDateString('fr-FR') : 'N/A' %></td>
                  <td>
                    <a href="/client/invoices/<%= inv.id_facture %>" class="btn btn-sm btn-outline-primary" style="border-radius:8px;font-size:0.75rem;"><i class="fas fa-eye me-1"></i>Voir</a>
                    <a href="/client/invoices/<%= inv.id_facture %>" target="_blank" class="btn btn-sm btn-outline-secondary" style="border-radius:8px;font-size:0.75rem;"><i class="fas fa-print"></i></a>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="empty-state">
            <i class="fas fa-file-invoice"></i>
            <h5>Aucune facture</h5>
            <p>Vos factures apparaîtront ici après validation de vos paiements.</p>
          </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
  <script>
    $(document).ready(function() {
      if ($('#invoicesTable').length && !$.fn.DataTable.isDataTable('#invoicesTable')) {
        $('#invoicesTable').DataTable({
          language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json' },
          scrollX: true, scrollCollapse: true, autoWidth: true, responsive: false,
          columnDefs: [{ orderable: false, targets: [5] }],
          order: [[4, 'desc']]
        });
      }
    });
  </script>
</body>
</html>
