<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Mon Profil', extraCss: ['/css/dashboard.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; max-width: calc(100vw - 175px); box-sizing: border-box; overflow-x: hidden; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .page-title { font-family: 'Poppins', sans-serif; font-weight: 700; color: #212529; margin: 0 0 1.5rem; font-size: 1.5rem; }
    .profile-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; }
    .profile-card .card-header-title { font-size: 1rem; font-weight: 600; color: #212529; padding-bottom: 0.75rem; border-bottom: 1px solid #dee2e6; margin-bottom: 1.2rem; }
    .profile-card .form-label { color: #495057; font-weight: 500; font-size: 0.85rem; }
    .profile-card .form-control, .profile-card .form-select { background: #ffffff; border: 1px solid #ced4da; color: #212529; border-radius: 10px; }
    .profile-card .form-control:focus { border-color: #6c5ce7; box-shadow: 0 0 0 3px rgba(108,92,231,0.2); }
    .profile-card .form-control::placeholder { color: #adb5bd; }
    .avatar-circle { width: 90px; height: 90px; background: linear-gradient(135deg,#e94560,#ff6b81); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 2.5rem; margin: 0 auto 0.8rem; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; max-width: 100%; } }
  </style>
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle" id="sidebarToggle" style="color:#495057;font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/client/dashboard'}, {name:'Profil'}]}) %>
      </div>
      <div class="content-body">
        <h2 class="page-title"><i class="fas fa-user me-2" style="color:#6c5ce7;"></i>Mon Profil</h2>
        <div class="row g-4">
          <div class="col-md-4">
            <div class="profile-card text-center">
              <div class="avatar-circle"><i class="fas fa-user"></i></div>
              <h4 class="fw-bold mt-2">
                <%= typeof clientData !== 'undefined' && clientData ? (clientData.nom || '') + ' ' + (clientData.prenom || '') : (user ? user.username : '') %>
              </h4>
              <p class="text-muted mb-1"><i class="fas fa-envelope me-1"></i><%= typeof clientData !== 'undefined' && clientData ? clientData.email || 'N/A' : '' %></p>
              <p class="text-muted mb-1"><i class="fas fa-phone me-1"></i><%= typeof clientData !== 'undefined' && clientData ? clientData.telephone || 'N/A' : '' %></p>
              <p class="text-muted mb-0"><i class="fas fa-map-marker-alt me-1"></i><%= typeof clientData !== 'undefined' && clientData ? clientData.adresse || 'N/A' : '' %></p>
              <span class="badge mt-3" style="background:linear-gradient(135deg,#6c5ce7,#a855f7);font-size:0.8rem;padding:0.4rem 1rem;">Client</span>
            </div>
          </div>
          <div class="col-md-8">
            <div class="profile-card">
              <div class="card-header-title"><i class="fas fa-edit me-2" style="color:#6c5ce7;"></i>Modifier le Profil</div>
              <form action="/client/profile" method="POST" enctype="multipart/form-data">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label">Nom</label>
                    <input type="text" name="nom" class="form-control" value="<%= typeof clientData !== 'undefined' && clientData ? clientData.nom || '' : '' %>">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Prénom</label>
                    <input type="text" name="prenom" class="form-control" value="<%= typeof clientData !== 'undefined' && clientData ? clientData.prenom || '' : '' %>">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Téléphone</label>
                    <input type="text" name="telephone" class="form-control" value="<%= typeof clientData !== 'undefined' && clientData ? clientData.telephone || '' : '' %>">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" class="form-control" value="<%= typeof clientData !== 'undefined' && clientData ? clientData.email || '' : '' %>">
                  </div>
                  <div class="col-12">
                    <label class="form-label">Adresse</label>
                    <input type="text" name="adresse" class="form-control" value="<%= typeof clientData !== 'undefined' && clientData ? clientData.adresse || '' : '' %>">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Photo de Profil</label>
                    <input type="file" name="profile_picture" class="form-control" accept="image/*">
                  </div>
                </div>
                <hr class="my-4">
                <h6 class="fw-bold mb-3" style="color:#212529;"><i class="fas fa-lock me-2" style="color:#6c5ce7;"></i>Changer le Mot de Passe</h6>
                <div class="row g-3">
                  <div class="col-md-4">
                    <label class="form-label">Mot de passe actuel</label>
                    <input type="password" name="current_password" class="form-control" placeholder="••••••">
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Nouveau mot de passe</label>
                    <input type="password" name="new_password" class="form-control" placeholder="••••••">
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Confirmer</label>
                    <input type="password" name="confirm_password" class="form-control" placeholder="••••••">
                  </div>
                </div>
                <button type="submit" class="btn btn-primary mt-4" style="background:linear-gradient(135deg,#6c5ce7,#a855f7);border:none;border-radius:10px;font-weight:600;padding:0.5rem 1.5rem;">
                  <i class="fas fa-save me-2"></i>Mettre à jour
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
