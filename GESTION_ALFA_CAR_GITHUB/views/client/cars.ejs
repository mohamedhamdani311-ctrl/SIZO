<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Voitures Disponibles', extraCss: ['/css/dashboard.css', '/css/style.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; max-width: calc(100vw - 175px); box-sizing: border-box; overflow-x: hidden; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .page-title { font-family: 'Poppins', sans-serif; font-weight: 700; color: #212529; margin: 0 0 1.5rem; font-size: 1.5rem; }
    .filter-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.25rem; margin-bottom: 1.5rem; }
    .filter-card .form-label { color: #495057; font-weight: 500; font-size: 0.85rem; }
    .filter-card .form-select, .filter-card .form-control { background: #fff; border: 1px solid #ced4da; color: #212529; border-radius: 8px; }
    .car-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; overflow: hidden; transition: transform 0.2s, box-shadow 0.2s; height: 100%; display: flex; flex-direction: column; }
    .car-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(108,92,231,0.15); border-color: #6c5ce7; }
    .car-card .car-img { height: 200px; object-fit: cover; width: 100%; }
    .car-card .car-placeholder { height: 200px; background: linear-gradient(135deg,#667eea,#764ba2); display: flex; align-items: center; justify-content: center; }
    .car-card .card-body { padding: 1.25rem; flex: 1; }
    .car-card .car-price { color: #6c5ce7; font-weight: 800; font-size: 1.3rem; }
    .car-card .car-specs { display: flex; gap: 1rem; flex-wrap: wrap; margin: 0.5rem 0 1rem; }
    .car-card .car-specs small { color: #6c757d; font-size: 0.8rem; }
    .car-card .card-footer { padding: 1rem 1.25rem; background: transparent; border-top: 1px solid #dee2e6; }
    .empty-state { text-align: center; padding: 4rem 1rem; color: #6c757d; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; max-width: 100%; } }
  </style>
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle" id="sidebarToggle" style="color:#495057;font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/client/dashboard'}, {name:'Voitures'}]}) %>
      </div>
      <div class="content-body">
        <h2 class="page-title"><i class="fas fa-car me-2" style="color:#e94560;"></i>Voitures Disponibles</h2>

        <div class="filter-card">
          <form action="/client/cars" method="GET" class="row g-3 align-items-end">
            <div class="col-md-2">
              <label class="form-label">Marque</label>
              <select name="marque" class="form-select">
                <option value="">Toutes</option>
                <% if (typeof brands !== 'undefined' && brands) { brands.forEach(function(b) { %>
                  <option value="<%= b.marque %>" <%= typeof filters !== 'undefined' && filters && filters.marque === b.marque ? 'selected' : '' %>><%= b.marque %></option>
                <% }); } %>
              </select>
            </div>
            <div class="col-md-2">
              <label class="form-label">Carburant</label>
              <select name="carburant" class="form-select">
                <option value="">Tous</option>
                <option value="Essence" <%= typeof filters !== 'undefined' && filters && filters.carburant === 'Essence' ? 'selected' : '' %>>Essence</option>
                <option value="Diesel" <%= typeof filters !== 'undefined' && filters && filters.carburant === 'Diesel' ? 'selected' : '' %>>Diesel</option>
                <option value="Hybride" <%= typeof filters !== 'undefined' && filters && filters.carburant === 'Hybride' ? 'selected' : '' %>>Hybride</option>
                <option value="Électrique" <%= typeof filters !== 'undefined' && filters && filters.carburant === 'Électrique' ? 'selected' : '' %>>Électrique</option>
              </select>
            </div>
            <div class="col-md-2">
              <label class="form-label">Boîte</label>
              <select name="boite_vitesse" class="form-select">
                <option value="">Toutes</option>
                <option value="Manuelle" <%= typeof filters !== 'undefined' && filters && filters.boite_vitesse === 'Manuelle' ? 'selected' : '' %>>Manuelle</option>
                <option value="Automatique" <%= typeof filters !== 'undefined' && filters && filters.boite_vitesse === 'Automatique' ? 'selected' : '' %>>Automatique</option>
              </select>
            </div>
            <div class="col-md-2">
              <label class="form-label">Prix Max (MAD)</label>
              <input type="number" name="prix_max" class="form-control" value="<%= typeof filters !== 'undefined' && filters ? filters.prix_max || '' : '' %>" placeholder="Ex: 500000">
            </div>
            <div class="col-md-2">
              <button type="submit" class="btn btn-primary w-100" style="border-radius:10px;"><i class="fas fa-search me-1"></i>Filtrer</button>
            </div>
            <div class="col-md-2">
              <a href="/client/cars" class="btn btn-outline-secondary w-100" style="border-radius:10px;">Réinitialiser</a>
            </div>
          </form>
        </div>

        <% if (typeof cars !== 'undefined' && cars && cars.length > 0) { %>
        <div class="row g-4">
          <% cars.forEach(function(c) { %>
          <div class="col-md-4">
            <div class="car-card">
              <% if (c.image) { %>
                <img src="<%= c.image %>" class="car-img" alt="<%= c.marque %> <%= c.modele %>">
              <% } else { %>
                <div class="car-placeholder"><i class="fas fa-car fa-4x text-white opacity-50"></i></div>
              <% } %>
              <div class="card-body">
                <h5 class="fw-bold mb-1"><%= c.marque %> <%= c.modele %></h5>
                <span class="badge bg-secondary mb-2"><%= c.annee %></span>
                <div class="car-specs">
                  <small><i class="fas fa-gas-pump me-1"></i><%= c.carburant %></small>
                  <small><i class="fas fa-cog me-1"></i><%= c.boite_vitesse %></small>
                  <small><i class="fas fa-tachometer-alt me-1"></i><%= c.kilometrage ? c.kilometrage.toLocaleString('fr-FR') : '0' %> km</small>
                </div>
                <div class="car-price"><%= c.prix ? parseFloat(c.prix).toLocaleString('fr-FR') : '0' %> MAD</div>
              </div>
              <div class="card-footer">
                <a href="/client/cars/<%= c.id_voiture %>" class="btn btn-primary w-100" style="border-radius:10px;font-weight:600;">
                  <i class="fas fa-eye me-1"></i>Voir Détails
                </a>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
        <% } else { %>
        <div class="empty-state">
          <i class="fas fa-car fa-4x mb-3"></i>
          <h4>Aucune voiture disponible</h4>
          <p>Revenez bientôt pour découvrir nos nouvelles offres.</p>
        </div>
        <% } %>

      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
