<%- include('../partials/head', {title: 'Mes Achats', extraCss: '<link rel="stylesheet" href="/css/dashboard.css"><link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">'}) %>
<body data-theme="light">
<div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
        <div class="content-header">
            <button class="btn btn-link sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
            <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/client'}, {name:'Achats'}]}) %>
        </div>
        <div class="content-body">
            <h2 class="fw-bold mb-4"><i class="fas fa-shopping-bag me-2"></i>Mes Achats</h2>
            <div class="card shadow-sm"><div class="card-body">
                <% if(typeof purchases!=='undefined' && purchases && purchases.length>0){ %>
                <div class="table-responsive"><table id="purchasesTable" class="table table-striped table-hover datatable">
                    <thead class="table-dark"><tr><th>#</th><th>Voiture</th><th>Montant</th><th>Type Paiement</th><th>Statut</th><th>Date</th></tr></thead>
                    <tbody><% purchases.forEach(function(p){ %>
                    <tr>
                        <td><%= p.id_vente %></td>
                        <td><%= p.marque||'' %> <%= p.modele||'' %></td>
                        <td class="fw-bold text-primary"><%= p.montant_total ? parseFloat(p.montant_total).toLocaleString('fr-FR') : '0' %> MAD</td>
                        <td><% if(p.type_paiement==='cash'){ %><span class="badge bg-info"><i class="fas fa-money-bill me-1"></i>Cash</span><% }else{ %><span class="badge bg-warning text-dark"><i class="fas fa-credit-card me-1"></i>Crédit</span><% } %></td>
                        <td><% if(p.statut_vente==='en_attente'){ %><span class="badge bg-warning text-dark">En attente</span><% }else if(p.statut_vente==='validee'){ %><span class="badge bg-success">Validée</span><% }else{ %><span class="badge bg-danger">Annulée</span><% } %></td>
                        <td><%= p.date_vente ? new Date(p.date_vente).toLocaleDateString('fr-FR') : 'N/A' %></td>
                    </tr><% }); %></tbody>
                </table></div>
                <% }else{ %>
                <div class="text-center py-5"><i class="fas fa-shopping-bag fa-4x text-muted mb-3"></i><h4 class="text-muted">Aucun achat</h4><p class="text-muted">Parcourez nos voitures pour effectuer un achat.</p><a href="/client/cars" class="btn btn-primary mt-2"><i class="fas fa-car me-1"></i>Voir les Voitures</a></div>
                <% } %>
            </div></div>
        </div>
    </main>
</div>
<%- include('../partials/flash') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/main.js"></script><script src="/js/dashboard.js"></script>
</body></html>
