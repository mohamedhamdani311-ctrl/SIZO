<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Mes Réservations', extraCss: ['/css/dashboard.css', 'https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; max-width: calc(100vw - 175px); box-sizing: border-box; overflow-x: hidden; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .page-title { font-family: 'Poppins', sans-serif; font-weight: 700; color: #212529; margin: 0 0 1.5rem; font-size: 1.5rem; }
    .table-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; }
    .table-card .table { color: #212529; font-size: 0.85rem; }
    .table-card .table thead th { background: #f0f0f5; color: #212529; border-color: #dee2e6; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
    .table-card .table td { border-color: #dee2e6; vertical-align: middle; color: #212529 !important; }
    .table-card .table tbody tr:hover { background: rgba(108,92,231,0.06); }
    .dataTables_wrapper .dataTables_filter input,
    .dataTables_wrapper .dataTables_length select { background: #fff; border: 1px solid #ced4da; color: #212529; border-radius: 8px; padding: 0.4rem 0.8rem; }
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate { color: #6c757d; margin-top: 1rem; }
    .dataTables_wrapper .dataTables_paginate .paginate_button { color: #495057 !important; background: #fff !important; border: 1px solid #dee2e6 !important; border-radius: 6px !important; margin: 0 2px; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: linear-gradient(135deg,#6c5ce7,#a855f7) !important; border-color: #6c5ce7 !important; color: #fff !important; }
    .dataTables_wrapper .dataTables_filter label,
    .dataTables_wrapper .dataTables_length label { color: #6c757d; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: #6c757d; }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; max-width: 100%; } }
  </style>
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle" id="sidebarToggle" style="color:#495057;font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/client/dashboard'}, {name:'Réservations'}]}) %>
      </div>
      <div class="content-body">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
          <h2 class="page-title mb-0"><i class="fas fa-calendar-alt me-2" style="color:#0984e3;"></i>Mes Réservations</h2>
          <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary" style="border-radius:10px;" onclick="printTable('reservationsTable','Mes Réservations')"><i class="fas fa-print me-1"></i>Imprimer</button>
            <button class="btn btn-sm btn-outline-danger" style="border-radius:10px;" onclick="exportTableToPDF('reservationsTable','mes-reservations','Mes Réservations')"><i class="fas fa-file-pdf me-1"></i>PDF</button>
            <button class="btn btn-sm btn-outline-success" style="border-radius:10px;" onclick="exportTableToExcel('reservationsTable','mes-reservations')"><i class="fas fa-file-excel me-1"></i>Excel</button>
          </div>
        </div>
        <div class="table-card">
          <% if (typeof reservations !== 'undefined' && reservations && reservations.length > 0) { %>
          <div class="table-responsive">
            <table id="reservationsTable" class="table table-striped table-hover" style="width:100%">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Voiture</th>
                  <th>Date Réservation</th>
                  <th>Date Expiration</th>
                  <th>Statut</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% reservations.forEach(function(r) { %>
                <tr>
                  <td><%= r.id_reservation %></td>
                  <td><strong><%= (r.marque || '') + ' ' + (r.modele || '') %></strong></td>
                  <td><%= r.date_reservation ? new Date(r.date_reservation).toLocaleDateString('fr-FR') : 'N/A' %></td>
                  <td><%= r.date_expiration ? new Date(r.date_expiration).toLocaleDateString('fr-FR') : 'N/A' %></td>
                  <td>
                    <% if (r.statut === 'en_attente') { %>
                      <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>En attente</span>
                    <% } else if (r.statut === 'confirmee' || r.statut === 'approuve' || r.statut === 'approuvé') { %>
                      <span class="badge bg-success"><i class="fas fa-check me-1"></i>Confirmée</span>
                    <% } else if (r.statut === 'expire' || r.statut === 'expiré') { %>
                      <span class="badge bg-secondary"><i class="fas fa-clock me-1"></i>Expirée</span>
                    <% } else { %>
                      <span class="badge bg-danger"><i class="fas fa-times me-1"></i>Annulée</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (r.statut === 'en_attente') { %>
                    <form action="/client/reservations/cancel/<%= r.id_reservation %>" method="POST" class="d-inline">
                      <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius:8px;font-size:0.75rem;"
                        onclick="event.preventDefault();Swal.fire({title:'Annuler cette réservation?',text:'Cette action est irréversible.',icon:'warning',showCancelButton:true,confirmButtonColor:'#e94560',cancelButtonText:'Non',confirmButtonText:'Oui, annuler'}).then(function(res){if(res.isConfirmed)event.target.closest('form').submit()})">
                        <i class="fas fa-times me-1"></i>Annuler
                      </button>
                    </form>
                    <% } else { %>
                      <span class="text-muted" style="font-size:0.8rem;">—</span>
                    <% } %>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="empty-state">
            <i class="fas fa-calendar-alt"></i>
            <h5>Aucune réservation</h5>
            <p>Parcourez nos voitures pour faire une réservation.</p>
            <a href="/client/cars" class="btn btn-primary mt-2"><i class="fas fa-car me-1"></i>Voir les Voitures</a>
          </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/print.js"></script>
  <script src="/js/export.js"></script>
  <script>
    $(document).ready(function() {
      if ($('#reservationsTable').length && !$.fn.DataTable.isDataTable('#reservationsTable')) {
        $('#reservationsTable').DataTable({
          language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json' },
          scrollX: true, scrollCollapse: true, autoWidth: true, responsive: false,
          columnDefs: [{ orderable: false, targets: [5] }],
          order: [[2, 'desc']]
        });
      }
    });
  </script>
</body>
</html>
