<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Mon Espace - Client', extraCss: ['/css/dashboard.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; max-width: calc(100vw - 175px); box-sizing: border-box; overflow-x: hidden; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .welcome-banner { background: linear-gradient(135deg, #6c5ce7, #a855f7); color: #fff; border-radius: 16px; padding: 2rem; margin-bottom: 2rem; }
    .welcome-banner h2 { color: #fff; font-weight: 700; margin-bottom: 0.4rem; }
    .welcome-banner p { color: rgba(255,255,255,0.85); margin: 0; }
    .stat-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem; }
    .stat-card h2 { color: #212529; font-weight: 800; margin: 0; }
    .stat-card p { color: #6c757d; margin: 0; font-size: 0.9rem; }
    .action-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; text-align: center; text-decoration: none; color: #212529; display: block; transition: transform 0.2s, box-shadow 0.2s; }
    .action-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(108,92,231,0.15); color: #212529; border-color: #6c5ce7; }
    .action-card i { display: block; font-size: 2.5rem; margin-bottom: 0.75rem; }
    .action-card h5 { font-weight: 700; margin-bottom: 0.3rem; }
    .action-card p { color: #6c757d; margin: 0; font-size: 0.85rem; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; max-width: 100%; } }
  </style>
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle" id="sidebarToggle" style="color:#495057;font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Tableau de Bord'}]}) %>
      </div>
      <div class="content-body">

        <div class="welcome-banner">
          <h2><i class="fas fa-hand-wave me-2"></i>Bienvenue, <%= user ? user.prenom || user.username : '' %> !</h2>
          <p>Gérez vos réservations, achats et factures depuis votre espace personnel.</p>
        </div>

        <div class="row g-4 mb-4">
          <div class="col-md-4">
            <a href="/client/reservations" class="stat-card text-decoration-none" style="cursor:pointer;transition:transform 0.2s,box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 8px 24px rgba(9,132,227,0.18)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:60px;height:60px;background:linear-gradient(135deg,#74b9ff,#0984e3)">
                <i class="fas fa-calendar-check text-white fa-xl"></i>
              </div>
              <div>
                <h2 style="color:#212529;"><%= typeof stats !== 'undefined' ? stats.totalReservations || 0 : 0 %></h2>
                <p style="color:#6c757d;">Mes Réservations</p>
              </div>
            </a>
          </div>
          <div class="col-md-4">
            <a href="/client/purchases" class="stat-card text-decoration-none" style="cursor:pointer;transition:transform 0.2s,box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 8px 24px rgba(0,184,148,0.18)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:60px;height:60px;background:linear-gradient(135deg,#00b894,#00cec9)">
                <i class="fas fa-shopping-cart text-white fa-xl"></i>
              </div>
              <div>
                <h2 style="color:#212529;"><%= typeof stats !== 'undefined' ? stats.totalPurchases || 0 : 0 %></h2>
                <p style="color:#6c757d;">Mes Achats</p>
              </div>
            </a>
          </div>
          <div class="col-md-4">
            <a href="/client/invoices" class="stat-card text-decoration-none" style="cursor:pointer;transition:transform 0.2s,box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 8px 24px rgba(108,92,231,0.18)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:60px;height:60px;background:linear-gradient(135deg,#a29bfe,#6c5ce7)">
                <i class="fas fa-file-invoice text-white fa-xl"></i>
              </div>
              <div>
                <h2 style="color:#212529;"><%= typeof stats !== 'undefined' ? stats.totalInvoices || 0 : 0 %></h2>
                <p style="color:#6c757d;">Mes Factures</p>
              </div>
            </a>
          </div>
        </div>

        <div class="row g-4">
          <div class="col-md-4">
            <a href="/client/cars" class="action-card">
              <i class="fas fa-car" style="color:#e94560;"></i>
              <h5>Parcourir les Voitures</h5>
              <p>Explorez notre catalogue</p>
            </a>
          </div>
          <div class="col-md-4">
            <a href="/client/reservations" class="action-card">
              <i class="fas fa-calendar-alt" style="color:#0984e3;"></i>
              <h5>Mes Réservations</h5>
              <p>Suivez vos réservations</p>
            </a>
          </div>
          <div class="col-md-4">
            <a href="/client/profile" class="action-card">
              <i class="fas fa-user-cog" style="color:#6c5ce7;"></i>
              <h5>Mon Profil</h5>
              <p>Gérez vos informations</p>
            </a>
          </div>
        </div>

      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
