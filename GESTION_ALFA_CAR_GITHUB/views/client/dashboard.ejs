<%- include('../partials/head', {title: 'Mon Espace - Client', extraCss: '<link rel="stylesheet" href="/css/dashboard.css">'}) %>
<body data-theme="light">
<div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
        <div class="content-header">
            <button class="btn btn-link sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
            <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Tableau de Bord'}]}) %>
        </div>
        <div class="content-body">
            <div class="card shadow-sm mb-4 border-0" style="background:linear-gradient(135deg,#1a1a2e,#16213e);color:white;">
                <div class="card-body p-4">
                    <h2 class="fw-bold"><i class="fas fa-hand-wave me-2"></i>Bienvenue, <%= user ? user.prenom || user.username : '' %> !</h2>
                    <p class="mb-0 opacity-75">Gérez vos réservations, achats et factures depuis votre espace personnel.</p>
                </div>
            </div>
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 stat-card h-100">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width:60px;height:60px;background:linear-gradient(135deg,#74b9ff,#0984e3)"><i class="fas fa-calendar-check text-white fa-xl"></i></div>
                            <div><h2 class="mb-0 fw-bold"><%= typeof stats!=='undefined' ? stats.reservations||0 : 0 %></h2><p class="text-muted mb-0">Mes Réservations</p></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 stat-card h-100">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width:60px;height:60px;background:linear-gradient(135deg,#00b894,#00cec9)"><i class="fas fa-shopping-cart text-white fa-xl"></i></div>
                            <div><h2 class="mb-0 fw-bold"><%= typeof stats!=='undefined' ? stats.purchases||0 : 0 %></h2><p class="text-muted mb-0">Mes Achats</p></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 stat-card h-100">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width:60px;height:60px;background:linear-gradient(135deg,#a29bfe,#6c5ce7)"><i class="fas fa-file-invoice text-white fa-xl"></i></div>
                            <div><h2 class="mb-0 fw-bold"><%= typeof stats!=='undefined' ? stats.invoices||0 : 0 %></h2><p class="text-muted mb-0">Mes Factures</p></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row g-4">
                <div class="col-md-4"><a href="/client/cars" class="card shadow-sm text-decoration-none h-100 border-0" style="transition:transform 0.3s;"><div class="card-body text-center p-4"><i class="fas fa-car fa-3x mb-3" style="color:#e94560"></i><h5 class="fw-bold">Parcourir les Voitures</h5><p class="text-muted">Explorez notre catalogue</p></div></a></div>
                <div class="col-md-4"><a href="/client/reservations" class="card shadow-sm text-decoration-none h-100 border-0" style="transition:transform 0.3s;"><div class="card-body text-center p-4"><i class="fas fa-calendar-alt fa-3x mb-3" style="color:#0984e3"></i><h5 class="fw-bold">Mes Réservations</h5><p class="text-muted">Suivez vos réservations</p></div></a></div>
                <div class="col-md-4"><a href="/client/profile" class="card shadow-sm text-decoration-none h-100 border-0" style="transition:transform 0.3s;"><div class="card-body text-center p-4"><i class="fas fa-user-cog fa-3x mb-3" style="color:#6c5ce7"></i><h5 class="fw-bold">Mon Profil</h5><p class="text-muted">Gérez vos informations</p></div></a></div>
            </div>
        </div>
    </main>
</div>
<%- include('../partials/flash') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/main.js"></script>
</body></html>
