<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Comptes en Attente - Admin', extraCss: ['/css/dashboard.css', 'https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .page-title-section { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
    .page-title-section h2 { font-family: 'Poppins', sans-serif; font-weight: 700; color: #212529; margin: 0; font-size: 1.5rem; }
    .table-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; opacity: 1 !important; }
    .table-card .table { color: #212529 !important; font-size: 0.85rem; }
    .table-card .table thead th { background: #f0f0f5; color: #212529; border-color: #dee2e6; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
    .table-card .table td { border-color: #dee2e6; vertical-align: middle; color: #212529 !important; }
    .table-card .table tbody tr:hover { background: rgba(108,92,231,0.07); }
    .dataTables_wrapper .dataTables_filter input, .dataTables_wrapper .dataTables_length select { background: #ffffff; border: 1px solid #ced4da; color: #212529; border-radius: 8px; padding: 0.4rem 0.8rem; }
    .dataTables_wrapper .dataTables_info, .dataTables_wrapper .dataTables_paginate { color: #6c757d; margin-top: 1rem; }
    .dataTables_wrapper .dataTables_paginate .paginate_button { color: #495057 !important; background: #ffffff !important; border: 1px solid #dee2e6 !important; border-radius: 6px !important; margin: 0 2px; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: linear-gradient(135deg, #6c5ce7, #a855f7) !important; border-color: #6c5ce7 !important; color: #fff !important; }
    .dataTables_wrapper .dataTables_filter label, .dataTables_wrapper .dataTables_length label { color: #6c757d; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: #6c757d; }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; } }
  </style>
</head>
<body data-theme="dark">
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle d-lg-none" onclick="toggleSidebar()" style="color:rgba(255,255,255,0.6);font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/admin/dashboard'}, {name:'Comptes en Attente'}]}) %>
      </div>
      <div class="content-body">
        <div class="page-title-section">
          <h2><i class="fas fa-user-clock me-2" style="color: #6c5ce7;"></i>Comptes en Attente d'Approbation</h2>
        </div>
        <div class="table-card">
          <% if (typeof pendingAccounts !== 'undefined' && pendingAccounts && pendingAccounts.length > 0) { %>
          <div class="table-responsive">
            <table id="accountsTable" class="table table-striped table-hover" style="width:100%">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Nom d'utilisateur</th>
                  <th>Nom</th>
                  <th>Prénom</th>
                  <th>Email</th>
                  <th>Téléphone</th>
                  <th>Date Inscription</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% pendingAccounts.forEach(function(acc) { %>
                <tr>
                  <td><%= acc.id_utilisateur %></td>
                  <td><strong><%= acc.username %></strong></td>
                  <td><%= acc.nom || '' %></td>
                  <td><%= acc.prenom || '' %></td>
                  <td><%= acc.email || 'N/A' %></td>
                  <td><%= acc.telephone || 'N/A' %></td>
                  <td><%= acc.date_inscription ? new Date(acc.date_inscription).toLocaleDateString('fr-FR') : acc.date_creation ? new Date(acc.date_creation).toLocaleDateString('fr-FR') : 'N/A' %></td>
                  <td>
                    <div class="d-flex gap-1">
                      <form action="/admin/customers/approve/<%= acc.id_utilisateur %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-success" style="border-radius:8px;font-size:0.75rem;" onclick="return confirmApprove(event)">
                          <i class="fas fa-check me-1"></i>Approuver
                        </button>
                      </form>
                      <form action="/admin/customers/reject/<%= acc.id_utilisateur %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius:8px;font-size:0.75rem;" onclick="return confirmReject(event)">
                          <i class="fas fa-times me-1"></i>Refuser
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="empty-state">
            <i class="fas fa-check-circle text-success"></i>
            <h5>Aucun compte en attente</h5>
            <p>Tous les comptes ont été traités.</p>
          </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
  <script>
    $(document).ready(function() {
      if ($('#accountsTable').length) {
        if ($.fn.DataTable.isDataTable('#accountsTable')) { $('#accountsTable').DataTable().destroy(); }
        $('#accountsTable').DataTable({
          language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json' },
          responsive: true,
          columnDefs: [{ orderable: false, targets: [7] }],
          order: [[6, 'desc']]
        });
      }
    });
    function confirmApprove(e) {
      e.preventDefault();
      Swal.fire({ title: 'Approuver ce compte ?', icon: 'question', showCancelButton: true, confirmButtonColor: '#22c55e', cancelButtonColor: '#6b7280', confirmButtonText: 'Oui, approuver', cancelButtonText: 'Annuler', background: '#1a1a2e', color: '#fff' }).then(function(r) { if (r.isConfirmed) e.target.submit(); });
      return false;
    }
    function confirmReject(e) {
      e.preventDefault();
      Swal.fire({ title: 'Refuser ce compte ?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#ef4444', cancelButtonColor: '#6b7280', confirmButtonText: 'Oui, refuser', cancelButtonText: 'Annuler', background: '#1a1a2e', color: '#fff' }).then(function(r) { if (r.isConfirmed) e.target.submit(); });
      return false;
    }
  </script>
</body>
</html>
