<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Gestion des Factures - Admin', extraCss: ['/css/dashboard.css', 'https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .page-title-section { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
    .page-title-section h2 { font-family: 'Poppins', sans-serif; font-weight: 700; color: #212529; margin: 0; font-size: 1.5rem; }
    .table-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; opacity: 1 !important; }
    .table-card .table { color: #212529 !important; font-size: 0.85rem; }
    .table-card .table thead th { background: #f0f0f5; color: #212529; border-color: #dee2e6; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
    .table-card .table td { border-color: #dee2e6; vertical-align: middle; color: #212529 !important; }
    .table-card .table tbody tr:hover { background: rgba(108,92,231,0.07); }
    /* Invoice number highlight */
    .inv-num { color: #a78bfa !important; font-weight: 700; }
    .montant-cell { color: #4ade80 !important; font-weight: 700; }
    .dataTables_wrapper .dataTables_filter input, .dataTables_wrapper .dataTables_length select { background: #ffffff; border: 1px solid #ced4da; color: #212529; border-radius: 8px; padding: 0.4rem 0.8rem; }
    .dataTables_wrapper .dataTables_info, .dataTables_wrapper .dataTables_paginate { color: #6c757d; margin-top: 1rem; }
    .dataTables_wrapper .dataTables_paginate .paginate_button { color: #495057 !important; background: #ffffff !important; border: 1px solid #dee2e6 !important; border-radius: 6px !important; margin: 0 2px; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: linear-gradient(135deg, #6c5ce7, #a855f7) !important; border-color: #6c5ce7 !important; color: #fff !important; }
    .dataTables_wrapper .dataTables_filter label, .dataTables_wrapper .dataTables_length label { color: #6c757d; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: #6c757d; }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
    .table-responsive { overflow-x: auto !important; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; } }
  </style>
</head>
<body data-theme="dark">
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle d-lg-none" onclick="toggleSidebar()" style="color:rgba(255,255,255,0.6);font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/admin/dashboard'}, {name:'Factures'}]}) %>
      </div>
      <div class="content-body">
        <div class="page-title-section">
          <h2><i class="fas fa-file-invoice me-2" style="color: #6c5ce7;"></i>Gestion des Factures</h2>
          <% if (typeof invoices !== 'undefined' && invoices && invoices.length > 0) { %>
          <button onclick="printAllInvoices()" class="btn btn-sm" style="background:linear-gradient(135deg,#6c5ce7,#a855f7);color:#fff;border:none;border-radius:10px;padding:0.45rem 1.1rem;font-weight:600;font-size:0.82rem;box-shadow:0 2px 8px rgba(108,92,231,0.35);">
            <i class="fas fa-print me-1"></i>Imprimer Tout (<%= invoices.length %>)
          </button>
          <% } %>
        </div>

        <div class="table-card">
          <% if (typeof invoices !== 'undefined' && invoices && invoices.length > 0) { %>
          <div class="table-responsive">
            <table id="invoicesTable" class="table table-striped table-hover" style="width:100%">
              <thead>
                <tr>
                  <th><input type="checkbox" id="selectAll" class="form-check-input" onchange="document.querySelectorAll('.row-checkbox').forEach(c=>c.checked=this.checked)"></th>
                  <th>#</th>
                  <th>N° Facture</th>
                  <th>Client</th>
                  <th>Voiture</th>
                  <th>Montant</th>
                  <th>Date</th>
                  <th>Statut Envoi</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% invoices.forEach(function(inv) { %>
                <tr>
                  <td><input type="checkbox" class="form-check-input row-checkbox" value="<%= inv.id_facture %>"></td>
                  <td><%= inv.id_facture %></td>
                  <td><span class="inv-num"><%= inv.numero_facture %></span></td>
                  <td><strong><%= inv.client_nom || '' %> <%= inv.client_prenom || '' %></strong></td>
                  <td><%= inv.marque || '' %> <%= inv.modele || '' %></td>
                  <td><strong class="montant-cell"><%= inv.montant_total ? parseFloat(inv.montant_total).toLocaleString('fr-FR') : '0' %> MAD</strong></td>
                  <td><%= inv.date_facture ? new Date(inv.date_facture).toLocaleDateString('fr-FR') : 'N/A' %></td>
                  <td>
                    <% if (inv.statut_envoi === 'envoyee') { %>
                      <span class="badge bg-success"><i class="fas fa-check me-1"></i>Envoyée</span>
                    <% } else { %>
                      <span class="badge" style="background:rgba(107,114,128,0.3);color:rgba(255,255,255,0.6);border:1px solid rgba(107,114,128,0.4);"><i class="fas fa-clock me-1"></i>Non envoyée</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/admin/invoices/<%= inv.id_facture %>" class="btn btn-sm" style="background:rgba(6,182,212,0.15);color:#22d3ee;border:1px solid rgba(6,182,212,0.3);border-radius:8px;font-size:0.75rem;" title="Voir la facture">
                        <i class="fas fa-eye me-1"></i>Voir
                      </a>
                      <a href="/admin/invoices/<%= inv.id_facture %>?print=1" target="_blank" class="btn btn-sm" style="background:rgba(255,255,255,0.08);color:#e2e8f0;border:1px solid rgba(255,255,255,0.2);border-radius:8px;font-size:0.75rem;" title="Imprimer">
                        <i class="fas fa-print me-1"></i>Imprimer
                      </a>
                    </div>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="empty-state">
            <i class="fas fa-file-invoice"></i>
            <h5>Aucune facture trouvée</h5>
            <p>Les factures seront générées automatiquement après approbation des paiements.</p>
          </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/export.js"></script>
  <script>
    $(document).ready(function() {
      if ($('#invoicesTable').length) {
        if ($.fn.DataTable.isDataTable('#invoicesTable')) { $('#invoicesTable').DataTable().destroy(); }
        $('#invoicesTable').DataTable({
          language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json' },
          responsive: true,
          columnDefs: [{ orderable: false, targets: [0, 8] }],
          order: [[1, 'desc']]
        });
      }
    });

    // ── All invoices data embedded for print-all ──
    const allInvoicesData = <%- JSON.stringify((typeof invoices !== 'undefined' && invoices) ? invoices : []) %>;

    function printAllInvoices() {
      if (!allInvoicesData.length) return;

      function fmtDate(d) {
        if (!d) return 'N/A';
        var o = new Date(d);
        return isNaN(o) ? d : o.toLocaleDateString('fr-FR', {year:'numeric',month:'long',day:'numeric'});
      }
      function fmtNum(n) { return n ? parseFloat(n).toLocaleString('fr-FR') : '0'; }
      function esc(s) {
        return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }

      var pages = allInvoicesData.map(function(inv, idx) {
        var isLast = idx === allInvoicesData.length - 1;
        var agenceContact = (inv.agence_telephone || '') + ((inv.agence_telephone && inv.agence_email) ? ' | ' : '') + (inv.agence_email || '');
        var typeBadge = (inv.type_paiement || '').toLowerCase() === 'cash'
          ? '<span class="badge bg-info">Cash</span>'
          : '<span class="badge bg-warning text-dark">Crédit</span>';

        var creditBlock = '';
        if ((inv.type_paiement || '').toLowerCase() === 'credit') {
          creditBlock =
            '<div class="credit-info mb-4">' +
              '<h6><i class="fas fa-info-circle me-2"></i>Détails du Crédit</h6>' +
              '<div class="row">' +
                '<div class="col-md-3"><strong>Avance:</strong> ' + fmtNum(inv.montant_avance) + ' MAD</div>' +
                '<div class="col-md-3"><strong>Mensualités:</strong> ' + (inv.nombre_mensualites || 0) + ' mois</div>' +
                '<div class="col-md-3"><strong>Mensualité:</strong> ' + fmtNum(inv.mensualite) + ' MAD</div>' +
                '<div class="col-md-3"><strong>Taux:</strong> ' + (inv.taux_interet || 0) + '%</div>' +
              '</div>' +
            '</div>';
        }

        return (
          '<div class="invoice-card' + (isLast ? '' : ' page-break') + '">' +
            '<div class="card-body">' +
              '<div class="row mb-4">' +
                '<div class="col-6">' +
                  '<h2 class="invoice-title"><i class="fas fa-car me-2"></i>ALFA CAR</h2>' +
                  '<p class="text-muted mb-0">Système de Gestion de Vente de Voitures</p>' +
                  '<p class="text-muted mb-0">' + esc(inv.agence_nom || 'ALFA CAR') + '</p>' +
                  (inv.agence_adresse ? '<p class="text-muted mb-0">' + esc(inv.agence_adresse) + '</p>' : '') +
                  (agenceContact ? '<p class="text-muted mb-0">' + esc(agenceContact) + '</p>' : '') +
                '</div>' +
                '<div class="col-6 text-end">' +
                  '<h3 class="fw-bold text-uppercase" style="color:#212529;">FACTURE</h3>' +
                  '<p class="mb-1"><strong>N°:</strong> <span style="color:#6c5ce7;font-weight:700;">' + esc(inv.numero_facture) + '</span></p>' +
                  '<p class="mb-1"><strong>Date:</strong> ' + fmtDate(inv.date_facture) + '</p>' +
                '</div>' +
              '</div>' +
              '<hr style="border-color:#dee2e6;">' +
              '<div class="row mb-4 g-3">' +
                '<div class="col-md-6">' +
                  '<div class="info-box">' +
                    '<h5><i class="fas fa-user me-2" style="color:#6c5ce7;"></i>Client</h5>' +
                    '<p><strong>Nom:</strong> ' + esc((inv.client_nom || '') + ' ' + (inv.client_prenom || '')) + '</p>' +
                    '<p><strong>Email:</strong> ' + esc(inv.client_email || 'N/A') + '</p>' +
                    '<p><strong>Tél:</strong> ' + esc(inv.client_telephone || 'N/A') + '</p>' +
                    '<p><strong>Adresse:</strong> ' + esc(inv.client_adresse || 'N/A') + '</p>' +
                  '</div>' +
                '</div>' +
                '<div class="col-md-6">' +
                  '<div class="info-box">' +
                    '<h5><i class="fas fa-car me-2" style="color:#6c5ce7;"></i>Véhicule</h5>' +
                    '<p><strong>Marque:</strong> ' + esc(inv.marque || '') + '</p>' +
                    '<p><strong>Modèle:</strong> ' + esc(inv.modele || '') + '</p>' +
                    '<p><strong>Année:</strong> ' + esc(inv.annee || '') + '</p>' +
                    '<p><strong>Couleur:</strong> ' + esc(inv.couleur || 'N/A') + '</p>' +
                  '</div>' +
                '</div>' +
              '</div>' +
              '<div class="table-responsive mb-4">' +
                '<table class="table table-bordered" style="color:#212529;">' +
                  '<thead style="background:#6c5ce7;color:#fff;">' +
                    '<tr><th>Description</th><th>Type de Paiement</th><th class="text-end">Montant</th></tr>' +
                  '</thead>' +
                  '<tbody><tr>' +
                    '<td>' + esc((inv.marque||'') + ' ' + (inv.modele||'') + (inv.annee?' ('+inv.annee+')':'')) + '</td>' +
                    '<td>' + typeBadge + '</td>' +
                    '<td class="text-end fw-bold">' + fmtNum(inv.montant_total) + ' MAD</td>' +
                  '</tr></tbody>' +
                '</table>' +
              '</div>' +
              creditBlock +
              '<div class="row">' +
                '<div class="col-md-6 offset-md-6">' +
                  '<div class="total-box">' +
                    '<h4>TOTAL: ' + fmtNum(inv.montant_total) + ' MAD</h4>' +
                  '</div>' +
                '</div>' +
              '</div>' +
              '<div class="text-center mt-5 text-muted">' +
                '<hr style="border-color:#dee2e6;">' +
                '<small>Merci pour votre confiance — ALFA CAR, votre partenaire automobile</small>' +
              '</div>' +
            '</div>' +
          '</div>'
        );
      });

      var extraCss =
        'body{font-family:"Inter",sans-serif;background:#f8f9fa;color:#212529;padding:1.5rem;}' +
        '.invoice-card{background:#fff;border:1px solid #dee2e6;border-radius:16px;margin-bottom:2rem;}' +
        '.invoice-card .card-body{padding:2.5rem;}' +
        '.invoice-title{color:#6c5ce7;font-weight:800;}' +
        '.info-box{background:#f8f9fa;border:1px solid #dee2e6;border-radius:12px;padding:1.25rem;}' +
        '.info-box h5{color:#212529;font-weight:700;margin-bottom:1rem;}' +
        '.info-box p{color:#495057;margin-bottom:0.4rem;}' +
        '.total-box{background:linear-gradient(135deg,#6c5ce7,#a855f7);color:#fff;border-radius:12px;padding:1.25rem;text-align:right;}' +
        '.total-box h4{color:#fff;margin:0;font-weight:800;}' +
        '.credit-info{background:#fff8e1;border:1px solid #ffe082;border-radius:12px;padding:1rem;margin-bottom:1rem;}' +
        '.credit-info h6{color:#212529;font-weight:700;}' +
        '.page-break{page-break-after:always;}' +
        '@media print{' +
          'body{background:#fff!important;padding:0!important;}' +
          '.invoice-card{border:none!important;border-radius:0!important;box-shadow:none!important;margin-bottom:0!important;}' +
          '.invoice-card .card-body{padding:10mm!important;}' +
          '-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important;' +
          '@page{margin:10mm;size:A4;}' +
        '}';

      var html =
        '<!DOCTYPE html><html lang="fr"><head>' +
        '<meta charset="UTF-8">' +
        '<title>Toutes les Factures — ALFA CAR</title>' +
        '<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">' +
        '<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">' +
        '<style>' + extraCss + '</style>' +
        '</head><body>' +
        pages.join('') +
        '</body></html>';

      var win = window.open('', '_blank', 'width=960,height=800');
      if (!win) { Swal.fire('Bloqué', 'Veuillez autoriser les popups pour imprimer.', 'warning'); return; }
      win.document.write(html);
      win.document.close();
      win.addEventListener('load', function() { win.focus(); win.print(); });
    }
  </script>
</body>
</html>
