<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Gestion des Factures - Admin', extraCss: ['/css/dashboard.css', 'https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .page-title-section { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
    .page-title-section h2 { font-family: 'Poppins', sans-serif; font-weight: 700; color: #212529; margin: 0; font-size: 1.5rem; }
    .table-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; opacity: 1 !important; }
    .table-card .table { color: #212529 !important; font-size: 0.85rem; }
    .table-card .table thead th { background: #f0f0f5; color: #212529; border-color: #dee2e6; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
    .table-card .table td { border-color: #dee2e6; vertical-align: middle; color: #212529 !important; }
    .table-card .table tbody tr:hover { background: rgba(108,92,231,0.07); }
    /* Invoice number highlight */
    .inv-num { color: #a78bfa !important; font-weight: 700; }
    .montant-cell { color: #4ade80 !important; font-weight: 700; }
    .dataTables_wrapper .dataTables_filter input, .dataTables_wrapper .dataTables_length select { background: #ffffff; border: 1px solid #ced4da; color: #212529; border-radius: 8px; padding: 0.4rem 0.8rem; }
    .dataTables_wrapper .dataTables_info, .dataTables_wrapper .dataTables_paginate { color: #6c757d; margin-top: 1rem; }
    .dataTables_wrapper .dataTables_paginate .paginate_button { color: #495057 !important; background: #ffffff !important; border: 1px solid #dee2e6 !important; border-radius: 6px !important; margin: 0 2px; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: linear-gradient(135deg, #6c5ce7, #a855f7) !important; border-color: #6c5ce7 !important; color: #fff !important; }
    .dataTables_wrapper .dataTables_filter label, .dataTables_wrapper .dataTables_length label { color: #6c757d; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: #6c757d; }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
    .table-responsive { overflow-x: auto !important; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; } }
  </style>
</head>
<body data-theme="dark">
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle d-lg-none" onclick="toggleSidebar()" style="color:rgba(255,255,255,0.6);font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/admin/dashboard'}, {name:'Factures'}]}) %>
      </div>
      <div class="content-body">
        <div class="page-title-section">
          <h2><i class="fas fa-file-invoice me-2" style="color: #6c5ce7;"></i>Gestion des Factures</h2>
          <% if (typeof invoices !== 'undefined' && invoices && invoices.length > 0) { %>
          <button onclick="printAllInvoices()" class="btn btn-sm" style="background:linear-gradient(135deg,#6c5ce7,#a855f7);color:#fff;border:none;border-radius:10px;padding:0.45rem 1.1rem;font-weight:600;font-size:0.82rem;box-shadow:0 2px 8px rgba(108,92,231,0.35);">
            <i class="fas fa-print me-1"></i>Imprimer Tout (<%= invoices.length %>)
          </button>
          <% } %>
        </div>

        <div class="table-card">
          <% if (typeof invoices !== 'undefined' && invoices && invoices.length > 0) { %>
          <div class="table-responsive">
            <table id="invoicesTable" class="table table-striped table-hover" style="width:100%">
              <thead>
                <tr>
                  <th><input type="checkbox" id="selectAll" class="form-check-input" onchange="document.querySelectorAll('.row-checkbox').forEach(c=>c.checked=this.checked)"></th>
                  <th>#</th>
                  <th>N° Facture</th>
                  <th>Client</th>
                  <th>Voiture</th>
                  <th>Montant</th>
                  <th>Date</th>
                  <th>Statut Envoi</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% invoices.forEach(function(inv) { %>
                <tr>
                  <td><input type="checkbox" class="form-check-input row-checkbox" value="<%= inv.id_facture %>"></td>
                  <td><%= inv.id_facture %></td>
                  <td><span class="inv-num"><%= inv.numero_facture %></span></td>
                  <td><strong><%= inv.client_nom || '' %> <%= inv.client_prenom || '' %></strong></td>
                  <td><%= inv.marque || '' %> <%= inv.modele || '' %></td>
                  <td><strong class="montant-cell"><%= inv.montant_total ? parseFloat(inv.montant_total).toLocaleString('fr-FR') : '0' %> MAD</strong></td>
                  <td><%= inv.date_facture ? new Date(inv.date_facture).toLocaleDateString('fr-FR') : 'N/A' %></td>
                  <td>
                    <% if (inv.statut_envoi === 'envoyee') { %>
                      <span class="badge bg-success"><i class="fas fa-check me-1"></i>Envoyée</span>
                    <% } else { %>
                      <span class="badge" style="background:rgba(107,114,128,0.3);color:rgba(255,255,255,0.6);border:1px solid rgba(107,114,128,0.4);"><i class="fas fa-clock me-1"></i>Non envoyée</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/admin/invoices/<%= inv.id_facture %>" class="btn btn-sm" style="background:rgba(6,182,212,0.15);color:#22d3ee;border:1px solid rgba(6,182,212,0.3);border-radius:8px;font-size:0.75rem;" title="Voir la facture">
                        <i class="fas fa-eye me-1"></i>Voir
                      </a>
                      <a href="/admin/invoices/<%= inv.id_facture %>?print=1" target="_blank" class="btn btn-sm" style="background:rgba(255,255,255,0.08);color:#e2e8f0;border:1px solid rgba(255,255,255,0.2);border-radius:8px;font-size:0.75rem;" title="Imprimer">
                        <i class="fas fa-print me-1"></i>Imprimer
                      </a>
                    </div>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="empty-state">
            <i class="fas fa-file-invoice"></i>
            <h5>Aucune facture trouvée</h5>
            <p>Les factures seront générées automatiquement après approbation des paiements.</p>
          </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/export.js"></script>
  <script>
    $(document).ready(function() {
      if ($('#invoicesTable').length) {
        if ($.fn.DataTable.isDataTable('#invoicesTable')) { $('#invoicesTable').DataTable().destroy(); }
        $('#invoicesTable').DataTable({
          language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json' },
          responsive: true,
          columnDefs: [{ orderable: false, targets: [0, 9] }],
          order: [[1, 'desc']]
        });
      }
    });

    // ── All invoices data embedded for print-all ──
    const allInvoicesData = <%- JSON.stringify((typeof invoices !== 'undefined' && invoices) ? invoices : []) %>;

    function printAllInvoices() {
      if (!allInvoicesData.length) return;

      var css = [
        '* { box-sizing: border-box; margin: 0; padding: 0; }',
        'body { font-family: Arial, sans-serif; background: #fff; color: #212529; font-size: 11pt; }',
        '.invoice-page { width: 100%; padding: 14mm 14mm 10mm; page-break-after: always; }',
        '.invoice-page:last-child { page-break-after: avoid; }',
        '.header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10mm; }',
        '.brand { font-size: 18pt; font-weight: 900; color: #6c5ce7; }',
        '.brand-sub { font-size: 9pt; color: #666; margin-top: 2pt; }',
        '.inv-meta { text-align: right; }',
        '.inv-meta h2 { font-size: 16pt; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; color: #212529; }',
        '.inv-meta p { font-size: 10pt; color: #444; margin-top: 3pt; }',
        '.inv-num { color: #6c5ce7; font-weight: 700; }',
        'hr { border: none; border-top: 2px solid #dee2e6; margin: 6mm 0; }',
        '.info-row { display: flex; gap: 6mm; margin-bottom: 8mm; }',
        '.info-box { flex: 1; border: 1px solid #dee2e6; border-radius: 8px; padding: 5mm; }',
        '.info-box h4 { font-size: 10pt; font-weight: 700; color: #6c5ce7; margin-bottom: 4pt; border-bottom: 1px solid #eee; padding-bottom: 3pt; }',
        '.info-box p { font-size: 9.5pt; color: #444; margin-bottom: 2pt; }',
        'table { width: 100%; border-collapse: collapse; margin-bottom: 6mm; }',
        'thead tr { background: #6c5ce7; color: #fff; }',
        'th { padding: 5pt 8pt; font-size: 9.5pt; text-align: left; }',
        'td { padding: 6pt 8pt; font-size: 9.5pt; border-bottom: 1px solid #dee2e6; }',
        '.text-end { text-align: right; }',
        '.total-row { background: linear-gradient(135deg,#6c5ce7,#a855f7); color: #fff; border-radius: 6px; padding: 5mm 6mm; text-align: right; font-size: 13pt; font-weight: 900; margin-top: 4mm; }',
        '.credit-box { background: #fff8e1; border: 1px solid #ffe082; border-radius: 8px; padding: 4mm; margin-bottom: 6mm; font-size: 9pt; }',
        '.credit-box h4 { font-size: 9.5pt; font-weight: 700; margin-bottom: 3pt; }',
        '.credit-cols { display: flex; gap: 8mm; }',
        '.footer { text-align: center; font-size: 8.5pt; color: #888; margin-top: 8mm; border-top: 1px solid #dee2e6; padding-top: 4mm; }',
        '@page { margin: 0; size: A4; }',
        '@media print { body { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; } }'
      ].join('\n');

      function fmtDate(d) {
        if (!d) return 'N/A';
        var o = new Date(d);
        return isNaN(o) ? d : o.toLocaleDateString('fr-FR', {year:'numeric',month:'long',day:'numeric'});
      }
      function fmtNum(n) {
        return n ? parseFloat(n).toLocaleString('fr-FR') : '0';
      }
      function esc(s) {
        return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }

      var pages = allInvoicesData.map(function(inv) {
        var creditBlock = '';
        if ((inv.type_paiement || '').toLowerCase() === 'credit') {
          creditBlock = '<div class="credit-box">' +
            '<h4>&#9432; Détails du Crédit</h4>' +
            '<div class="credit-cols">' +
            '<div><strong>Avance:</strong> ' + fmtNum(inv.montant_avance) + ' MAD</div>' +
            '<div><strong>Mensualités:</strong> ' + (inv.nombre_mensualites || 0) + ' mois</div>' +
            '<div><strong>Mensualité:</strong> ' + fmtNum(inv.mensualite) + ' MAD</div>' +
            '<div><strong>Taux:</strong> ' + (inv.taux_interet || 0) + '%</div>' +
            '</div></div>';
        }
        var typeLabel = (inv.type_paiement || '').toLowerCase() === 'cash' ? 'Cash' : 'Crédit';

        return '<div class="invoice-page">' +
          '<div class="header">' +
            '<div>' +
              '<div class="brand">&#9632; ALFA CAR</div>' +
              '<div class="brand-sub">Système de Gestion de Vente de Voitures</div>' +
              (inv.agence_nom ? '<div class="brand-sub">' + esc(inv.agence_nom) + '</div>' : '') +
              (inv.agence_adresse ? '<div class="brand-sub">' + esc(inv.agence_adresse) + '</div>' : '') +
            '</div>' +
            '<div class="inv-meta">' +
              '<h2>FACTURE</h2>' +
              '<p>N° : <span class="inv-num">' + esc(inv.numero_facture) + '</span></p>' +
              '<p>Date : ' + fmtDate(inv.date_facture) + '</p>' +
            '</div>' +
          '</div>' +
          '<hr>' +
          '<div class="info-row">' +
            '<div class="info-box">' +
              '<h4>&#128100; Client</h4>' +
              '<p><strong>Nom :</strong> ' + esc((inv.client_nom || '') + ' ' + (inv.client_prenom || '')) + '</p>' +
              (inv.client_email ? '<p><strong>Email :</strong> ' + esc(inv.client_email) + '</p>' : '') +
              (inv.client_telephone ? '<p><strong>Tél :</strong> ' + esc(inv.client_telephone) + '</p>' : '') +
              (inv.client_adresse ? '<p><strong>Adresse :</strong> ' + esc(inv.client_adresse) + '</p>' : '') +
            '</div>' +
            '<div class="info-box">' +
              '<h4>&#128663; Véhicule</h4>' +
              '<p><strong>Marque :</strong> ' + esc(inv.marque || '') + '</p>' +
              '<p><strong>Modèle :</strong> ' + esc(inv.modele || '') + '</p>' +
              (inv.annee ? '<p><strong>Année :</strong> ' + esc(inv.annee) + '</p>' : '') +
              (inv.couleur ? '<p><strong>Couleur :</strong> ' + esc(inv.couleur) + '</p>' : '') +
            '</div>' +
          '</div>' +
          '<table>' +
            '<thead><tr><th>Description</th><th>Type de Paiement</th><th class="text-end">Montant</th></tr></thead>' +
            '<tbody><tr>' +
              '<td>' + esc((inv.marque || '') + ' ' + (inv.modele || '') + (inv.annee ? ' (' + inv.annee + ')' : '')) + '</td>' +
              '<td>' + typeLabel + '</td>' +
              '<td class="text-end"><strong>' + fmtNum(inv.montant_total) + ' MAD</strong></td>' +
            '</tr></tbody>' +
          '</table>' +
          creditBlock +
          '<div class="total-row">TOTAL : ' + fmtNum(inv.montant_total) + ' MAD</div>' +
          '<div class="footer">Merci pour votre confiance — ALFA CAR, votre partenaire automobile</div>' +
        '</div>';
      });

      var win = window.open('', '_blank', 'width=900,height=700');
      if (!win) { Swal.fire('Bloqué', 'Veuillez autoriser les popups pour imprimer.', 'warning'); return; }
      win.document.write('<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><title>Toutes les Factures</title><style>' + css + '</style></head><body>' + pages.join('') + '</body></html>');
      win.document.close();
      win.onload = function() { win.focus(); win.print(); };
    }
  </script>
</body>
</html>
