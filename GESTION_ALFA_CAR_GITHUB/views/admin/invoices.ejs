<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Gestion des Factures - Admin', extraCss: ['/css/dashboard.css', 'https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #0f0f23; color: #e2e8f0; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .page-title-section { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
    .page-title-section h2 { font-family: 'Poppins', sans-serif; font-weight: 700; color: #fff; margin: 0; font-size: 1.5rem; }
    .table-card { background: #1a1a2e; border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 1.5rem; opacity: 1 !important; }
    .table-card .table { color: #e2e8f0 !important; font-size: 0.85rem; }
    .table-card .table thead th { background: rgba(108,92,231,0.1); color: rgba(255,255,255,0.7); border-color: rgba(255,255,255,0.06); font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
    .table-card .table td { border-color: rgba(255,255,255,0.04); vertical-align: middle; color: #e2e8f0 !important; }
    .table-card .table tbody tr:hover { background: rgba(108,92,231,0.05); }
    /* Invoice number highlight */
    .inv-num { color: #a78bfa !important; font-weight: 700; }
    .montant-cell { color: #4ade80 !important; font-weight: 700; }
    .dataTables_wrapper .dataTables_filter input, .dataTables_wrapper .dataTables_length select { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #e2e8f0; border-radius: 8px; padding: 0.4rem 0.8rem; }
    .dataTables_wrapper .dataTables_info, .dataTables_wrapper .dataTables_paginate { color: rgba(255,255,255,0.5); margin-top: 1rem; }
    .dataTables_wrapper .dataTables_paginate .paginate_button { color: rgba(255,255,255,0.6) !important; background: transparent !important; border: 1px solid rgba(255,255,255,0.1) !important; border-radius: 6px !important; margin: 0 2px; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: linear-gradient(135deg, #6c5ce7, #a855f7) !important; border-color: #6c5ce7 !important; color: #fff !important; }
    .dataTables_wrapper .dataTables_filter label, .dataTables_wrapper .dataTables_length label { color: rgba(255,255,255,0.6); }
    .empty-state { text-align: center; padding: 3rem 1rem; color: rgba(255,255,255,0.4); }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
    .table-responsive { overflow-x: auto !important; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; } }
  </style>
</head>
<body data-theme="dark">
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle d-lg-none" onclick="toggleSidebar()" style="color:rgba(255,255,255,0.6);font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/admin/dashboard'}, {name:'Factures'}]}) %>
      </div>
      <div class="content-body">
        <div class="page-title-section">
          <h2><i class="fas fa-file-invoice me-2" style="color: #6c5ce7;"></i>Gestion des Factures</h2>
        </div>

        <div class="action-bar mb-3">
          <button class="btn btn-sm" style="background:rgba(255,255,255,0.1);color:#e2e8f0;border:1px solid rgba(255,255,255,0.2);border-radius:10px;" onclick="printTable('invoicesTable','Liste des Factures')"><i class="fas fa-print me-1"></i>Imprimer</button>
          <button class="btn btn-sm" style="background:rgba(239,68,68,0.15);color:#f87171;border:1px solid rgba(239,68,68,0.3);border-radius:10px;" onclick="exportTableToPDF('invoicesTable','factures','Liste des Factures')"><i class="fas fa-file-pdf me-1"></i>PDF</button>
          <button class="btn btn-sm" style="background:rgba(34,197,94,0.15);color:#4ade80;border:1px solid rgba(34,197,94,0.3);border-radius:10px;" onclick="exportTableToExcel('invoicesTable','factures')"><i class="fas fa-file-excel me-1"></i>Excel</button>
        </div>

        <div class="table-card">
          <% if (typeof invoices !== 'undefined' && invoices && invoices.length > 0) { %>
          <div class="table-responsive">
            <table id="invoicesTable" class="table table-striped table-hover" style="width:100%">
              <thead>
                <tr>
                  <th><input type="checkbox" id="selectAll" class="form-check-input" onchange="document.querySelectorAll('.row-checkbox').forEach(c=>c.checked=this.checked)"></th>
                  <th>#</th>
                  <th>N° Facture</th>
                  <th>Client</th>
                  <th>Voiture</th>
                  <th>Montant</th>
                  <th>Date</th>
                  <th>Statut Envoi</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% invoices.forEach(function(inv) { %>
                <tr>
                  <td><input type="checkbox" class="form-check-input row-checkbox" value="<%= inv.id_facture %>"></td>
                  <td><%= inv.id_facture %></td>
                  <td><span class="inv-num"><%= inv.numero_facture %></span></td>
                  <td><strong><%= inv.client_nom || '' %> <%= inv.client_prenom || '' %></strong></td>
                  <td><%= inv.marque || '' %> <%= inv.modele || '' %></td>
                  <td><strong class="montant-cell"><%= inv.montant_total ? parseFloat(inv.montant_total).toLocaleString('fr-FR') : '0' %> MAD</strong></td>
                  <td><%= inv.date_facture ? new Date(inv.date_facture).toLocaleDateString('fr-FR') : 'N/A' %></td>
                  <td>
                    <% if (inv.statut_envoi === 'envoyee') { %>
                      <span class="badge bg-success"><i class="fas fa-check me-1"></i>Envoyée</span>
                    <% } else { %>
                      <span class="badge" style="background:rgba(107,114,128,0.3);color:rgba(255,255,255,0.6);border:1px solid rgba(107,114,128,0.4);"><i class="fas fa-clock me-1"></i>Non envoyée</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/admin/invoices/<%= inv.id_facture %>" class="btn btn-sm" style="background:rgba(6,182,212,0.15);color:#22d3ee;border:1px solid rgba(6,182,212,0.3);border-radius:8px;font-size:0.75rem;" title="Voir la facture">
                        <i class="fas fa-eye me-1"></i>Voir
                      </a>
                      <button class="btn btn-sm" style="background:rgba(255,255,255,0.08);color:#e2e8f0;border:1px solid rgba(255,255,255,0.2);border-radius:8px;font-size:0.75rem;" onclick="printInvoiceById(<%= inv.id_facture %>)" title="Imprimer">
                        <i class="fas fa-print me-1"></i>Imprimer
                      </button>
                    </div>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="empty-state">
            <i class="fas fa-file-invoice"></i>
            <h5>Aucune facture trouvée</h5>
            <p>Les factures seront générées automatiquement après approbation des paiements.</p>
          </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/print.js"></script>
  <script src="/js/export.js"></script>
  <script>
    $(document).ready(function() {
      if ($('#invoicesTable').length) {
        if ($.fn.DataTable.isDataTable('#invoicesTable')) { $('#invoicesTable').DataTable().destroy(); }
        $('#invoicesTable').DataTable({
          language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json' },
          responsive: true,
          columnDefs: [{ orderable: false, targets: [0, 8] }],
          order: [[1, 'desc']]
        });
      }
    });
    function printInvoiceById(id) {
      fetch('/api/invoice/' + id)
        .then(r => r.json())
        .then(data => { if (data.success) printInvoice(data.data); })
        .catch(e => Swal.fire('Erreur', 'Impossible de charger la facture', 'error'));
    }
  </script>
</body>
</html>
