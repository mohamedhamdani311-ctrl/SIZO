<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Rapports - Admin', extraCss: ['/css/dashboard.css', 'https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; max-width: calc(100vw - 175px); box-sizing: border-box; }
    .content-body { width: 100%; max-width: 100%; overflow: hidden; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .sidebar-toggle { color: #495057 !important; }
    .page-title-section { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
    .page-title-section h2 { font-family: 'Poppins', sans-serif; font-weight: 700; color: #212529; margin: 0; font-size: 1.5rem; }
    .table-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; opacity: 1 !important; width: 100%; box-sizing: border-box; }
    .table-card label, .table-card h5, .table-card .form-label { color: #212529 !important; }
    /* Report select/input */
    .table-card .form-select, .table-card .form-control {
      background: #ffffff !important;
      border: 1px solid #ced4da !important;
      color: #212529 !important;
      border-radius: 10px;
    }
    .table-card .form-select option { background: #ffffff !important; color: #212529 !important; }
    .table-card .form-select:focus { border-color: #6c5ce7 !important; box-shadow: 0 0 0 3px rgba(108,92,231,0.2) !important; }
    /* Report table — fully responsive with horizontal scroll */
    .report-table-wrap { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; margin-top: 1rem; }
    #reportTableContainer { width: 100%; max-width: 100%; }
    #reportTable { width: 100%; border-collapse: collapse; table-layout: auto; }
    #reportTable th { background: #f0f0f5 !important; color: #212529 !important; padding: 8px 12px; font-size: 0.76rem; text-transform: uppercase; white-space: nowrap; border: 1px solid #dee2e6; font-weight: 600; }
    #reportTable td { color: #212529 !important; background: #ffffff; padding: 7px 12px; border: 1px solid #dee2e6; font-size: 0.82rem; white-space: nowrap; max-width: 200px; overflow: hidden; text-overflow: ellipsis; }
    #reportTable tbody tr:hover { background: #f5f3ff !important; }
    #reportTable tbody tr:hover td { background: #f5f3ff !important; }
    #reportTable tbody tr:nth-child(even) td { background: #fafafa; }
    /* Summary cards */
    .summary-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 12px; padding: 1.2rem; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
    .summary-card h3 { color: #6c5ce7; font-weight: 700; font-size: 1.5rem; margin-bottom: 0.3rem; }
    .summary-card p { color: #6c757d; font-size: 0.8rem; margin: 0; text-transform: uppercase; letter-spacing: 0.5px; }
    /* Report action buttons */
    .report-action-btn { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.4rem 0.9rem; border-radius: 8px; font-size: 0.82rem; font-weight: 500; cursor: pointer; border: 1px solid; text-decoration: none; }
    .btn-report-print { background: #f8f9fa; color: #495057; border-color: #dee2e6; }
    .btn-report-print:hover { background: #e9ecef; color: #212529; }
    .btn-report-pdf { background: rgba(239,68,68,0.08); color: #dc2626; border-color: rgba(239,68,68,0.3); }
    .btn-report-pdf:hover { background: rgba(239,68,68,0.15); color: #b91c1c; }
    .btn-report-excel { background: rgba(34,197,94,0.08); color: #16a34a; border-color: rgba(34,197,94,0.3); }
    .btn-report-excel:hover { background: rgba(34,197,94,0.15); color: #15803d; }
    /* Loading */
    #reportLoading p { color: #6c757d !important; }
    #reportResults { width: 100%; box-sizing: border-box; }
    #reportSummary { width: 100%; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; max-width: 100vw; } }
  </style>
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle d-lg-none" onclick="toggleSidebar()" style="font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/admin/dashboard'}, {name:'Rapports'}]}) %>
      </div>
      <div class="content-body">
        <div class="page-title-section">
          <h2><i class="fas fa-chart-bar me-2" style="color: #6c5ce7;"></i>Rapports</h2>
        </div>

        <!-- Report Controls -->
        <div class="table-card mb-4">
          <div class="row g-3 align-items-end">
            <div class="col-md-4">
              <label class="form-label fw-bold">Type de Rapport</label>
              <select id="reportType" class="form-select">
                <option value="cars">Voitures</option>
                <option value="customers">Clients</option>
                <option value="sellers">Vendeurs</option>
                <option value="sales">Ventes</option>
                <option value="reservations">Réservations</option>
                <option value="payments">Paiements</option>
                <option value="invoices">Factures</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Période</label>
              <select id="reportPeriod" class="form-select">
                <option value="all" selected>Toutes les périodes</option>
                <option value="daily">Aujourd'hui</option>
                <option value="monthly">Ce mois-ci</option>
                <option value="yearly">Cette année</option>
              </select>
            </div>
            <div class="col-md-4">
              <button id="generateReport" class="btn btn-primary w-100" style="background:linear-gradient(135deg,#6c5ce7,#a855f7);border:none;border-radius:10px;font-weight:600;padding:0.6rem 1rem;">
                <i class="fas fa-sync me-2"></i>Générer le Rapport
              </button>
            </div>
          </div>
        </div>

        <!-- Report Summary -->
        <div id="reportSummary" class="row g-3 mb-4" style="display:none;"></div>

        <!-- Report Results -->
        <div class="table-card" id="reportResults" style="display:none;">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <h5 class="mb-0" id="reportTitle">Résultats</h5>
            <div class="d-flex gap-2 flex-wrap">
              <button class="report-action-btn btn-report-print" onclick="printElement('reportTableContainer')"><i class="fas fa-print"></i>Imprimer</button>
              <button class="report-action-btn btn-report-pdf" onclick="exportTableToPDF('reportTable','rapport','Rapport')"><i class="fas fa-file-pdf"></i>PDF</button>
              <button class="report-action-btn btn-report-excel" onclick="exportTableToExcel('reportTable','rapport')"><i class="fas fa-file-excel"></i>Excel</button>
            </div>
          </div>
          <div id="reportTableContainer">
            <div class="report-table-wrap">
              <table id="reportTable" class="table table-striped table-hover">
                <thead id="reportTableHead"></thead>
                <tbody id="reportTableBody"></tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Loading -->
        <div id="reportLoading" class="text-center py-5" style="display:none;">
          <div class="spinner-border" style="color:#6c5ce7;width:3rem;height:3rem;" role="status"></div>
          <p class="mt-3" style="color:#6c757d;">Génération du rapport en cours...</p>
        </div>

      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/main.js"></script>
  <script src="/js/print.js"></script>
  <script src="/js/export.js"></script>
  <script>
  document.getElementById('generateReport').addEventListener('click', function() {
    var type = document.getElementById('reportType').value;
    var period = document.getElementById('reportPeriod').value;
    var loading = document.getElementById('reportLoading');
    var results = document.getElementById('reportResults');
    var summary = document.getElementById('reportSummary');
    loading.style.display = 'block';
    results.style.display = 'none';
    summary.style.display = 'none';
    fetch('/api/reports/' + type + '?period=' + period)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        loading.style.display = 'none';
        if (data.success) {
          // Summary cards
          var summaryHtml = '';
          if (data.summary) {
            Object.entries(data.summary).forEach(function(kv) {
              var key = kv[0], val = kv[1];
              var label = key.replace(/_/g, ' ').replace(/\b\w/g, function(l) { return l.toUpperCase(); });
              summaryHtml += '<div class="col-md-3"><div class="summary-card"><h3>' + (typeof val === 'number' ? val.toLocaleString('fr-FR') : val) + '</h3><p>' + label + '</p></div></div>';
            });
          }
          summary.innerHTML = summaryHtml;
          summary.style.display = 'flex';
          // Table
          if (data.data && data.data.length > 0) {
            var keys = Object.keys(data.data[0]);
            var headHtml = '<tr>';
            keys.forEach(function(k) { headHtml += '<th>' + k.replace(/_/g, ' ').replace(/\b\w/g, function(l) { return l.toUpperCase(); }) + '</th>'; });
            headHtml += '</tr>';
            document.getElementById('reportTableHead').innerHTML = headHtml;
            var bodyHtml = '';
            data.data.forEach(function(row) {
              bodyHtml += '<tr>';
              keys.forEach(function(k) {
                var v = (row[k] !== null && row[k] !== undefined) ? row[k] : '-';
                if (typeof v === 'number' && (k.includes('montant') || k.includes('prix') || k.includes('revenue'))) {
                  v = parseFloat(v).toLocaleString('fr-FR') + ' MAD';
                }
                bodyHtml += '<td>' + v + '</td>';
              });
              bodyHtml += '</tr>';
            });
            document.getElementById('reportTableBody').innerHTML = bodyHtml;
            document.getElementById('reportTitle').textContent = 'Rapport ' + document.getElementById('reportType').selectedOptions[0].text + ' — ' + document.getElementById('reportPeriod').selectedOptions[0].text;
            results.style.display = 'block';
          } else {
            results.style.display = 'none';
            Swal.fire({ icon: 'info', title: 'Aucune donnée', text: 'Aucune donnée trouvée pour cette période.', toast: true, position: 'top-end', timer: 3000, showConfirmButton: false });
          }
        } else {
          Swal.fire('Erreur', data.message || 'Erreur lors de la génération', 'error');
        }
      })
      .catch(function() {
        loading.style.display = 'none';
        Swal.fire('Erreur', 'Impossible de générer le rapport', 'error');
      });
  });
  </script>
</body>
</html>
