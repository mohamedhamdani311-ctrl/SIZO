<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: (typeof car !== 'undefined' && car) ? 'Modifier Voiture' : 'Ajouter Voiture', extraCss: ['/css/dashboard.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #0f0f23; color: #e2e8f0; margin: 0; }
    .main-content { margin-left: 280px; min-height: 100vh; padding: 2rem; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .form-card {
      background: rgba(255,255,255,0.03); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.06);
      border-radius: 16px; padding: 2rem;
    }
    .form-card .form-label { color: rgba(255,255,255,0.7); font-weight: 500; font-size: 0.85rem; margin-bottom: 0.4rem; }
    .form-card .form-control, .form-card .form-select {
      background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #e2e8f0;
      border-radius: 10px; padding: 0.6rem 1rem; transition: all 0.3s ease;
    }
    .form-card .form-control:focus, .form-card .form-select:focus { border-color: #6c5ce7; box-shadow: 0 0 0 3px rgba(108,92,231,0.15); background: rgba(255,255,255,0.08); color: #fff; }
    .form-card .form-control::placeholder { color: rgba(255,255,255,0.3); }
    .form-card textarea.form-control { min-height: 120px; resize: vertical; }
    .form-card .form-select option { background: #1a1a2e; color: #e2e8f0; }
    .image-preview-area {
      display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 0.8rem;
    }
    .image-preview-item {
      width: 100px; height: 75px; border-radius: 10px; overflow: hidden; border: 2px solid rgba(108,92,231,0.3);
      position: relative;
    }
    .image-preview-item img { width: 100%; height: 100%; object-fit: cover; }
    .section-title { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1rem; color: #fff; margin-bottom: 1.2rem; padding-bottom: 0.5rem; border-bottom: 1px solid rgba(108,92,231,0.2); }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; } }
  
    /* ===== DARK THEME FORCE ===== */
    .form-control, .form-select, textarea.form-control {
      background: rgba(30,30,70,0.85) !important;
      color: #e2e8f0 !important;
      border-color: rgba(255,255,255,0.18) !important;
    }
    .form-control:focus, .form-select:focus {
      background: rgba(40,40,90,0.95) !important;
      color: #fff !important;
      border-color: #6c5ce7 !important;
      box-shadow: 0 0 0 3px rgba(108,92,231,0.2) !important;
    }
    .form-control::placeholder { color: rgba(255,255,255,0.3) !important; }
    .form-select option { background: #1a1a2e !important; color: #e2e8f0 !important; }
    input:-webkit-autofill, input:-webkit-autofill:hover, input:-webkit-autofill:focus,
    textarea:-webkit-autofill, select:-webkit-autofill {
      -webkit-text-fill-color: #e2e8f0 !important;
      -webkit-box-shadow: 0 0 0 1000px #1a1a2e inset !important;
      transition: background-color 5000s ease-in-out 0s;
    }
  </style>
</head>
<body data-theme="dark">
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle d-lg-none" onclick="toggleSidebar()" style="color:rgba(255,255,255,0.6);font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/admin/dashboard'}, {name:'Voitures', url:'/admin/cars'}, {name: (typeof car !== 'undefined' && car) ? 'Modifier' : 'Ajouter'}]}) %>
      </div>
      <div class="content-body">

        <div class="d-flex align-items-center justify-content-between mb-4">
          <h2 style="font-family: 'Poppins', sans-serif; font-weight: 700; color: #fff; font-size: 1.5rem; margin: 0;">
            <i class="fas fa-<%= (typeof car !== 'undefined' && car) ? 'edit' : 'plus-circle' %> me-2" style="color: #6c5ce7;"></i>
            <%= (typeof car !== 'undefined' && car) ? 'Modifier Voiture' : 'Ajouter Voiture' %>
          </h2>
        </div>

        <div class="form-card">
          <form action="<%= (typeof car !== 'undefined' && car) ? '/admin/cars/edit/' + car.id_voiture : '/admin/cars/add' %>" method="POST" enctype="multipart/form-data">

            <div class="section-title"><i class="fas fa-info-circle me-2"></i>Informations Générales</div>
            <div class="row g-3 mb-4">
              <div class="col-md-4">
                <label class="form-label">Marque <span class="text-danger">*</span></label>
                <input type="text" class="form-control" name="marque" value="<%= (typeof car !== 'undefined' && car) ? car.marque : '' %>" required placeholder="Ex: Toyota">
              </div>
              <div class="col-md-4">
                <label class="form-label">Modèle <span class="text-danger">*</span></label>
                <input type="text" class="form-control" name="modele" value="<%= (typeof car !== 'undefined' && car) ? car.modele : '' %>" required placeholder="Ex: Corolla">
              </div>
              <div class="col-md-4">
                <label class="form-label">Année <span class="text-danger">*</span></label>
                <input type="number" class="form-control" name="annee" value="<%= (typeof car !== 'undefined' && car) ? car.annee : '' %>" required min="1990" max="2030" placeholder="Ex: 2024">
              </div>
            </div>

            <div class="section-title"><i class="fas fa-cogs me-2"></i>Caractéristiques</div>
            <div class="row g-3 mb-4">
              <div class="col-md-4">
                <label class="form-label">Prix (MAD) <span class="text-danger">*</span></label>
                <input type="number" class="form-control" name="prix" value="<%= (typeof car !== 'undefined' && car) ? car.prix : '' %>" required min="0" step="1000" placeholder="Ex: 250000">
              </div>
              <div class="col-md-4">
                <label class="form-label">Kilométrage</label>
                <input type="number" class="form-control" name="kilometrage" value="<%= (typeof car !== 'undefined' && car) ? car.kilometrage : '' %>" min="0" placeholder="Ex: 50000">
              </div>
              <div class="col-md-4">
                <label class="form-label">Couleur</label>
                <input type="text" class="form-control" name="couleur" value="<%= (typeof car !== 'undefined' && car) ? car.couleur || '' : '' %>" placeholder="Ex: Noir">
              </div>
              <div class="col-md-4">
                <label class="form-label">Carburant <span class="text-danger">*</span></label>
                <select class="form-select" name="carburant" required>
                  <option value="">-- Choisir --</option>
                  <% var carburants = ['Essence', 'Diesel', 'Hybride', 'Électrique']; %>
                  <% carburants.forEach(function(c) { %>
                    <option value="<%= c %>" <%= (typeof car !== 'undefined' && car && car.carburant === c) ? 'selected' : '' %>><%= c %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label">Boîte de Vitesse <span class="text-danger">*</span></label>
                <select class="form-select" name="boite_vitesse" required>
                  <option value="">-- Choisir --</option>
                  <option value="Manuelle" <%= (typeof car !== 'undefined' && car && car.boite_vitesse === 'Manuelle') ? 'selected' : '' %>>Manuelle</option>
                  <option value="Automatique" <%= (typeof car !== 'undefined' && car && car.boite_vitesse === 'Automatique') ? 'selected' : '' %>>Automatique</option>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label">Agence</label>
                <select class="form-select" name="id_agence">
                  <option value="">-- Choisir --</option>
                  <% if (typeof agencies !== 'undefined' && agencies) { %>
                    <% agencies.forEach(function(agency) { %>
                      <option value="<%= agency.id_agence %>" <%= (typeof car !== 'undefined' && car && car.id_agence == agency.id_agence) ? 'selected' : '' %>><%= agency.nom_agence || agency.nom %></option>
                    <% }); %>
                  <% } %>
                </select>
              </div>
            </div>

            <div class="section-title"><i class="fas fa-align-left me-2"></i>Description</div>
            <div class="row g-3 mb-4">
              <div class="col-12">
                <label class="form-label">Description</label>
                <textarea class="form-control" name="description" placeholder="Description détaillée de la voiture..."><%= (typeof car !== 'undefined' && car && car.description) ? car.description : '' %></textarea>
              </div>
            </div>

            <div class="section-title"><i class="fas fa-images me-2"></i>Images</div>
            <div class="row g-3 mb-4">
              <div class="col-12">
                <label class="form-label">Images de la voiture</label>
                <input type="file" class="form-control" name="images" multiple accept="image/*" id="imageInput">
                <small style="color: rgba(255,255,255,0.4);">Formats acceptés: JPG, PNG, WEBP. Taille max: 5MB par image.</small>
                <div class="image-preview-area" id="imagePreview">
                  <% if (typeof car !== 'undefined' && car && (car.image_principale || car.image)) { %>
                    <div class="image-preview-item">
                      <img src="/uploads/cars/<%= car.image_principale || car.image %>" alt="Image actuelle">
                    </div>
                  <% } %>
                </div>
              </div>
            </div>

            <div class="d-flex gap-2 pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
              <button type="submit" class="btn btn-primary px-4" style="background: linear-gradient(135deg, #6c5ce7, #a855f7); border: none; border-radius: 10px; font-weight: 600;">
                <i class="fas fa-save me-2"></i><%= (typeof car !== 'undefined' && car) ? 'Mettre à jour' : 'Enregistrer' %>
              </button>
              <a href="/admin/cars" class="btn btn-outline-light px-4" style="border-radius: 10px;">
                <i class="fas fa-arrow-left me-2"></i>Annuler
              </a>
            </div>

          </form>
        </div>

      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
  <script>
    document.getElementById('imageInput').addEventListener('change', function(e) {
      const preview = document.getElementById('imagePreview');
      preview.innerHTML = '';
      Array.from(e.target.files).forEach(function(file) {
        if (file.type.startsWith('image/')) {
          const reader = new FileReader();
          reader.onload = function(ev) {
            const div = document.createElement('div');
            div.className = 'image-preview-item';
            div.innerHTML = '<img src="' + ev.target.result + '" alt="Preview">';
            preview.appendChild(div);
          };
          reader.readAsDataURL(file);
        }
      });
    });
  </script>
</body>
</html>
