<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Gestion des Ventes', extraCss: ['/css/dashboard.css', 'https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; max-width: calc(100vw - 175px); box-sizing: border-box; overflow-x: hidden; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .page-title-section { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
    .page-title-section h2 { font-family: 'Poppins', sans-serif; font-weight: 700; color: #212529; margin: 0; font-size: 1.5rem; }
    .table-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; opacity: 1 !important; }
    .table-card .table { color: #212529 !important; font-size: 0.85rem; }
    .table-card .table thead th { background: #f0f0f5; color: #212529; border-color: #dee2e6; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
    .table-card .table td { border-color: #dee2e6; vertical-align: middle; color: #212529 !important; }
    .table-card .table td strong { color: #212529 !important; }
    .table-card .table tbody tr:hover { background: rgba(108,92,231,0.07); }
    /* Force badge readability */
    .table-card .badge.bg-warning { color: #212529 !important; }
    .table-card .badge.bg-info { color: #fff !important; }
    .table-card .badge.bg-primary { color: #fff !important; }
    /* Montant total color */
    .montant-total { color: #198754 !important; font-weight: 700; }
    .dataTables_wrapper .dataTables_filter input, .dataTables_wrapper .dataTables_length select { background: #ffffff; border: 1px solid #ced4da; color: #212529; border-radius: 8px; padding: 0.4rem 0.8rem; }
    .dataTables_wrapper .dataTables_info, .dataTables_wrapper .dataTables_paginate { color: #6c757d; margin-top: 1rem; }
    .dataTables_wrapper .dataTables_paginate .paginate_button { color: #495057 !important; background: #ffffff !important; border: 1px solid #dee2e6 !important; border-radius: 6px !important; margin: 0 2px; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: linear-gradient(135deg, #6c5ce7, #a855f7) !important; border-color: #6c5ce7 !important; color: #fff !important; }
    .dataTables_wrapper .dataTables_filter label, .dataTables_wrapper .dataTables_length label { color: #6c757d; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: #6c757d; }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
    /* Sales table scroll — let DataTables scrollX handle it natively */
    .dataTables_scroll { overflow: visible; }
    .dataTables_scrollHead { overflow: hidden !important; }
    .dataTables_scrollBody { overflow-x: auto !important; overflow-y: visible !important; }
    div.dataTables_wrapper div.dataTables_scroll { overflow-x: auto; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; } }
  </style>
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle d-lg-none" onclick="toggleSidebar()" style="color:#495057;font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/admin/dashboard'}, {name:'Ventes'}]}) %>
      </div>
      <div class="content-body">

        <div class="page-title-section">
          <h2><i class="fas fa-handshake me-2" style="color: #ef4444;"></i>Gestion des Ventes</h2>
        </div>

        <div class="action-bar mb-3">
          <button class="btn btn-sm" style="background:#f8f9fa;color:#495057;border:1px solid #ced4da;border-radius:10px;" onclick="printTable('salesTable','Liste des Ventes')"><i class="fas fa-print me-1"></i>Imprimer</button>
          <button class="btn btn-sm" style="background:#fff0f0;color:#dc3545;border:1px solid #f5c6cb;border-radius:10px;" onclick="exportTableToPDF('salesTable','ventes','Liste des Ventes')"><i class="fas fa-file-pdf me-1"></i>PDF</button>
          <button class="btn btn-sm" style="background:#f0fff4;color:#198754;border:1px solid #b7dfc9;border-radius:10px;" onclick="exportTableToExcel('salesTable','ventes')"><i class="fas fa-file-excel me-1"></i>Excel</button>
        </div>

        <div class="table-card">
          <% if (typeof sales !== 'undefined' && sales && sales.length > 0) { %>
          <div class="table-responsive">
            <table id="salesTable" class="datatable table table-striped table-hover" style="width:100%">
              <thead>
                <tr>
                  <th><input type="checkbox" id="selectAll" onchange="toggleSelectAll(this)"></th>
                  <th>ID</th>
                  <th>N° Vente</th>
                  <th>Client</th>
                  <th>Téléphone</th>
                  <th>Marque</th>
                  <th>Modèle</th>
                  <th>Année</th>
                  <th>Prix Véhicule</th>
                  <th>Vendeur</th>
                  <th>Agence</th>
                  <th>Paiement</th>
                  <th>Statut</th>
                  <th>Montant Total</th>
                  <th>Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% sales.forEach(function(sale, index) { %>
                <tr>
                  <td><input type="checkbox" class="row-checkbox" value="<%= sale.id_vente %>"></td>
                  <td><%= sale.id_vente %></td>
                  <td><strong>VTE-<%= String(sale.id_vente).padStart(4, '0') %></strong></td>
                  <td><strong><%= (sale.client_nom || '') + ' ' + (sale.client_prenom || '') %></strong></td>
                  <td><%= sale.client_telephone ? String(sale.client_telephone).trim() : '-' %></td>
                  <td><%= sale.marque || '-' %></td>
                  <td><%= sale.modele || '-' %></td>
                  <td><%= sale.annee || '-' %></td>
                  <td><%= sale.prix ? Number(sale.prix).toLocaleString('fr-FR') + ' MAD' : '-' %></td>
                  <td><%= (sale.vendeur_nom || '') + ' ' + (sale.vendeur_prenom || '') %></td>
                  <td><%= sale.nom_agence || sale.agence || '-' %></td>
                  <td>
                    <% var pType = sale.type_paiement || 'comptant'; %>
                    <span class="badge" style="background:#e0f7fa;color:#0077a8;border:1px solid #b2ebf2;">
                      <%= pType === 'comptant' || pType === 'cash' ? 'Comptant' : 'Crédit' %>
                    </span>
                  </td>
                  <td>
                    <% var saleStatus = sale.statut_vente || sale.statut || 'en_attente'; %>
                    <span class="badge bg-<%= saleStatus === 'validee' || saleStatus === 'approuve' || saleStatus === 'approuvé' ? 'success' : (saleStatus === 'annulee' || saleStatus === 'refuse' || saleStatus === 'refusé' ? 'danger' : 'warning') %>" style="<%= (saleStatus !== 'validee' && saleStatus !== 'approuve' && saleStatus !== 'approuvé' && saleStatus !== 'annulee' && saleStatus !== 'refuse' && saleStatus !== 'refusé') ? 'color:#1a1a2e!important;' : '' %>">
                      <%= saleStatus === 'validee' || saleStatus === 'approuve' || saleStatus === 'approuvé' ? 'Validée' : (saleStatus === 'annulee' || saleStatus === 'refuse' || saleStatus === 'refusé' ? 'Annulée' : 'En attente') %>
                    </span>
                  </td>
                  <td><strong class="montant-total"><%= sale.montant_total ? Number(sale.montant_total).toLocaleString('fr-FR') : '0' %> MAD</strong></td>
                  <td><%= sale.date_vente ? new Date(sale.date_vente).toLocaleDateString('fr-FR') : '-' %></td>
                  <td>
                    <% if (saleStatus === 'en_attente') { %>
                    <div class="d-flex gap-1 flex-wrap">
                      <form action="/admin/sales/approve/<%= sale.id_vente %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-success" style="border-radius:8px;font-size:0.75rem;font-weight:600;" title="Valider" onclick="return confirmAction(event, 'Valider cette vente ?')">
                          <i class="fas fa-check me-1"></i>Valider
                        </button>
                      </form>
                      <form action="/admin/sales/reject/<%= sale.id_vente %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger" style="border-radius:8px;font-size:0.75rem;font-weight:600;" title="Annuler" onclick="return confirmAction(event, 'Annuler cette vente ?')">
                          <i class="fas fa-times me-1"></i>Annuler
                        </button>
                      </form>
                    </div>
                    <% } else { %>
                    <button class="btn btn-sm btn-outline-secondary" style="border-radius:8px;font-size:0.75rem;font-weight:600;" type="button" onclick="modifierStatut('/admin/sales/approve/<%= sale.id_vente %>', '/admin/sales/reject/<%= sale.id_vente %>', 'Valider', 'Annuler')">
                      <i class="fas fa-edit me-1"></i>Modifier Statut
                    </button>
                    <% } %>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="empty-state">
            <i class="fas fa-handshake"></i>
            <h5>Aucune vente trouvée</h5>
            <p>Les ventes apparaîtront ici.</p>
          </div>
          <% } %>
        </div>

      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/print.js"></script>
  <script src="/js/export.js"></script>
  <script>
    $(document).ready(function() {
      if ($('#salesTable').length) {
        if ($.fn.DataTable.isDataTable('#salesTable')) { $('#salesTable').DataTable().destroy(); }
        $('#salesTable').DataTable({
          language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json' },
          scrollX: true,
          scrollCollapse: true,
          autoWidth: true,
          responsive: false,
          columnDefs: [{ orderable: false, targets: [0, 15] }],
          order: [[14, 'desc']]
        });
      }
    });
    function toggleSelectAll(el) { document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = el.checked); }
    function modifierStatut(approveUrl, rejectUrl, confirmLabel, denyLabel) {
      Swal.fire({
        title: 'Modifier le statut',
        icon: 'question',
        showDenyButton: true,
        showCancelButton: true,
        confirmButtonText: confirmLabel,
        denyButtonText: denyLabel,
        cancelButtonText: 'Annuler',
        confirmButtonColor: '#22c55e',
        denyButtonColor: '#ef4444',
        cancelButtonColor: '#6b7280'
      }).then(function(result) {
        if (result.isConfirmed) {
          var f = document.createElement('form'); f.method = 'POST'; f.action = approveUrl; document.body.appendChild(f); f.submit();
        } else if (result.isDenied) {
          var f = document.createElement('form'); f.method = 'POST'; f.action = rejectUrl; document.body.appendChild(f); f.submit();
        }
      });
    }
    function confirmAction(e, msg) {
      e.preventDefault();
      var form = e.target.closest('form');
      var isApprove = form.action.includes('approve');
      Swal.fire({
        title: msg, icon: 'question', showCancelButton: true,
        confirmButtonColor: isApprove ? '#22c55e' : '#ef4444',
        cancelButtonColor: '#6b7280',
        confirmButtonText: isApprove ? 'Oui, valider' : 'Oui, annuler',
        cancelButtonText: 'Retour'
      }).then(function(r) { if (r.isConfirmed) form.submit(); });
      return false;
    }
  </script>
</body>
</html>
