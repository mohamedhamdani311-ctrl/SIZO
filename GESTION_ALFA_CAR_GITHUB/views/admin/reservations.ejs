<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Gestion des Réservations', extraCss: ['/css/dashboard.css', 'https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; max-width: calc(100vw - 175px); box-sizing: border-box; overflow-x: hidden; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .page-title-section { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
    .page-title-section h2 { font-family: 'Poppins', sans-serif; font-weight: 700; color: #212529; margin: 0; font-size: 1.5rem; }
    .table-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; opacity: 1 !important; }
    .table-card .table { color: #212529; font-size: 0.85rem; }
    .table-card .table thead th { background: #f0f0f5; color: #212529; border-color: #dee2e6; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
    .table-card .table td { border-color: #dee2e6; vertical-align: middle; color: #212529 !important; }
    .table-card .table tbody tr:hover { background: rgba(108,92,231,0.07); }
    .dataTables_wrapper .dataTables_filter input, .dataTables_wrapper .dataTables_length select { background: #ffffff; border: 1px solid #ced4da; color: #212529; border-radius: 8px; }
    .dataTables_wrapper .dataTables_info, .dataTables_wrapper .dataTables_paginate { color: #6c757d; margin-top: 1rem; }
    .dataTables_wrapper .dataTables_paginate .paginate_button { color: #495057 !important; background: #ffffff !important; border: 1px solid #dee2e6 !important; border-radius: 6px !important; margin: 0 2px; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: linear-gradient(135deg, #6c5ce7, #a855f7) !important; border-color: #6c5ce7 !important; color: #fff !important; }
    .dataTables_wrapper .dataTables_filter label, .dataTables_wrapper .dataTables_length label { color: #6c757d; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: #6c757d; }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; } }
  </style>
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle d-lg-none" onclick="toggleSidebar()" style="color:#495057;font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/admin/dashboard'}, {name:'Réservations'}]}) %>
      </div>
      <div class="content-body">

        <div class="page-title-section">
          <h2><i class="fas fa-calendar-check me-2" style="color: #f59e0b;"></i>Gestion des Réservations</h2>
          <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary" style="border-radius:10px;" onclick="printTable('reservationsTable','Réservations')"><i class="fas fa-print me-1"></i>Imprimer</button>
            <button class="btn btn-outline-danger"    style="border-radius:10px;" onclick="exportTableToPDF('reservationsTable','reservations','Réservations')"><i class="fas fa-file-pdf me-1"></i>PDF</button>
            <button class="btn btn-outline-success"   style="border-radius:10px;" onclick="exportTableToExcel('reservationsTable','reservations')"><i class="fas fa-file-excel me-1"></i>Excel</button>
          </div>
        </div>

        <div class="table-card">
          <% if (typeof reservations !== 'undefined' && reservations && reservations.length > 0) { %>
          <div class="table-responsive">
            <table id="reservationsTable" class="datatable table table-striped table-hover" style="width:100%">
              <thead>
                <tr>
                  <th><input type="checkbox" id="selectAll" onchange="toggleSelectAll(this)"></th>
                  <th>#</th>
                  <th>Client</th>
                  <th>Voiture</th>
                  <th>Vendeur</th>
                  <th>Date Réservation</th>
                  <th>Date Expiration</th>
                  <th>Statut</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% reservations.forEach(function(res, index) { %>
                <tr>
                  <td><input type="checkbox" class="row-checkbox" value="<%= res.id_reservation %>"></td>
                  <td><%= index + 1 %></td>
                  <td><strong><%= (res.client_nom || '') + ' ' + (res.client_prenom || '') %></strong></td>
                  <td><%= (res.marque || '') + ' ' + (res.modele || '') %></td>
                  <td><%= (res.vendeur_nom || res.seller_nom || '-') %></td>
                  <td><%= res.date_reservation ? new Date(res.date_reservation).toLocaleDateString('fr-FR') : '-' %></td>
                  <td><%= res.date_expiration ? new Date(res.date_expiration).toLocaleDateString('fr-FR') : '-' %></td>
                  <td>
                    <% var resStatus = res.statut || 'en_attente'; %>
                    <span class="badge bg-<%= resStatus === 'confirmee' ? 'success' : (resStatus === 'annulee' ? 'danger' : 'warning') %>">
                      <%= resStatus === 'confirmee' ? 'Confirmée' : (resStatus === 'annulee' ? 'Annulée' : 'En attente') %>
                    </span>
                  </td>
                  <td>
                    <% if (resStatus === 'en_attente') { %>
                    <div class="d-flex gap-1 flex-wrap">
                      <form action="/admin/reservations/approve/<%= res.id_reservation %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-success" style="border-radius:8px;font-size:0.75rem;font-weight:600;" title="Valider" onclick="return confirmAction(event, 'Valider cette réservation ?')">
                          <i class="fas fa-check me-1"></i>Valider
                        </button>
                      </form>
                      <form action="/admin/reservations/reject/<%= res.id_reservation %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger" style="border-radius:8px;font-size:0.75rem;font-weight:600;" title="Refuser" onclick="return confirmAction(event, 'Refuser cette réservation ?')">
                          <i class="fas fa-times me-1"></i>Refuser
                        </button>
                      </form>
                    </div>
                    <% } else { %>
                    <button class="btn btn-sm btn-outline-secondary" style="border-radius:8px;font-size:0.75rem;font-weight:600;" type="button" onclick="modifierStatut('/admin/reservations/approve/<%= res.id_reservation %>', '/admin/reservations/reject/<%= res.id_reservation %>', 'Valider', 'Refuser')">
                      <i class="fas fa-edit me-1"></i>Modifier Statut
                    </button>
                    <% } %>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="empty-state">
            <i class="fas fa-calendar-check"></i>
            <h5>Aucune réservation trouvée</h5>
            <p>Les réservations des clients apparaîtront ici.</p>
          </div>
          <% } %>
        </div>

      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/print.js"></script>
  <script src="/js/export.js"></script>
  <script>
    $(document).ready(function() {
      if ($('#reservationsTable').length) {
        if ($.fn.DataTable.isDataTable('#reservationsTable')) { $('#reservationsTable').DataTable().destroy(); }
        $('#reservationsTable').DataTable({ language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json' }, responsive: true, columnDefs: [{ orderable: false, targets: [0, 8] }], order: [[5, 'desc']] });
      }
    });
    function toggleSelectAll(el) { document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = el.checked); }
    function modifierStatut(approveUrl, rejectUrl, confirmLabel, denyLabel) {
      Swal.fire({
        title: 'Modifier le statut',
        icon: 'question',
        showDenyButton: true,
        showCancelButton: true,
        confirmButtonText: confirmLabel,
        denyButtonText: denyLabel,
        cancelButtonText: 'Annuler',
        confirmButtonColor: '#22c55e',
        denyButtonColor: '#ef4444',
        cancelButtonColor: '#6b7280'
      }).then(function(result) {
        if (result.isConfirmed) {
          var f = document.createElement('form'); f.method = 'POST'; f.action = approveUrl; document.body.appendChild(f); f.submit();
        } else if (result.isDenied) {
          var f = document.createElement('form'); f.method = 'POST'; f.action = rejectUrl; document.body.appendChild(f); f.submit();
        }
      });
    }
    function confirmAction(e, msg) {
      e.preventDefault();
      var form = e.target.closest('form');
      var isApprove = form.action.includes('approve');
      Swal.fire({
        title: msg,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: isApprove ? '#22c55e' : '#ef4444',
        cancelButtonColor: '#6b7280',
        confirmButtonText: isApprove ? 'Oui, valider' : 'Oui, annuler',
        cancelButtonText: 'Retour'
      }).then(function(result) { if (result.isConfirmed) form.submit(); });
      return false;
    }
  </script>
</body>
</html>
