<%- include('../partials/head', {title: 'Facture ' + (typeof invoice !== 'undefined' && invoice ? invoice.numero_facture : ''), extraCss: ['/css/dashboard.css', '/css/print.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .invoice-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; }
    .invoice-card .card-body { padding: 2.5rem; }
    .invoice-title { color: #6c5ce7; font-weight: 800; }
    .info-box { background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 12px; padding: 1.25rem; }
    .info-box h5 { color: #212529; font-weight: 700; margin-bottom: 1rem; }
    .info-box p { color: #495057; margin-bottom: 0.4rem; }
    .total-box { background: linear-gradient(135deg,#6c5ce7,#a855f7); color: #fff; border-radius: 12px; padding: 1.25rem; text-align: right; }
    .total-box h4 { color: #fff; margin: 0; font-weight: 800; }
    .credit-info { background: #fff8e1; border: 1px solid #ffe082; border-radius: 12px; padding: 1rem; }
    .credit-info h6 { color: #212529; font-weight: 700; }
    @media print {
      .no-print { display: none !important; }
      .main-content { margin-left: 0 !important; padding: 0 !important; }
      .sidebar { display: none !important; }
      .invoice-card { border: none !important; border-radius: 0 !important; }
      @page { margin: 10mm; size: A4; }
    }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; } }
  </style>
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header no-print">
        <button class="btn btn-link sidebar-toggle" id="sidebarToggle" style="color:#495057;font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/admin/dashboard'}, {name:'Factures', url:'/admin/invoices'}, {name: typeof invoice !== 'undefined' && invoice ? invoice.numero_facture : 'Facture'}]}) %>
      </div>
      <div class="content-body">
        <div class="d-flex justify-content-end gap-2 mb-3 no-print">
          <a href="/admin/invoices" class="btn btn-outline-secondary" style="border-radius:10px;">
            <i class="fas fa-arrow-left me-2"></i>Retour
          </a>
          <button class="btn btn-outline-primary" style="border-radius:10px;" onclick="window.print()">
            <i class="fas fa-print me-1"></i>Imprimer
          </button>
          <button class="btn btn-outline-danger" style="border-radius:10px;" onclick="exportInvoiceToPDF(invoiceData)">
            <i class="fas fa-file-pdf me-1"></i>Exporter PDF
          </button>
        </div>

        <% if (typeof invoice !== 'undefined' && invoice) { %>
        <div class="invoice-card" id="invoiceContent">
          <div class="card-body">
            <div class="row mb-4">
              <div class="col-6">
                <h2 class="invoice-title"><i class="fas fa-car me-2"></i>ALFA CAR</h2>
                <p class="text-muted mb-0">Système de Gestion de Vente de Voitures</p>
                <p class="text-muted mb-0"><%= invoice.agence_nom || 'ALFA CAR' %></p>
                <p class="text-muted mb-0"><%= invoice.agence_adresse || '' %></p>
                <p class="text-muted mb-0"><%= invoice.agence_telephone || '' %><%= invoice.agence_email ? ' | ' + invoice.agence_email : '' %></p>
              </div>
              <div class="col-6 text-end">
                <h3 class="fw-bold text-uppercase" style="color:#212529;">FACTURE</h3>
                <p class="mb-1"><strong>N°:</strong> <span style="color:#6c5ce7;font-weight:700;"><%= invoice.numero_facture %></span></p>
                <p class="mb-1"><strong>Date:</strong> <%= invoice.date_facture ? new Date(invoice.date_facture).toLocaleDateString('fr-FR', {year:'numeric',month:'long',day:'numeric'}) : 'N/A' %></p>
              </div>
            </div>
            <hr style="border-color:#dee2e6;">
            <div class="row mb-4 g-3">
              <div class="col-md-6">
                <div class="info-box">
                  <h5><i class="fas fa-user me-2" style="color:#6c5ce7;"></i>Client</h5>
                  <p><strong>Nom:</strong> <%= invoice.client_nom || '' %> <%= invoice.client_prenom || '' %></p>
                  <p><strong>Email:</strong> <%= invoice.client_email || 'N/A' %></p>
                  <p><strong>Tél:</strong> <%= invoice.client_telephone || 'N/A' %></p>
                  <p><strong>Adresse:</strong> <%= invoice.client_adresse || 'N/A' %></p>
                </div>
              </div>
              <div class="col-md-6">
                <div class="info-box">
                  <h5><i class="fas fa-car me-2" style="color:#6c5ce7;"></i>Véhicule</h5>
                  <p><strong>Marque:</strong> <%= invoice.marque || '' %></p>
                  <p><strong>Modèle:</strong> <%= invoice.modele || '' %></p>
                  <p><strong>Année:</strong> <%= invoice.annee || '' %></p>
                  <p><strong>Couleur:</strong> <%= invoice.couleur || 'N/A' %></p>
                </div>
              </div>
            </div>
            <div class="table-responsive mb-4">
              <table class="table table-bordered" style="color:#212529;">
                <thead style="background:#6c5ce7;color:#fff;">
                  <tr><th>Description</th><th>Type de Paiement</th><th class="text-end">Montant</th></tr>
                </thead>
                <tbody>
                  <tr>
                    <td><%= invoice.marque || '' %> <%= invoice.modele || '' %> (<%= invoice.annee || '' %>)</td>
                    <td>
                      <% if (invoice.type_paiement === 'cash') { %>
                        <span class="badge bg-info">Cash</span>
                      <% } else { %>
                        <span class="badge bg-warning text-dark">Crédit</span>
                      <% } %>
                    </td>
                    <td class="text-end fw-bold"><%= invoice.montant_total ? parseFloat(invoice.montant_total).toLocaleString('fr-FR') : '0' %> MAD</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <% if (invoice.type_paiement === 'credit') { %>
            <div class="credit-info mb-4">
              <h6><i class="fas fa-info-circle me-2"></i>Détails du Crédit</h6>
              <div class="row">
                <div class="col-md-3"><strong>Avance:</strong> <%= invoice.montant_avance ? parseFloat(invoice.montant_avance).toLocaleString('fr-FR') : '0' %> MAD</div>
                <div class="col-md-3"><strong>Mensualités:</strong> <%= invoice.nombre_mensualites || 0 %> mois</div>
                <div class="col-md-3"><strong>Mensualité:</strong> <%= invoice.mensualite ? parseFloat(invoice.mensualite).toLocaleString('fr-FR') : '0' %> MAD</div>
                <div class="col-md-3"><strong>Taux:</strong> <%= invoice.taux_interet || 0 %>%</div>
              </div>
            </div>
            <% } %>
            <div class="row">
              <div class="col-md-6 offset-md-6">
                <div class="total-box">
                  <h4>TOTAL: <%= invoice.montant_total ? parseFloat(invoice.montant_total).toLocaleString('fr-FR') : '0' %> MAD</h4>
                </div>
              </div>
            </div>
            <div class="text-center mt-5 text-muted">
              <hr style="border-color:#dee2e6;">
              <small>Merci pour votre confiance — ALFA CAR, votre partenaire automobile</small>
            </div>
          </div>
        </div>
        <% } else { %>
        <div class="text-center py-5">
          <i class="fas fa-file-invoice fa-4x text-muted mb-3"></i>
          <h4 class="text-muted">Facture non trouvée</h4>
        </div>
        <% } %>
      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/export.js"></script>
  <% if (typeof invoice !== 'undefined' && invoice) { %>
  <script>
    const invoiceData = {
      numero_facture: '<%= invoice.numero_facture %>',
      date_facture: '<%= invoice.date_facture ? new Date(invoice.date_facture).toLocaleDateString("fr-FR") : "" %>',
      client_nom: '<%= invoice.client_nom || "" %>',
      client_prenom: '<%= invoice.client_prenom || "" %>',
      client_email: '<%= invoice.client_email || "" %>',
      client_telephone: '<%= invoice.client_telephone || "" %>',
      client_adresse: '<%= invoice.client_adresse || "" %>',
      agence_nom: '<%= invoice.agence_nom || "" %>',
      agence_adresse: '<%= invoice.agence_adresse || "" %>',
      agence_telephone: '<%= invoice.agence_telephone || "" %>',
      agence_email: '<%= invoice.agence_email || "" %>',
      marque: '<%= invoice.marque || "" %>',
      modele: '<%= invoice.modele || "" %>',
      annee: '<%= invoice.annee || "" %>',
      couleur: '<%= invoice.couleur || "" %>',
      montant_total: '<%= invoice.montant_total || 0 %>',
      type_paiement: '<%= invoice.type_paiement || "cash" %>',
      montant_avance: '<%= invoice.montant_avance || 0 %>',
      nombre_mensualites: '<%= invoice.nombre_mensualites || 0 %>',
      mensualite: '<%= invoice.mensualite || 0 %>',
      taux_interet: '<%= invoice.taux_interet || 0 %>'
    };
  </script>
  <% } %>
  <script>
    // Auto-print if ?print=1 in query string
    if (new URLSearchParams(window.location.search).get('print') === '1') {
      window.addEventListener('load', function() { setTimeout(function() { window.print(); }, 600); });
    }
  </script>
</body></html>