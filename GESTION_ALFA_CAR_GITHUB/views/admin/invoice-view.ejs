<%- include('../partials/head', {title: 'Facture ' + (typeof invoice !== 'undefined' && invoice ? invoice.numero_facture : ''), extraCss: '<link rel="stylesheet" href="/css/dashboard.css"><link rel="stylesheet" href="/css/print.css">'}) %>
<body data-theme="dark">
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; } }
    .invoice-print-area { background: #fff; color: #1a1a2e; border-radius: 16px; padding: 2.5rem; max-width: 860px; margin: 0 auto; }
    .invoice-print-area * { color: inherit; }
    @media print {
      body { background: #fff !important; }
      .sidebar, .content-header, nav, .action-buttons-top, button, a.btn { display: none !important; }
      .main-content { margin-left: 0 !important; padding: 0 !important; }
      .invoice-print-area { box-shadow: none !important; border: none !important; padding: 10mm !important; max-width: 100% !important; }
      @page { margin: 10mm; size: A4; }
    }
  </style>

<div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
        <div class="content-header no-print">
            <button class="btn btn-link sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
            <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/admin'}, {name:'Factures', url:'/admin/invoices'}, {name: typeof invoice !== 'undefined' && invoice ? invoice.numero_facture : 'Facture'}]}) %>
        </div>
        <div class="content-body">
        <div class="d-flex justify-content-end gap-2 mb-3" style="flex-wrap:wrap;">
          <a href="javascript:history.back()" class="btn" style="background:rgba(255,255,255,0.08);color:#e2e8f0;border:1px solid rgba(255,255,255,0.15);border-radius:10px;padding:0.5rem 1.2rem;font-weight:500;">
            <i class="fas fa-arrow-left me-2"></i>Retour
          </a>
          <button onclick="printInvoiceNow()" class="btn" style="background:rgba(255,255,255,0.1);color:#e2e8f0;border:1px solid rgba(255,255,255,0.25);border-radius:10px;padding:0.5rem 1.4rem;font-weight:600;">
            <i class="fas fa-print me-2"></i>Imprimer
          </button>
          <button onclick="exportInvoicePDF()" class="btn" style="background:rgba(239,68,68,0.2);color:#f87171;border:1px solid rgba(239,68,68,0.35);border-radius:10px;padding:0.5rem 1.4rem;font-weight:600;">
            <i class="fas fa-file-pdf me-2"></i>Export PDF
          </button>
        </div>

            <div class="d-flex justify-content-end mb-3 no-print">
                <button class="btn btn-primary me-2" onclick="window.print()"><i class="fas fa-print me-1"></i>Imprimer</button>
                <button class="btn btn-danger" onclick="exportInvoiceToPDF(invoiceData)"><i class="fas fa-file-pdf me-1"></i>Exporter PDF</button>
            </div>
            <% if (typeof invoice !== 'undefined' && invoice) { %>
            <div class="card shadow-sm printable-invoice" id="invoiceContent">
                <div class="card-body p-5">
                    <!-- Header -->
                    <div class="row mb-4">
                        <div class="col-6">
                            <h2 class="fw-bold" style="color:var(--accent)"><i class="fas fa-car me-2"></i>ALFA CAR</h2>
                            <p class="text-muted mb-0">Système de Gestion de Vente de Voitures</p>
                            <p class="text-muted mb-0"><%= invoice.agence_nom || 'ALFA CAR' %></p>
                            <p class="text-muted mb-0"><%= invoice.agence_adresse || '' %></p>
                            <p class="text-muted mb-0"><%= invoice.agence_telephone || '' %> | <%= invoice.agence_email || '' %></p>
                        </div>
                        <div class="col-6 text-end">
                            <h3 class="fw-bold text-uppercase">FACTURE</h3>
                            <p class="mb-1"><strong>N°:</strong> <span class="text-primary fw-bold"><%= invoice.numero_facture %></span></p>
                            <p class="mb-1"><strong>Date:</strong> <%= invoice.date_facture ? new Date(invoice.date_facture).toLocaleDateString('fr-FR', {year:'numeric',month:'long',day:'numeric'}) : 'N/A' %></p>
                        </div>
                    </div>
                    <hr>
                    <!-- Client + Vehicle Info -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="p-3 rounded" style="background:var(--bg)">
                                <h5 class="fw-bold mb-3"><i class="fas fa-user me-2"></i>Client</h5>
                                <p class="mb-1"><strong>Nom:</strong> <%= invoice.client_nom || '' %> <%= invoice.client_prenom || '' %></p>
                                <p class="mb-1"><strong>Email:</strong> <%= invoice.client_email || 'N/A' %></p>
                                <p class="mb-1"><strong>Téléphone:</strong> <%= invoice.client_telephone || 'N/A' %></p>
                                <p class="mb-0"><strong>Adresse:</strong> <%= invoice.client_adresse || 'N/A' %></p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded" style="background:var(--bg)">
                                <h5 class="fw-bold mb-3"><i class="fas fa-car me-2"></i>Véhicule</h5>
                                <p class="mb-1"><strong>Marque:</strong> <%= invoice.marque || '' %></p>
                                <p class="mb-1"><strong>Modèle:</strong> <%= invoice.modele || '' %></p>
                                <p class="mb-1"><strong>Année:</strong> <%= invoice.annee || '' %></p>
                                <p class="mb-0"><strong>Couleur:</strong> <%= invoice.couleur || 'N/A' %></p>
                            </div>
                        </div>
                    </div>
                    <!-- Payment Details -->
                    <div class="table-responsive mb-4">
                        <table class="table table-bordered">
                            <thead style="background:var(--primary);color:white;">
                                <tr>
                                    <th>Description</th>
                                    <th>Type de Paiement</th>
                                    <th class="text-end">Montant</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><%= invoice.marque || '' %> <%= invoice.modele || '' %> (<%= invoice.annee || '' %>)</td>
                                    <td>
                                        <% if (invoice.type_paiement === 'cash') { %>
                                            <span class="badge bg-info">Cash</span>
                                        <% } else { %>
                                            <span class="badge bg-warning text-dark">Crédit</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end fw-bold"><%= invoice.montant_total ? parseFloat(invoice.montant_total).toLocaleString('fr-FR') : '0' %> MAD</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- Credit Details if applicable -->
                    <% if (invoice.type_paiement === 'credit') { %>
                    <div class="p-3 rounded mb-4" style="background:#fff3cd;">
                        <h6 class="fw-bold"><i class="fas fa-info-circle me-2"></i>Détails du Crédit</h6>
                        <div class="row">
                            <div class="col-md-3"><strong>Avance:</strong> <%= invoice.montant_avance ? parseFloat(invoice.montant_avance).toLocaleString('fr-FR') : '0' %> MAD</div>
                            <div class="col-md-3"><strong>Mensualités:</strong> <%= invoice.nombre_mensualites || 0 %> mois</div>
                            <div class="col-md-3"><strong>Mensualité:</strong> <%= invoice.mensualite ? parseFloat(invoice.mensualite).toLocaleString('fr-FR') : '0' %> MAD</div>
                            <div class="col-md-3"><strong>Taux:</strong> <%= invoice.taux_interet || 0 %>%</div>
                        </div>
                    </div>
                    <% } %>
                    <!-- Total -->
                    <div class="row">
                        <div class="col-md-6 offset-md-6">
                            <div class="p-3 rounded text-end" style="background:var(--primary);color:white;">
                                <h4 class="mb-0">TOTAL: <strong><%= invoice.montant_total ? parseFloat(invoice.montant_total).toLocaleString('fr-FR') : '0' %> MAD</strong></h4>
                            </div>
                        </div>
                    </div>
                    <!-- Footer -->
                    <div class="text-center mt-5 text-muted">
                        <hr>
                        <p class="mb-0"><small>Merci pour votre confiance — ALFA CAR, votre partenaire automobile</small></p>
                    </div>
                </div>
            </div>
            <% } else { %>
            <div class="text-center py-5">
                <i class="fas fa-file-invoice fa-4x text-muted mb-3"></i>
                <h4 class="text-muted">Facture non trouvée</h4>
            </div>
            <% } %>
        </div>
    </main>
</div>
<%- include('../partials/flash') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/main.js"></script>
<script src="/js/export.js"></script>
<% if (typeof invoice !== 'undefined' && invoice) { %>
<script>
const invoiceData = {
    numero_facture: '<%= invoice.numero_facture %>',
    date_facture: '<%= invoice.date_facture ? new Date(invoice.date_facture).toLocaleDateString("fr-FR") : "" %>',
    client_nom: '<%= invoice.client_nom || "" %>',
    client_prenom: '<%= invoice.client_prenom || "" %>',
    client_email: '<%= invoice.client_email || "" %>',
    client_telephone: '<%= invoice.client_telephone || "" %>',
    client_adresse: '<%= invoice.client_adresse || "" %>',
    marque: '<%= invoice.marque || "" %>',
    modele: '<%= invoice.modele || "" %>',
    annee: '<%= invoice.annee || "" %>',
    couleur: '<%= invoice.couleur || "" %>',
    montant_total: '<%= invoice.montant_total || 0 %>',
    type_paiement: '<%= invoice.type_paiement || "cash" %>',
    montant_avance: '<%= invoice.montant_avance || 0 %>',
    nombre_mensualites: '<%= invoice.nombre_mensualites || 0 %>',
    mensualite: '<%= invoice.mensualite || 0 %>',
    taux_interet: '<%= invoice.taux_interet || 0 %>'
};
</script>
<% } %>

<script>
function printInvoiceNow() {
  window.print();
}
function exportInvoicePDF() {
  window.print();
}
// Auto-print if ?print=1 in query string
if (new URLSearchParams(window.location.search).get('print') === '1') {
  window.addEventListener('load', function() { setTimeout(function() { window.print(); }, 600); });
}
</script>
</body></html>
