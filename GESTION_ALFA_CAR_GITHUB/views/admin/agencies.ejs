<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Gestion des Agences', extraCss: ['/css/dashboard.css', 'https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #0f0f23; color: #e2e8f0; margin: 0; }
    .main-content { margin-left: 280px; min-height: 100vh; padding: 2rem; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .page-title-section { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
    .page-title-section h2 { font-family: 'Poppins', sans-serif; font-weight: 700; color: #fff; margin: 0; font-size: 1.5rem; }
    .table-card { background: #1a1a2e; border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 1.5rem; opacity: 1 !important; }.table-card .table { color: #e2e8f0 !important; font-size: 0.85rem; }
    .table-card .table thead th { background: rgba(108,92,231,0.1); color: rgba(255,255,255,0.7); border-color: rgba(255,255,255,0.06); font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
    .table-card .table td { border-color: rgba(255,255,255,0.04); vertical-align: middle; color: #e2e8f0 !important; }
    .table-card .table tbody tr:hover { background: rgba(108,92,231,0.05); }
    .dataTables_wrapper .dataTables_filter input, .dataTables_wrapper .dataTables_length select { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #e2e8f0; border-radius: 8px; }
    .dataTables_wrapper .dataTables_info, .dataTables_wrapper .dataTables_paginate { color: rgba(255,255,255,0.5); margin-top: 1rem; }
    .dataTables_wrapper .dataTables_paginate .paginate_button { color: rgba(255,255,255,0.6) !important; background: transparent !important; border: 1px solid rgba(255,255,255,0.1) !important; border-radius: 6px !important; margin: 0 2px; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: linear-gradient(135deg, #6c5ce7, #a855f7) !important; border-color: #6c5ce7 !important; color: #fff !important; }
    .dataTables_wrapper .dataTables_filter label, .dataTables_wrapper .dataTables_length label { color: rgba(255,255,255,0.6); }
    .empty-state { text-align: center; padding: 3rem 1rem; color: rgba(255,255,255,0.4); }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; } }
  </style>
</head>
<body data-theme="dark">
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle d-lg-none" onclick="toggleSidebar()" style="color:rgba(255,255,255,0.6);font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/admin/dashboard'}, {name:'Agences'}]}) %>
      </div>
      <div class="content-body">

        <div class="page-title-section">
          <h2><i class="fas fa-building me-2" style="color: #06b6d4;"></i>Gestion des Agences</h2>
          <a href="/admin/agencies/add" class="btn btn-primary" style="background: linear-gradient(135deg, #6c5ce7, #a855f7); border: none; border-radius: 10px; padding: 0.6rem 1.5rem; font-weight: 600;">
            <i class="fas fa-plus me-2"></i>Ajouter Agence
          </a>
        </div>

        <div class="action-bar mb-3" style="display:flex;gap:0.5rem;flex-wrap:wrap;">
          <button class="btn btn-sm" style="background:rgba(255,255,255,0.1);color:#e2e8f0;border:1px solid rgba(255,255,255,0.2);border-radius:10px;" onclick="printTable('agenciesTable','Liste des Agences')"><i class="fas fa-print me-1"></i>Imprimer</button>
          <button class="btn btn-sm" style="background:rgba(239,68,68,0.15);color:#f87171;border:1px solid rgba(239,68,68,0.3);border-radius:10px;" onclick="exportTableToPDF('agenciesTable','agences','Liste des Agences')"><i class="fas fa-file-pdf me-1"></i>PDF</button>
          <button class="btn btn-sm" style="background:rgba(34,197,94,0.15);color:#4ade80;border:1px solid rgba(34,197,94,0.3);border-radius:10px;" onclick="exportTableToExcel('agenciesTable','agences')"><i class="fas fa-file-excel me-1"></i>Excel</button>
        </div>
        <div class="table-card">
          <% if (typeof agencies !== 'undefined' && agencies && agencies.length > 0) { %>
          <div class="table-responsive">
            <table id="agenciesTable" class="datatable table table-striped table-hover" style="width:100%">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Nom Agence</th>
                  <th>Adresse</th>
                  <th>Téléphone</th>
                  <th>Email</th>
                  <th>Date Création</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% agencies.forEach(function(agency, index) { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td><strong><%= agency.nom_agence || agency.nom || '' %></strong></td>
                  <td><%= agency.adresse || '-' %></td>
                  <td><%= agency.telephone || '-' %></td>
                  <td><%= agency.email || '-' %></td>
                  <td><%= agency.date_creation ? new Date(agency.date_creation).toLocaleDateString('fr-FR') : '-' %></td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/admin/agencies/edit/<%= agency.id_agence %>" class="btn btn-sm btn-outline-primary" style="border-radius: 8px; font-size: 0.75rem;" title="Modifier">
                        <i class="fas fa-edit"></i>
                      </a>
                      <form action="/admin/agencies/delete/<%= agency.id_agence %>" method="POST" class="d-inline" onsubmit="return confirmDelete(event, 'cette agence')">
                        <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 8px; font-size: 0.75rem;" title="Supprimer">
                          <i class="fas fa-trash"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="empty-state">
            <i class="fas fa-building"></i>
            <h5>Aucune agence trouvée</h5>
            <p>Ajoutez votre première agence pour commencer.</p>
            <a href="/admin/agencies/add" class="btn btn-primary mt-2" style="background: linear-gradient(135deg, #6c5ce7, #a855f7); border: none; border-radius: 10px;">
              <i class="fas fa-plus me-2"></i>Ajouter une Agence
            </a>
          </div>
          <% } %>
        </div>

      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/print.js"></script>
  <script src="/js/export.js"></script>
  <script src="/js/dashboard.js"></script>
  <script>
    $(document).ready(function() {
      if ($('#agenciesTable').length) {
        
        if ($.fn.DataTable.isDataTable('#agenciesTable')) { $('#agenciesTable').DataTable().destroy(); }
        $('#agenciesTable').DataTable({ language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json' }, responsive: true, columnDefs: [{ orderable: false, targets: [6] }], order: [[0, 'asc']] });
      }
    });
    function confirmDelete(e, name) {
      e.preventDefault();
      Swal.fire({ title: 'Êtes-vous sûr ?', text: 'Voulez-vous vraiment supprimer ' + name + ' ?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#ef4444', cancelButtonColor: '#6b7280', confirmButtonText: 'Oui, supprimer', cancelButtonText: 'Annuler', background: '#1a1a2e', color: '#fff' }).then(function(result) { if (result.isConfirmed) e.target.submit(); });
      return false;
    }
  </script>
</body>
</html>
