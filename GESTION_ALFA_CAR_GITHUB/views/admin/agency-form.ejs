<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: (typeof agency !== 'undefined' && agency) ? 'Modifier Agence' : 'Ajouter Agence', extraCss: ['/css/dashboard.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #0f0f23; color: #e2e8f0; margin: 0; }
    .main-content { margin-left: 220px; min-height: 100vh; padding: 2rem; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .form-card { background: rgba(255,255,255,0.03); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 2rem; }
    .form-card .form-label { color: rgba(255,255,255,0.8) !important; font-weight: 500; font-size: 0.85rem; margin-bottom: 0.4rem; }
    .form-card .form-control, .form-card .form-select {
      background: rgba(30,30,70,0.9) !important;
      border: 1px solid rgba(255,255,255,0.15) !important;
      color: #e2e8f0 !important;
      border-radius: 10px;
      padding: 0.6rem 1rem;
    }
    .form-card .form-control:focus, .form-card .form-select:focus {
      border-color: #6c5ce7 !important;
      box-shadow: 0 0 0 3px rgba(108,92,231,0.2) !important;
      background: rgba(40,40,90,0.95) !important;
      color: #fff !important;
    }
    .form-card .form-control::placeholder { color: rgba(255,255,255,0.35) !important; }
    .form-card .form-select option { background: #1a1a2e !important; color: #e2e8f0 !important; }
    input:-webkit-autofill, input:-webkit-autofill:hover, input:-webkit-autofill:focus {
      -webkit-text-fill-color: #e2e8f0 !important;
      -webkit-box-shadow: 0 0 0 1000px #1a1a2e inset !important;
    }
    .btn-outline-light { color: #e2e8f0 !important; border-color: rgba(255,255,255,0.3) !important; }
    .btn-outline-light:hover { background: rgba(255,255,255,0.1) !important; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; } }
  </style>
</head>
<body data-theme="dark">
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle d-lg-none" onclick="toggleSidebar()" style="color:rgba(255,255,255,0.6);font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/admin/dashboard'}, {name:'Agences', url:'/admin/agencies'}, {name: (typeof agency !== 'undefined' && agency) ? 'Modifier' : 'Ajouter'}]}) %>
      </div>
      <div class="content-body">

        <h2 style="font-family: 'Poppins', sans-serif; font-weight: 700; color: #fff; font-size: 1.5rem; margin-bottom: 1.5rem;">
          <i class="fas fa-<%= (typeof agency !== 'undefined' && agency) ? 'edit' : 'plus-circle' %> me-2" style="color: #06b6d4;"></i>
          <%= (typeof agency !== 'undefined' && agency) ? 'Modifier Agence' : 'Ajouter Agence' %>
        </h2>

        <div class="form-card">
          <form action="<%= (typeof agency !== 'undefined' && agency) ? '/admin/agencies/edit/' + agency.id_agence : '/admin/agencies/add' %>" method="POST">
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label">Nom de l'agence <span class="text-danger">*</span></label>
                <input type="text" class="form-control" name="nom_agence" value="<%= (typeof agency !== 'undefined' && agency) ? agency.nom_agence || agency.nom || '' : '' %>" required placeholder="Nom de l'agence">
              </div>
              <div class="col-md-6">
                <label class="form-label">Adresse</label>
                <input type="text" class="form-control" name="adresse" value="<%= (typeof agency !== 'undefined' && agency) ? agency.adresse || '' : '' %>" placeholder="Adresse complète">
              </div>
            </div>
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label">Téléphone</label>
                <input type="tel" class="form-control" name="telephone" value="<%= (typeof agency !== 'undefined' && agency) ? agency.telephone || '' : '' %>" placeholder="05XXXXXXXX">
              </div>
              <div class="col-md-6">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" name="email" value="<%= (typeof agency !== 'undefined' && agency) ? agency.email || '' : '' %>" placeholder="agence@exemple.com">
              </div>
            </div>
            <div class="d-flex gap-2 pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
              <button type="submit" class="btn btn-primary px-4" style="background: linear-gradient(135deg, #6c5ce7, #a855f7); border: none; border-radius: 10px; font-weight: 600;">
                <i class="fas fa-save me-2"></i><%= (typeof agency !== 'undefined' && agency) ? 'Mettre à jour' : 'Enregistrer' %>
              </button>
              <a href="/admin/agencies" class="btn btn-outline-light px-4" style="border-radius: 10px;">
                <i class="fas fa-arrow-left me-2"></i>Annuler
              </a>
            </div>
          </form>
        </div>

      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
