<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Gestion des Clients', extraCss: ['/css/dashboard.css', 'https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .page-title-section { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
    .page-title-section h2 { font-family: 'Poppins', sans-serif; font-weight: 700; color: #212529; margin: 0; font-size: 1.5rem; }
    .action-bar { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
    .action-bar .btn { border-radius: 10px; font-size: 0.85rem; font-weight: 500; padding: 0.5rem 1rem; }
    .table-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; opacity: 1 !important; }
    .table-card .table { color: #212529 !important; font-size: 0.85rem; }
    .table-card .table thead th { background: #f0f0f5; color: #212529; border-color: #dee2e6; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
    .table-card .table td { border-color: #dee2e6; vertical-align: middle; color: #212529 !important; }
    .table-card .table tbody tr:hover { background: rgba(108,92,231,0.07); }
    .dataTables_wrapper .dataTables_filter input, .dataTables_wrapper .dataTables_length select { background: #ffffff; border: 1px solid #ced4da; color: #212529; border-radius: 8px; padding: 0.4rem 0.8rem; }
    .dataTables_wrapper .dataTables_info, .dataTables_wrapper .dataTables_paginate { color: #6c757d; margin-top: 1rem; }
    .dataTables_wrapper .dataTables_paginate .paginate_button { color: #495057 !important; background: #ffffff !important; border: 1px solid #dee2e6 !important; border-radius: 6px !important; margin: 0 2px; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: linear-gradient(135deg, #6c5ce7, #a855f7) !important; border-color: #6c5ce7 !important; color: #fff !important; }
    .dataTables_wrapper .dataTables_filter label, .dataTables_wrapper .dataTables_length label { color: #6c757d; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: #6c757d; }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; } }
  </style>
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle d-lg-none" onclick="toggleSidebar()" style="color:rgba(255,255,255,0.6);font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/admin/dashboard'}, {name:'Clients'}]}) %>
      </div>
      <div class="content-body">

        <div class="page-title-section">
          <h2><i class="fas fa-users me-2" style="color: #10b981;"></i>Gestion des Clients</h2>
        </div>

        <div class="action-bar d-flex gap-2 flex-wrap">
          <button class="btn btn-sm btn-outline-secondary" style="border-radius:10px;" onclick="printTable('customersTable','Liste des Clients')"><i class="fas fa-print me-1"></i>Imprimer</button>
          <button class="btn btn-sm btn-outline-danger" style="border-radius:10px;" onclick="exportTableToPDF('customersTable','clients','Liste des Clients')"><i class="fas fa-file-pdf me-1"></i>Export PDF</button>
          <button class="btn btn-sm btn-outline-success" style="border-radius:10px;" onclick="exportTableToExcel('customersTable','clients')"><i class="fas fa-file-excel me-1"></i>Export Excel</button>
        </div>

        <div class="table-card">
          <% if (typeof customers !== 'undefined' && customers && customers.length > 0) { %>
          <div class="table-responsive">
            <table id="customersTable" class="datatable table table-striped table-hover" style="width:100%">
              <thead>
                <tr>
                  <th><input type="checkbox" id="selectAll" onchange="toggleSelectAll(this)"></th>
                  <th>#</th>
                  <th>Nom</th>
                  <th>Prénom</th>
                  <th>Téléphone</th>
                  <th>Email</th>
                  <th>Adresse</th>
                  <th>Statut</th>
                  <th>Date Inscription</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% customers.forEach(function(client, index) { %>
                <tr>
                  <td><input type="checkbox" class="row-checkbox" value="<%= client.id_client %>"></td>
                  <td><%= index + 1 %></td>
                  <td><strong><%= client.nom || '' %></strong></td>
                  <td><%= client.prenom || '' %></td>
                  <td><%= client.telephone || '-' %></td>
                  <td><%= client.email || '-' %></td>
                  <td><%= client.adresse || '-' %></td>
                  <td>
                    <% var clientStatut = client.statut_compte || 'en_attente'; %>
                    <span class="badge bg-<%= clientStatut === 'actif' ? 'success' : (clientStatut === 'refuse' || clientStatut === 'refusé' ? 'danger' : 'warning') %>">
                      <%= clientStatut === 'actif' ? 'Actif' : (clientStatut === 'refuse' || clientStatut === 'refusé' ? 'Refusé' : 'En attente') %>
                    </span>
                  </td>
                  <td><%= client.date_creation ? new Date(client.date_creation).toLocaleDateString('fr-FR') : '-' %></td>
                  <td>
                    <div class="d-flex gap-1 flex-wrap">
                      <% if (clientStatut === 'en_attente') { %>
                      <form action="/admin/customers/approve/<%= client.id_utilisateur %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-success" style="border-radius:8px;font-size:0.75rem;font-weight:600;" title="Approuver" onclick="return confirmApprove(event)">
                          <i class="fas fa-check me-1"></i>Approuver
                        </button>
                      </form>
                      <form action="/admin/customers/reject/<%= client.id_utilisateur %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-warning" style="border-radius:8px;font-size:0.75rem;font-weight:600;" title="Refuser" onclick="return confirmReject(event)">
                          <i class="fas fa-times me-1"></i>Refuser
                        </button>
                      </form>
                      <% } else { %>
                      <button class="btn btn-sm btn-outline-secondary" style="border-radius:8px;font-size:0.75rem;font-weight:600;" type="button" onclick="modifierStatut('/admin/customers/approve/<%= client.id_utilisateur %>', '/admin/customers/reject/<%= client.id_utilisateur %>', 'Approuver', 'Refuser')">
                        <i class="fas fa-edit me-1"></i>Modifier Statut
                      </button>
                      <% } %>
                      <form action="/admin/customers/delete/<%= client.id_client %>" method="POST" class="d-inline" onsubmit="return confirmDelete(event, 'ce client')">
                        <button type="submit" class="btn btn-sm btn-danger" style="border-radius:8px;font-size:0.75rem;" title="Supprimer">
                          <i class="fas fa-trash"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="empty-state">
            <i class="fas fa-users"></i>
            <h5>Aucun client trouvé</h5>
            <p>Les clients apparaîtront ici après leur inscription.</p>
          </div>
          <% } %>
        </div>

      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/print.js"></script>
  <script>
    $(document).ready(function() {
      if ($('#customersTable').length) {
        
        if ($.fn.DataTable.isDataTable('#customersTable')) { $('#customersTable').DataTable().destroy(); }
        $('#customersTable').DataTable({
          language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json' },
          responsive: true,
          columnDefs: [{ orderable: false, targets: [0, 9] }],
          order: [[1, 'asc']]
        });
      }
    });
    function toggleSelectAll(el) { document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = el.checked); }
    function modifierStatut(approveUrl, rejectUrl, confirmLabel, denyLabel) {
      Swal.fire({
        title: 'Modifier le statut',
        icon: 'question',
        showDenyButton: true,
        showCancelButton: true,
        confirmButtonText: confirmLabel,
        denyButtonText: denyLabel,
        cancelButtonText: 'Annuler',
        confirmButtonColor: '#22c55e',
        denyButtonColor: '#ef4444',
        cancelButtonColor: '#6b7280'
      }).then(function(result) {
        if (result.isConfirmed) {
          var f = document.createElement('form'); f.method = 'POST'; f.action = approveUrl; document.body.appendChild(f); f.submit();
        } else if (result.isDenied) {
          var f = document.createElement('form'); f.method = 'POST'; f.action = rejectUrl; document.body.appendChild(f); f.submit();
        }
      });
    }
    function confirmApprove(e) {
      e.preventDefault();
      var form = e.target.closest('form');
      Swal.fire({ title: 'Approuver ce client ?', icon: 'question', showCancelButton: true, confirmButtonColor: '#22c55e', cancelButtonColor: '#6b7280', confirmButtonText: 'Oui, approuver', cancelButtonText: 'Annuler' }).then(function(r) { if (r.isConfirmed) form.submit(); });
      return false;
    }
    function confirmReject(e) {
      e.preventDefault();
      var form = e.target.closest('form');
      Swal.fire({ title: 'Refuser ce client ?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#f59e0b', cancelButtonColor: '#6b7280', confirmButtonText: 'Oui, refuser', cancelButtonText: 'Annuler' }).then(function(r) { if (r.isConfirmed) form.submit(); });
      return false;
    }
    function confirmDelete(e, name) {
      e.preventDefault();
      var form = e.target.closest('form');
      Swal.fire({ title: 'Êtes-vous sûr ?', text: 'Voulez-vous vraiment supprimer ' + name + ' ?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#ef4444', cancelButtonColor: '#6b7280', confirmButtonText: 'Oui, supprimer', cancelButtonText: 'Annuler' }).then(function(result) { if (result.isConfirmed) form.submit(); });
      return false;
    }
  </script>
</body>
</html>
