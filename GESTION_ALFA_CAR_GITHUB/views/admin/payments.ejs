<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Gestion des Paiements - Admin', extraCss: ['/css/dashboard.css', 'https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .page-title-section { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
    .page-title-section h2 { font-family: 'Poppins', sans-serif; font-weight: 700; color: #212529; margin: 0; font-size: 1.5rem; }
    .table-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; opacity: 1 !important; }
    .table-card .table { color: #212529 !important; font-size: 0.85rem; }
    .table-card .table thead th { background: #f0f0f5; color: #212529; border-color: #dee2e6; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
    .table-card .table td { border-color: #dee2e6; vertical-align: middle; color: #212529 !important; }
    .table-card .table td small { color: #6c757d !important; }
    .table-card .table td .text-muted { color: #6c757d !important; }
    .table-card .table tbody tr:hover { background: rgba(108,92,231,0.07); }
    /* Badge readability */
    .table-card .badge.bg-warning { color: #212529 !important; }
    .table-card .badge.bg-info { color: #fff !important; }
    /* Montant */
    .montant-cell { color: #198754 !important; font-weight: 700; }
    .dataTables_wrapper .dataTables_filter input, .dataTables_wrapper .dataTables_length select { background: #ffffff; border: 1px solid #ced4da; color: #212529; border-radius: 8px; padding: 0.4rem 0.8rem; }
    .dataTables_wrapper .dataTables_info, .dataTables_wrapper .dataTables_paginate { color: #6c757d; margin-top: 1rem; }
    .dataTables_wrapper .dataTables_paginate .paginate_button { color: #495057 !important; background: #ffffff !important; border: 1px solid #dee2e6 !important; border-radius: 6px !important; margin: 0 2px; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: linear-gradient(135deg, #6c5ce7, #a855f7) !important; border-color: #6c5ce7 !important; color: #fff !important; }
    .dataTables_wrapper .dataTables_filter label, .dataTables_wrapper .dataTables_length label { color: #6c757d; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: #6c757d; }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
    .table-responsive { overflow-x: auto !important; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; } }
  </style>
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle d-lg-none" onclick="toggleSidebar()" style="color:rgba(255,255,255,0.6);font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/admin/dashboard'}, {name:'Paiements'}]}) %>
      </div>
      <div class="content-body">
        <div class="page-title-section">
          <h2><i class="fas fa-credit-card me-2" style="color: #6c5ce7;"></i>Gestion des Paiements</h2>
        </div>

        <div class="action-bar mb-3 d-flex gap-2 flex-wrap">
          <button class="btn btn-sm btn-outline-secondary" style="border-radius:10px;" onclick="printTable('paymentsTable','Liste des Paiements')"><i class="fas fa-print me-1"></i>Imprimer</button>
          <button class="btn btn-sm btn-outline-danger" style="border-radius:10px;" onclick="exportTableToPDF('paymentsTable','paiements','Liste des Paiements')"><i class="fas fa-file-pdf me-1"></i>PDF</button>
          <button class="btn btn-sm btn-outline-success" style="border-radius:10px;" onclick="exportTableToExcel('paymentsTable','paiements')"><i class="fas fa-file-excel me-1"></i>Excel</button>
        </div>

        <div class="table-card">
          <% if (typeof payments !== 'undefined' && payments && payments.length > 0) { %>
          <div class="table-responsive">
            <table id="paymentsTable" class="table table-striped table-hover" style="width:100%">
              <thead>
                <tr>
                  <th><input type="checkbox" id="selectAll" class="form-check-input" onchange="document.querySelectorAll('.row-checkbox').forEach(c=>c.checked=this.checked)"></th>
                  <th>#</th>
                  <th>Vente</th>
                  <th>Voiture</th>
                  <th>Client</th>
                  <th>Montant</th>
                  <th>Type</th>
                  <th>Statut</th>
                  <th>Date</th>
                  <th>Détails Crédit</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% payments.forEach(function(p, index) { %>
                <tr>
                  <td><input type="checkbox" class="form-check-input row-checkbox" value="<%= p.id_paiement %>"></td>
                  <td><%= p.id_paiement %></td>
                  <td>#<%= p.id_vente %></td>
                  <td><strong><%= (p.marque || '') + ' ' + (p.modele || '') %></strong><br><small class="text-muted"><%= p.annee || '' %></small></td>
                  <td><strong><%= p.client_nom || '' %> <%= p.client_prenom || '' %></strong></td>
                  <td><strong class="montant-cell"><%= p.montant ? parseFloat(p.montant).toLocaleString('fr-FR') : '0' %> MAD</strong></td>
                  <td>
                    <% if (p.type_paiement === 'cash') { %>
                      <span class="badge" style="background:rgba(6,182,212,0.2);color:#22d3ee;border:1px solid rgba(6,182,212,0.3);"><i class="fas fa-money-bill me-1"></i>Cash</span>
                    <% } else { %>
                      <span class="badge" style="background:rgba(234,179,8,0.2);color:#fbbf24;border:1px solid rgba(234,179,8,0.3);"><i class="fas fa-credit-card me-1"></i>Crédit</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (p.statut === 'en_attente') { %>
                      <span class="badge" style="background:rgba(234,179,8,0.2);color:#fbbf24;border:1px solid rgba(234,179,8,0.3);"><i class="fas fa-clock me-1"></i>En attente</span>
                    <% } else if (p.statut === 'confirme') { %>
                      <span class="badge bg-success"><i class="fas fa-check me-1"></i>Confirmé</span>
                    <% } else { %>
                      <span class="badge bg-danger"><i class="fas fa-times me-1"></i>Refusé</span>
                    <% } %>
                  </td>
                  <td><%= p.date_paiement ? new Date(p.date_paiement).toLocaleDateString('fr-FR') : 'N/A' %></td>
                  <td>
                    <% if (p.type_paiement === 'credit') { %>
                      <small style="color:rgba(255,255,255,0.75);">
                        Avance: <%= p.montant_avance ? parseFloat(p.montant_avance).toLocaleString('fr-FR') : '0' %> MAD<br>
                        <%= p.nombre_mensualites || 0 %> mois × <%= p.mensualite ? parseFloat(p.mensualite).toLocaleString('fr-FR') : '0' %> MAD<br>
                        Taux: <%= p.taux_interet || 0 %>%
                      </small>
                    <% } else { %>
                      <span style="color:rgba(255,255,255,0.3);">—</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (p.statut === 'en_attente') { %>
                    <div class="d-flex gap-1 flex-wrap">
                      <form action="/admin/payments/approve/<%= p.id_paiement %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-success" style="border-radius:8px;font-size:0.75rem;font-weight:600;" onclick="return confirmAction(event,'Confirmer ce paiement ?')">
                          <i class="fas fa-check me-1"></i>Valider
                        </button>
                      </form>
                      <form action="/admin/payments/reject/<%= p.id_paiement %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger" style="border-radius:8px;font-size:0.75rem;font-weight:600;" onclick="return confirmAction(event,'Refuser ce paiement ?')">
                          <i class="fas fa-times me-1"></i>Refuser
                        </button>
                      </form>
                    </div>
                    <% } else { %>
                    <button class="btn btn-sm btn-outline-secondary" style="border-radius:8px;font-size:0.75rem;font-weight:600;" type="button" onclick="modifierStatut('/admin/payments/approve/<%= p.id_paiement %>', '/admin/payments/reject/<%= p.id_paiement %>', 'Valider', 'Refuser')">
                      <i class="fas fa-edit me-1"></i>Modifier Statut
                    </button>
                    <% } %>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="empty-state">
            <i class="fas fa-credit-card"></i>
            <h5>Aucun paiement trouvé</h5>
            <p>Les paiements apparaîtront ici une fois les ventes effectuées.</p>
          </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/print.js"></script>
  <script src="/js/export.js"></script>
  <script>
    $(document).ready(function() {
      if ($('#paymentsTable').length) {
        if ($.fn.DataTable.isDataTable('#paymentsTable')) { $('#paymentsTable').DataTable().destroy(); }
        $('#paymentsTable').DataTable({
          language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json' },
          scrollX: true, autoWidth: false, responsive: false,
          columnDefs: [{ orderable: false, targets: [0, 10] }],
          order: [[1, 'desc']]
        });
      }
    });
    function modifierStatut(approveUrl, rejectUrl, confirmLabel, denyLabel) {
      Swal.fire({
        title: 'Modifier le statut',
        icon: 'question',
        showDenyButton: true,
        showCancelButton: true,
        confirmButtonText: confirmLabel,
        denyButtonText: denyLabel,
        cancelButtonText: 'Annuler',
        confirmButtonColor: '#22c55e',
        denyButtonColor: '#ef4444',
        cancelButtonColor: '#6b7280'
      }).then(function(result) {
        if (result.isConfirmed) {
          var f = document.createElement('form'); f.method = 'POST'; f.action = approveUrl; document.body.appendChild(f); f.submit();
        } else if (result.isDenied) {
          var f = document.createElement('form'); f.method = 'POST'; f.action = rejectUrl; document.body.appendChild(f); f.submit();
        }
      });
    }
    function confirmAction(e, msg) {
      e.preventDefault();
      var form = e.target.closest('form');
      var isApprove = form.action.includes('approve');
      Swal.fire({
        title: msg, icon: 'question', showCancelButton: true,
        confirmButtonColor: isApprove ? '#22c55e' : '#ef4444',
        cancelButtonColor: '#6b7280',
        confirmButtonText: isApprove ? 'Oui, confirmer' : 'Oui, refuser',
        cancelButtonText: 'Retour'
      }).then(function(r) { if (r.isConfirmed) form.submit(); });
      return false;
    }
  </script>
</body>
</html>
