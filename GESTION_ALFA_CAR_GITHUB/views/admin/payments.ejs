<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Gestion des Paiements - Admin', extraCss: ['/css/dashboard.css', 'https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #0f0f23; color: #e2e8f0; margin: 0; }
    .main-content { min-height: 100vh; padding: 2rem; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .page-title-section { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
    .page-title-section h2 { font-family: 'Poppins', sans-serif; font-weight: 700; color: #fff; margin: 0; font-size: 1.5rem; }
    .table-card { background: #1a1a2e; border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 1.5rem; opacity: 1 !important; }
    .table-card .table { color: #e2e8f0; font-size: 0.85rem; }
    .table-card .table thead th { background: rgba(108,92,231,0.1); color: #ffffff; border-color: rgba(255,255,255,0.06); font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; opacity: 1; }
    .table-card .table td { border-color: rgba(255,255,255,0.04); vertical-align: middle; color: #ffffff; }
    .table-card .table tbody tr:hover { background: rgba(108,92,231,0.15); }
    .dataTables_wrapper .dataTables_filter input, .dataTables_wrapper .dataTables_length select { background: #161625; border: 1px solid rgba(255,255,255,0.1); color: #e2e8f0; border-radius: 8px; padding: 0.4rem 0.8rem; }
    .dataTables_wrapper .dataTables_info, .dataTables_wrapper .dataTables_paginate { color: #ffffff; margin-top: 1rem; opacity: 1; }
    .dataTables_wrapper .dataTables_paginate .paginate_button { color: #ffffff !important; background: transparent !important; border: 1px solid rgba(255,255,255,0.2) !important; border-radius: 6px !important; margin: 0 2px; opacity: 1; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: linear-gradient(135deg, #6c5ce7, #a855f7) !important; border-color: #6c5ce7 !important; color: #fff !important; }
    .dataTables_wrapper .dataTables_filter label, .dataTables_wrapper .dataTables_length label { color: #ffffff; opacity: 1; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: #ffffff; opacity: 1; }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
    @media (max-width: 991.98px) { .main-content { padding: 1rem; padding-top: 4rem; } }
  </style>
</head>
<body data-theme="light">
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle d-lg-none" onclick="toggleSidebar()" style="color:rgba(255,255,255,0.6);font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/admin/dashboard'}, {name:'Paiements'}]}) %>
      </div>
      <div class="content-body">
        <div class="page-title-section">
          <h2><i class="fas fa-credit-card me-2" style="color: #6c5ce7;"></i>Gestion des Paiements</h2>
        </div>

        <div class="action-bar mb-3">
          <button class="btn btn-outline-light btn-sm" onclick="printTable('paymentsTable','Liste des Paiements')"><i class="fas fa-print me-1"></i>Imprimer</button>
          <button class="btn btn-outline-danger btn-sm" onclick="exportTableToPDF('paymentsTable','paiements','Liste des Paiements')"><i class="fas fa-file-pdf me-1"></i>PDF</button>
          <button class="btn btn-outline-success btn-sm" onclick="exportTableToExcel('paymentsTable','paiements')"><i class="fas fa-file-excel me-1"></i>Excel</button>
        </div>

        <div class="table-card">
                    <% if (typeof payments !== 'undefined' && payments && payments.length > 0) { %>
                    <div class="table-responsive">
                        <table id="paymentsTable" class="table table-striped table-hover datatable">
                            <thead class="table-dark">
                                <tr>
                                    <th><input type="checkbox" id="selectAll" class="form-check-input"></th>
                                    <th>#</th>
                                    <th>Vente</th>
                                    <th>Client</th>
                                    <th>Montant</th>
                                    <th>Type</th>
                                    <th>Statut</th>
                                    <th>Date</th>
                                    <th>Détails Crédit</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% payments.forEach(function(p, index) { %>
                                <tr>
                                    <td><input type="checkbox" class="form-check-input row-checkbox" value="<%= p.id_paiement %>"></td>
                                    <td><%= p.id_paiement %></td>
                                    <td>#<%= p.id_vente %></td>
                                    <td><%= p.client_nom || '' %> <%= p.client_prenom || '' %></td>
                                    <td class="fw-bold text-primary"><%= p.montant ? parseFloat(p.montant).toLocaleString('fr-FR') : '0' %> MAD</td>
                                    <td>
                                        <% if (p.type_paiement === 'cash') { %>
                                            <span class="badge bg-info"><i class="fas fa-money-bill me-1"></i>Cash</span>
                                        <% } else { %>
                                            <span class="badge bg-warning text-dark"><i class="fas fa-credit-card me-1"></i>Crédit</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (p.statut === 'en_attente') { %>
                                            <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>En attente</span>
                                        <% } else if (p.statut === 'confirme') { %>
                                            <span class="badge bg-success"><i class="fas fa-check me-1"></i>Confirmé</span>
                                        <% } else { %>
                                            <span class="badge bg-danger"><i class="fas fa-times me-1"></i>Refusé</span>
                                        <% } %>
                                    </td>
                                    <td><%= p.date_paiement ? new Date(p.date_paiement).toLocaleDateString('fr-FR') : 'N/A' %></td>
                                    <td>
                                        <% if (p.type_paiement === 'credit') { %>
                                            <small>
                                                Avance: <%= p.montant_avance ? parseFloat(p.montant_avance).toLocaleString('fr-FR') : '0' %> MAD<br>
                                                <%= p.nombre_mensualites || 0 %> mois × <%= p.mensualite ? parseFloat(p.mensualite).toLocaleString('fr-FR') : '0' %> MAD<br>
                                                Taux: <%= p.taux_interet || 0 %>%
                                            </small>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (p.statut === 'en_attente') { %>
                                        <form action="/admin/payments/approve/<%= p.id_paiement %>" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-success" onclick="return confirmApprove(event)"><i class="fas fa-check"></i></button>
                                        </form>
                                        <form action="/admin/payments/reject/<%= p.id_paiement %>" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirmReject(event)"><i class="fas fa-times"></i></button>
                                        </form>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                    <div class="empty-state">
                        <i class="fas fa-credit-card"></i>
                        <h5>Aucun paiement trouvé</h5>
                        <p>Les paiements apparaîtront ici une fois les ventes effectuées.</p>
                    </div>
                    <% } %>
        </div>
        </div>
    </main>
</div>
<%- include('../partials/flash') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/main.js"></script>
<script src="/js/dashboard.js"></script>
<script src="/js/print.js"></script>
<script src="/js/export.js"></script>
</body></html>
