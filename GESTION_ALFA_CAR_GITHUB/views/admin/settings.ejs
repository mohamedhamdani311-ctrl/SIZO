<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Paramètres - Admin', extraCss: ['/css/dashboard.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .page-title-section { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
    .page-title-section h2 { font-family: 'Poppins', sans-serif; font-weight: 700; color: #212529; margin: 0; font-size: 1.5rem; }
    .table-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; opacity: 1 !important; }
    .table-card .card-header { background: transparent; border-bottom: 1px solid #dee2e6; padding-bottom: 1rem; margin-bottom: 1.2rem; }
    .table-card .card-header h5 { color: #fff !important; font-weight: 600; margin: 0; }
    .table-card .form-label { color: rgba(255,255,255,0.8) !important; font-weight: 500; font-size: 0.85rem; }
    .table-card .form-control, .table-card .form-select {
      background: rgba(30,30,70,0.9) !important;
      border: 1px solid rgba(255,255,255,0.15) !important;
      color: #212529 !important;
      border-radius: 10px;
    }
    .table-card .form-control:focus, .table-card .form-select:focus {
      border-color: #6c5ce7 !important;
      box-shadow: 0 0 0 3px rgba(108,92,231,0.2) !important;
      background: rgba(40,40,90,0.95) !important;
      color: #fff !important;
    }
    .table-card .form-control::placeholder { color: rgba(255,255,255,0.35) !important; }
    input:-webkit-autofill, input:-webkit-autofill:hover, input:-webkit-autofill:focus {
      -webkit-text-fill-color: #212529 !important;
      -webkit-box-shadow: 0 0 0 1000px #1a1a2e inset !important;
    }
    .avatar-circle { width: 80px; height: 80px; background: linear-gradient(135deg, #6c5ce7, #a855f7); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 2rem; margin: 0 auto 0.8rem; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; } }
  </style>
</head>
<body data-theme="dark">
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle d-lg-none" onclick="toggleSidebar()" style="color:rgba(255,255,255,0.6);font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/admin/dashboard'}, {name:'Paramètres'}]}) %>
      </div>
      <div class="content-body">
        <div class="page-title-section">
          <h2><i class="fas fa-cog me-2" style="color: #6c5ce7;"></i>Paramètres</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-6">
            <div class="table-card">
              <div class="card-header"><h5 class="mb-0"><i class="fas fa-building me-2" style="color:#06b6d4;"></i>Informations de l'Entreprise</h5></div>
              <form action="/admin/settings" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                  <label class="form-label">Logo de l'entreprise</label>
                  <input type="file" name="logo" class="form-control" accept="image/*">
                </div>
                <div class="mb-3">
                  <label class="form-label">Nom de l'entreprise</label>
                  <input type="text" name="company_name" class="form-control" value="ALFA CAR">
                </div>
                <div class="mb-3">
                  <label class="form-label">Adresse</label>
                  <input type="text" name="company_address" class="form-control" value="123 Boulevard Mohammed V, Casablanca">
                </div>
                <div class="mb-3">
                  <label class="form-label">Téléphone</label>
                  <input type="text" name="company_phone" class="form-control" value="+212 522 123456">
                </div>
                <div class="mb-3">
                  <label class="form-label">Email</label>
                  <input type="email" name="company_email" class="form-control" value="contact@alfacar.ma">
                </div>
                <button type="submit" class="btn btn-primary" style="background:linear-gradient(135deg,#6c5ce7,#a855f7);border:none;border-radius:10px;font-weight:600;padding:0.5rem 1.5rem;"><i class="fas fa-save me-2"></i>Sauvegarder</button>
              </form>
            </div>
          </div>
          <div class="col-md-6">
            <div class="table-card">
              <div class="card-header"><h5 class="mb-0"><i class="fas fa-user-shield me-2" style="color:#8b5cf6;"></i>Mon Profil</h5></div>
              <form action="/admin/profile" method="POST" enctype="multipart/form-data">
                <div class="text-center mb-3">
                  <div class="avatar-circle"><i class="fas fa-user"></i></div>
                  <input type="file" name="profile_picture" class="form-control form-control-sm" accept="image/*">
                </div>
                <div class="mb-3">
                  <label class="form-label">Nom</label>
                  <input type="text" name="nom" class="form-control" value="<%= user ? user.nom || '' : '' %>">
                </div>
                <div class="mb-3">
                  <label class="form-label">Prénom</label>
                  <input type="text" name="prenom" class="form-control" value="<%= user ? user.prenom || '' : '' %>">
                </div>
                <div class="mb-3">
                  <label class="form-label">Nouveau mot de passe</label>
                  <input type="password" name="new_password" class="form-control" placeholder="Laisser vide pour ne pas changer">
                </div>
                <button type="submit" class="btn btn-primary" style="background:linear-gradient(135deg,#6c5ce7,#a855f7);border:none;border-radius:10px;font-weight:600;padding:0.5rem 1.5rem;"><i class="fas fa-save me-2"></i>Mettre à jour</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
