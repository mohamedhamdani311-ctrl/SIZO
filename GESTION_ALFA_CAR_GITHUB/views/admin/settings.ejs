<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Paramètres - Admin', extraCss: ['/css/dashboard.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #0f0f23; color: #e2e8f0; margin: 0; }
    .main-content { min-height: 100vh; padding: 2rem; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .page-title-section { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
    .page-title-section h2 { font-family: 'Poppins', sans-serif; font-weight: 700; color: #fff; margin: 0; font-size: 1.5rem; }
    .table-card { background: #1a1a2e; border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 1.5rem; opacity: 1 !important; }
    .table-card label, .table-card .card-header h5 { color: #ffffff; }
    .table-card input { background: #161625; border: 1px solid rgba(255,255,255,0.1); color: #e2e8f0; }
    @media (max-width: 991.98px) { .main-content { padding: 1rem; padding-top: 4rem; } }
  </style>
</head>
<body data-theme="light">
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle d-lg-none" onclick="toggleSidebar()" style="color:rgba(255,255,255,0.6);font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/admin/dashboard'}, {name:'Paramètres'}]}) %>
      </div>
      <div class="content-body">
        <div class="page-title-section">
          <h2><i class="fas fa-cog me-2" style="color: #6c5ce7;"></i>Paramètres</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="table-card">
                        <div class="card-header"><h5 class="mb-0"><i class="fas fa-building me-2"></i>Informations de l'Entreprise</h5></div>
                        <div class="card-body">
                            <form action="/admin/settings" method="POST" enctype="multipart/form-data">
                                <div class="mb-3">
                                    <label class="form-label">Logo de l'entreprise</label>
                                    <input type="file" name="logo" class="form-control" accept="image/*">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Nom de l'entreprise</label>
                                    <input type="text" name="company_name" class="form-control" value="ALFA CAR">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Adresse</label>
                                    <input type="text" name="company_address" class="form-control" value="123 Boulevard Mohammed V, Casablanca">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Téléphone</label>
                                    <input type="text" name="company_phone" class="form-control" value="+212 522 123456">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Email</label>
                                    <input type="email" name="company_email" class="form-control" value="contact@alfacar.ma">
                                </div>
                                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Sauvegarder</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="table-card">
                        <div class="card-header"><h5 class="mb-0"><i class="fas fa-user-shield me-2"></i>Mon Profil</h5></div>
                        <div class="card-body">
                            <form action="/admin/profile" method="POST" enctype="multipart/form-data">
                                <div class="text-center mb-3">
                                    <div class="rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width:80px;height:80px;background:var(--accent);color:white;font-size:2rem;">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <input type="file" name="profile_picture" class="form-control form-control-sm" accept="image/*">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Nom</label>
                                    <input type="text" name="nom" class="form-control" value="<%= user ? user.nom || '' : '' %>">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Prénom</label>
                                    <input type="text" name="prenom" class="form-control" value="<%= user ? user.prenom || '' : '' %>">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Nouveau mot de passe</label>
                                    <input type="password" name="new_password" class="form-control" placeholder="Laisser vide pour ne pas changer">
                                </div>
                                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Mettre à jour</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
<%- include('../partials/flash') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/main.js"></script>
</body></html>
