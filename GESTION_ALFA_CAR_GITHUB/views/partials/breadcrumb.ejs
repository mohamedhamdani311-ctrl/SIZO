<% if (typeof breadcrumbs !== 'undefined' && breadcrumbs.length > 0) { %>
<nav aria-label="breadcrumb" class="mb-4">
  <ol class="breadcrumb bg-transparent p-0 mb-0">
    <li class="breadcrumb-item">
      <a href="/" class="text-decoration-none" style="color: var(--accent-color, #6c5ce7);">
        <i class="fas fa-home me-1"></i>Accueil
      </a>
    </li>
    <% breadcrumbs.forEach(function(crumb, index) { %>
      <% if (index < breadcrumbs.length - 1) { %>
        <li class="breadcrumb-item">
          <a href="<%= crumb.url %>" class="text-decoration-none" style="color: var(--accent-color, #6c5ce7);">
            <%= crumb.name %>
          </a>
        </li>
      <% } else { %>
        <li class="breadcrumb-item active" aria-current="page" style="color: var(--text-muted, #8892b0);">
          <%= crumb.name %>
        </li>
      <% } %>
    <% }); %>
  </ol>
</nav>
<% } %>
