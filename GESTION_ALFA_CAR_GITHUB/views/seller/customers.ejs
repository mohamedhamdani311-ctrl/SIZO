<%- include('../partials/head', {title: 'Clients - Vendeur', extraCss: '<link rel="stylesheet" href="/css/dashboard.css"><link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">'}) %>
<body data-theme="light">
<div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
        <div class="content-header">
            <button class="btn btn-link sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
            <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/seller'}, {name:'Clients'}]}) %>
        </div>
        <div class="content-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold"><i class="fas fa-users me-2"></i>Gestion des Clients</h2>
                <div class="btn-group">
                    <button class="btn btn-outline-secondary" onclick="printTable('customersTable','Clients')"><i class="fas fa-print me-1"></i>Imprimer</button>
                    <button class="btn btn-outline-danger" onclick="exportTableToPDF('customersTable','clients','Liste des Clients')"><i class="fas fa-file-pdf me-1"></i>PDF</button>
                    <button class="btn btn-outline-success" onclick="exportTableToExcel('customersTable','clients')"><i class="fas fa-file-excel me-1"></i>Excel</button>
                </div>
            </div>
            <div class="card shadow-sm"><div class="card-body">
                <% if(typeof customers!=='undefined' && customers && customers.length>0){ %>
                <div class="table-responsive"><table id="customersTable" class="table table-striped table-hover datatable">
                    <thead class="table-dark"><tr><th>#</th><th>Nom</th><th>Prénom</th><th>Téléphone</th><th>Email</th><th>Statut</th><th>Date</th><th>Actions</th></tr></thead>
                    <tbody><% customers.forEach(function(c){ %>
                    <tr>
                        <td><%= c.id_client %></td><td><%= c.nom %></td><td><%= c.prenom %></td><td><%= c.telephone||'N/A' %></td><td><%= c.email||'N/A' %></td>
                        <td><% if(c.statut_compte==='actif'){ %><span class="badge bg-success">Actif</span><% }else if(c.statut_compte==='en_attente'){ %><span class="badge bg-warning text-dark">En attente</span><% }else{ %><span class="badge bg-danger">Refusé</span><% } %></td>
                        <td><%= c.date_inscription?new Date(c.date_inscription).toLocaleDateString('fr-FR'):'N/A' %></td>
                        <td><% if(c.statut_compte==='en_attente'){ %>
                            <form action="/seller/customers/approve/<%= c.id_utilisateur %>" method="POST" class="d-inline"><button type="submit" class="btn btn-sm btn-success" onclick="return confirmApprove(event)"><i class="fas fa-check"></i></button></form>
                            <form action="/seller/customers/reject/<%= c.id_utilisateur %>" method="POST" class="d-inline"><button type="submit" class="btn btn-sm btn-danger" onclick="return confirmReject(event)"><i class="fas fa-times"></i></button></form>
                        <% }else{ %><span class="text-muted">-</span><% } %></td>
                    </tr><% }); %></tbody>
                </table></div>
                <% }else{ %><div class="text-center py-5"><i class="fas fa-users fa-4x text-muted mb-3"></i><h4 class="text-muted">Aucun client</h4></div><% } %>
            </div></div>
        </div>
    </main>
</div>
<%- include('../partials/flash') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/main.js"></script><script src="/js/dashboard.js"></script><script src="/js/print.js"></script><script src="/js/export.js"></script>
</body></html>
