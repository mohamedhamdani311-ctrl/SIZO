<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Tableau de Bord Vendeur', extraCss: ['/css/dashboard.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; max-width: calc(100vw - 175px); box-sizing: border-box; overflow-x: hidden; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .page-title { font-family: 'Poppins', sans-serif; font-weight: 700; color: #212529; margin: 0 0 1.5rem; font-size: 1.5rem; }
    .stat-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.25rem; display: flex; align-items: center; gap: 1rem; }
    .stat-card h3 { color: #212529; font-weight: 800; margin: 0; }
    .stat-card small { color: #6c757d; }
    .chart-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; }
    .chart-card .chart-title { font-weight: 700; color: #212529; margin-bottom: 1rem; font-size: 1rem; }
    .recent-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; }
    .recent-card .card-title { font-weight: 700; color: #212529; margin-bottom: 1rem; font-size: 1rem; border-bottom: 1px solid #dee2e6; padding-bottom: 0.75rem; }
    .recent-card .table { color: #212529; font-size: 0.85rem; margin: 0; }
    .recent-card .table thead th { background: #f0f0f5; color: #212529; border-color: #dee2e6; font-weight: 600; font-size: 0.78rem; }
    .recent-card .table td { border-color: #dee2e6; vertical-align: middle; color: #212529; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; max-width: 100%; } }
  </style>
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle" id="sidebarToggle" style="color:#495057;font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Tableau de Bord'}]}) %>
      </div>
      <div class="content-body">
        <h2 class="page-title"><i class="fas fa-tachometer-alt me-2" style="color:#6c5ce7;"></i>Tableau de Bord</h2>

        <div class="row g-4 mb-4">
          <div class="col-md-3">
            <div class="stat-card">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:52px;height:52px;background:linear-gradient(135deg,#74b9ff,#0984e3)">
                <i class="fas fa-car text-white fa-lg"></i>
              </div>
              <div><h3><%= typeof stats !== 'undefined' ? stats.totalCars || 0 : 0 %></h3><small>Voitures</small></div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:52px;height:52px;background:linear-gradient(135deg,#00b894,#00cec9)">
                <i class="fas fa-shopping-cart text-white fa-lg"></i>
              </div>
              <div><h3><%= typeof stats !== 'undefined' ? stats.totalSales || 0 : 0 %></h3><small>Mes Ventes</small></div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:52px;height:52px;background:linear-gradient(135deg,#fdcb6e,#e17055)">
                <i class="fas fa-calendar-check text-white fa-lg"></i>
              </div>
              <div><h3><%= typeof stats !== 'undefined' ? stats.totalReservations || 0 : 0 %></h3><small>Réservations</small></div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:52px;height:52px;background:linear-gradient(135deg,#a29bfe,#6c5ce7)">
                <i class="fas fa-user-clock text-white fa-lg"></i>
              </div>
              <div><h3><%= typeof stats !== 'undefined' ? stats.pendingAccounts || 0 : 0 %></h3><small>Comptes en attente</small></div>
            </div>
          </div>
        </div>

        <div class="row g-4 mb-4">
          <div class="col-md-6">
            <div class="chart-card">
              <div class="chart-title"><i class="fas fa-chart-line me-2" style="color:#e94560;"></i>Ventes par Mois</div>
              <canvas id="salesChart" height="250"></canvas>
            </div>
          </div>
          <div class="col-md-6">
            <div class="chart-card">
              <div class="chart-title"><i class="fas fa-chart-pie me-2" style="color:#6c5ce7;"></i>Voitures par Marque</div>
              <canvas id="brandsChart" height="250"></canvas>
            </div>
          </div>
        </div>

        <div class="row g-4">
          <div class="col-md-6">
            <div class="recent-card">
              <div class="card-title"><i class="fas fa-handshake me-2" style="color:#00b894;"></i>Ventes Récentes</div>
              <% if (typeof recentSales !== 'undefined' && recentSales && recentSales.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-hover">
                  <thead><tr><th>Client</th><th>Voiture</th><th>Montant</th><th>Statut</th></tr></thead>
                  <tbody>
                    <% recentSales.forEach(function(s) { %>
                    <tr>
                      <td><%= (s.client_nom || '') + ' ' + (s.client_prenom || '') %></td>
                      <td><%= (s.marque || '') + ' ' + (s.modele || '') %></td>
                      <td class="fw-bold" style="color:#198754;"><%= s.montant_total ? parseFloat(s.montant_total).toLocaleString('fr-FR') : '0' %> MAD</td>
                      <td>
                        <% if (s.statut_vente === 'validee') { %><span class="badge bg-success">Validée</span>
                        <% } else if (s.statut_vente === 'en_attente') { %><span class="badge bg-warning text-dark">En attente</span>
                        <% } else { %><span class="badge bg-danger">Annulée</span><% } %>
                      </td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
              <% } else { %><p class="text-muted text-center py-3 mb-0">Aucune vente récente</p><% } %>
            </div>
          </div>
          <div class="col-md-6">
            <div class="recent-card">
              <div class="card-title"><i class="fas fa-calendar-alt me-2" style="color:#0984e3;"></i>Réservations Récentes</div>
              <% if (typeof recentReservations !== 'undefined' && recentReservations && recentReservations.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-hover">
                  <thead><tr><th>Client</th><th>Voiture</th><th>Date</th><th>Statut</th></tr></thead>
                  <tbody>
                    <% recentReservations.forEach(function(r) { %>
                    <tr>
                      <td><%= (r.client_nom || '') + ' ' + (r.client_prenom || '') %></td>
                      <td><%= (r.marque || '') + ' ' + (r.modele || '') %></td>
                      <td><%= r.date_reservation ? new Date(r.date_reservation).toLocaleDateString('fr-FR') : 'N/A' %></td>
                      <td>
                        <% if (r.statut === 'confirmee') { %><span class="badge bg-success">Confirmée</span>
                        <% } else if (r.statut === 'en_attente') { %><span class="badge bg-warning text-dark">En attente</span>
                        <% } else { %><span class="badge bg-danger">Annulée</span><% } %>
                      </td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
              <% } else { %><p class="text-muted text-center py-3 mb-0">Aucune réservation récente</p><% } %>
            </div>
          </div>
        </div>

      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      <% if (typeof chartData !== 'undefined' && chartData) { %>
      const salesData = JSON.parse('<%- JSON.stringify(chartData.salesByMonth || []) %>');
      const brandsData = JSON.parse('<%- JSON.stringify(chartData.salesByBrand || []) %>');
      if (document.getElementById('salesChart')) {
        new Chart(document.getElementById('salesChart'), {
          type: 'line',
          data: {
            labels: salesData.map(function(d) { return d.month || d.mois || ''; }),
            datasets: [{ label: 'Ventes', data: salesData.map(function(d) { return d.total || d.count || 0; }), borderColor: '#e94560', backgroundColor: 'rgba(233,69,96,0.1)', fill: true, tension: 0.4 }]
          },
          options: { responsive: true, plugins: { legend: { display: false } } }
        });
      }
      if (document.getElementById('brandsChart')) {
        new Chart(document.getElementById('brandsChart'), {
          type: 'doughnut',
          data: {
            labels: brandsData.map(function(d) { return d.marque || ''; }),
            datasets: [{ data: brandsData.map(function(d) { return d.total || d.count || 0; }), backgroundColor: ['#e94560','#0984e3','#00b894','#fdcb6e','#6c5ce7','#e17055','#74b9ff','#a29bfe'] }]
          },
          options: { responsive: true }
        });
      }
      <% } %>
    });
  </script>
</body>
</html>
