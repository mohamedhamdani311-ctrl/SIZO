<%- include('../partials/head', {title: 'Tableau de Bord Vendeur', extraCss: '<link rel="stylesheet" href="/css/dashboard.css">'}) %>
<body data-theme="light">
<div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
        <div class="content-header">
            <button class="btn btn-link sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
            <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Tableau de Bord'}]}) %>
        </div>
        <div class="content-body">
            <h2 class="fw-bold mb-4"><i class="fas fa-tachometer-alt me-2"></i>Tableau de Bord</h2>
            <div class="row g-4 mb-4">
                <div class="col-md-3">
                    <div class="card shadow-sm border-0 stat-card">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width:50px;height:50px;background:linear-gradient(135deg,#74b9ff,#0984e3)"><i class="fas fa-car text-white fa-lg"></i></div>
                            <div><h3 class="mb-0 fw-bold"><%= typeof stats!=='undefined' ? stats.totalCars||0 : 0 %></h3><small class="text-muted">Voitures</small></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0 stat-card">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width:50px;height:50px;background:linear-gradient(135deg,#00b894,#00cec9)"><i class="fas fa-shopping-cart text-white fa-lg"></i></div>
                            <div><h3 class="mb-0 fw-bold"><%= typeof stats!=='undefined' ? stats.totalSales||0 : 0 %></h3><small class="text-muted">Mes Ventes</small></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0 stat-card">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width:50px;height:50px;background:linear-gradient(135deg,#fdcb6e,#e17055)"><i class="fas fa-calendar-check text-white fa-lg"></i></div>
                            <div><h3 class="mb-0 fw-bold"><%= typeof stats!=='undefined' ? stats.totalReservations||0 : 0 %></h3><small class="text-muted">Réservations</small></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0 stat-card">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width:50px;height:50px;background:linear-gradient(135deg,#a29bfe,#6c5ce7)"><i class="fas fa-user-clock text-white fa-lg"></i></div>
                            <div><h3 class="mb-0 fw-bold"><%= typeof stats!=='undefined' ? stats.pendingAccounts||0 : 0 %></h3><small class="text-muted">Comptes en attente</small></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row g-4 mb-4">
                <div class="col-md-6"><div class="card shadow-sm"><div class="card-header"><h5 class="mb-0">Ventes par Mois</h5></div><div class="card-body"><canvas id="salesChart" height="250"></canvas></div></div></div>
                <div class="col-md-6"><div class="card shadow-sm"><div class="card-header"><h5 class="mb-0">Voitures par Marque</h5></div><div class="card-body"><canvas id="brandsChart" height="250"></canvas></div></div></div>
            </div>
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card shadow-sm"><div class="card-header"><h5 class="mb-0">Ventes Récentes</h5></div><div class="card-body">
                        <% if(typeof recentSales!=='undefined' && recentSales && recentSales.length>0){ %>
                        <div class="table-responsive"><table class="table table-sm table-hover"><thead><tr><th>Client</th><th>Voiture</th><th>Montant</th><th>Statut</th></tr></thead><tbody>
                        <% recentSales.forEach(function(s){ %><tr><td><%= s.client_nom||'' %> <%= s.client_prenom||'' %></td><td><%= s.marque||'' %> <%= s.modele||'' %></td><td class="fw-bold"><%= s.montant_total?parseFloat(s.montant_total).toLocaleString('fr-FR'):'0' %> MAD</td><td><% if(s.statut_vente==='validee'){ %><span class="badge bg-success">Validée</span><% }else if(s.statut_vente==='en_attente'){ %><span class="badge bg-warning text-dark">En attente</span><% }else{ %><span class="badge bg-danger">Annulée</span><% } %></td></tr><% }); %>
                        </tbody></table></div><% }else{ %><p class="text-muted text-center py-3">Aucune vente récente</p><% } %>
                    </div></div>
                </div>
                <div class="col-md-6">
                    <div class="card shadow-sm"><div class="card-header"><h5 class="mb-0">Réservations Récentes</h5></div><div class="card-body">
                        <% if(typeof recentReservations!=='undefined' && recentReservations && recentReservations.length>0){ %>
                        <div class="table-responsive"><table class="table table-sm table-hover"><thead><tr><th>Client</th><th>Voiture</th><th>Date</th><th>Statut</th></tr></thead><tbody>
                        <% recentReservations.forEach(function(r){ %><tr><td><%= r.client_nom||'' %> <%= r.client_prenom||'' %></td><td><%= r.marque||'' %> <%= r.modele||'' %></td><td><%= r.date_reservation?new Date(r.date_reservation).toLocaleDateString('fr-FR'):'N/A' %></td><td><% if(r.statut==='confirmee'){ %><span class="badge bg-success">Confirmée</span><% }else if(r.statut==='en_attente'){ %><span class="badge bg-warning text-dark">En attente</span><% }else{ %><span class="badge bg-danger">Annulée</span><% } %></td></tr><% }); %>
                        </tbody></table></div><% }else{ %><p class="text-muted text-center py-3">Aucune réservation récente</p><% } %>
                    </div></div>
                </div>
            </div>
        </div>
    </main>
</div>
<%- include('../partials/flash') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/main.js"></script>
<script>
document.addEventListener('DOMContentLoaded',function(){
    <% if(typeof chartData!=='undefined' && chartData){ %>
    const salesData=JSON.parse('<%- JSON.stringify(chartData.salesByMonth||[]) %>');
    const brandsData=JSON.parse('<%- JSON.stringify(chartData.salesByBrand||[]) %>');
    if(document.getElementById('salesChart')){new Chart(document.getElementById('salesChart'),{type:'line',data:{labels:salesData.map(d=>d.month||d.mois||''),datasets:[{label:'Ventes',data:salesData.map(d=>d.total||d.count||0),borderColor:'#e94560',backgroundColor:'rgba(233,69,96,0.1)',fill:true,tension:0.4}]},options:{responsive:true,plugins:{legend:{display:false}}}});}
    if(document.getElementById('brandsChart')){new Chart(document.getElementById('brandsChart'),{type:'doughnut',data:{labels:brandsData.map(d=>d.marque||''),datasets:[{data:brandsData.map(d=>d.total||d.count||0),backgroundColor:['#e94560','#0984e3','#00b894','#fdcb6e','#6c5ce7','#e17055','#74b9ff','#a29bfe']}]},options:{responsive:true}});}
    <% } %>
});
</script>
</body></html>
