<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Paiements - Vendeur', extraCss: ['/css/dashboard.css', 'https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; max-width: calc(100vw - 175px); box-sizing: border-box; overflow-x: hidden; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .page-title { font-family: 'Poppins', sans-serif; font-weight: 700; color: #212529; margin: 0; font-size: 1.5rem; }
    .table-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; }
    .table-card .table { color: #212529; font-size: 0.85rem; }
    .table-card .table thead th { background: #f0f0f5; color: #212529; border-color: #dee2e6; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
    .table-card .table td { border-color: #dee2e6; vertical-align: middle; color: #212529 !important; }
    .table-card .table tbody tr:hover { background: rgba(108,92,231,0.06); }
    .montant { color: #198754 !important; font-weight: 700; }
    .dataTables_wrapper .dataTables_filter input,
    .dataTables_wrapper .dataTables_length select { background: #fff; border: 1px solid #ced4da; color: #212529; border-radius: 8px; padding: 0.4rem 0.8rem; }
    .dataTables_wrapper .dataTables_info, .dataTables_wrapper .dataTables_paginate { color: #6c757d; margin-top: 1rem; }
    .dataTables_wrapper .dataTables_paginate .paginate_button { color: #495057 !important; background: #fff !important; border: 1px solid #dee2e6 !important; border-radius: 6px !important; margin: 0 2px; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: linear-gradient(135deg,#6c5ce7,#a855f7) !important; border-color: #6c5ce7 !important; color: #fff !important; }
    .dataTables_wrapper .dataTables_filter label, .dataTables_wrapper .dataTables_length label { color: #6c757d; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: #6c757d; }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; max-width: 100%; } }
  </style>
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle" id="sidebarToggle" style="color:#495057;font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/seller/dashboard'}, {name:'Paiements'}]}) %>
      </div>
      <div class="content-body">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
          <h2 class="page-title"><i class="fas fa-credit-card me-2" style="color:#6c5ce7;"></i>Paiements</h2>
          <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" style="border-radius:10px;" onclick="printTable('paymentsTable','Paiements')"><i class="fas fa-print me-1"></i>Imprimer</button>
            <button class="btn btn-outline-danger" style="border-radius:10px;" onclick="exportTableToPDF('paymentsTable','paiements','Paiements')"><i class="fas fa-file-pdf me-1"></i>PDF</button>
            <button class="btn btn-outline-success" style="border-radius:10px;" onclick="exportTableToExcel('paymentsTable','paiements')"><i class="fas fa-file-excel me-1"></i>Excel</button>
          </div>
        </div>
        <div class="table-card">
          <% if (typeof payments !== 'undefined' && payments && payments.length > 0) { %>
          <div class="table-responsive">
            <table id="paymentsTable" class="table table-striped table-hover" style="width:100%">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Vente</th>
                  <th>Client</th>
                  <th>Montant</th>
                  <th>Type</th>
                  <th>Statut</th>
                  <th>Date</th>
                  <th>Détails Crédit</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% payments.forEach(function(p) { %>
                <tr>
                  <td><%= p.id_paiement %></td>
                  <td><strong>#<%= p.id_vente %></strong></td>
                  <td><%= (p.client_nom || '') + ' ' + (p.client_prenom || '') %></td>
                  <td><span class="montant"><%= p.montant ? parseFloat(p.montant).toLocaleString('fr-FR') : '0' %> MAD</span></td>
                  <td>
                    <% if (p.type_paiement === 'cash') { %><span class="badge bg-info text-dark">Cash</span>
                    <% } else { %><span class="badge bg-warning text-dark">Crédit</span><% } %>
                  </td>
                  <td>
                    <% if (p.statut === 'confirme') { %><span class="badge bg-success">Confirmé</span>
                    <% } else if (p.statut === 'en_attente') { %><span class="badge bg-warning text-dark">En attente</span>
                    <% } else { %><span class="badge bg-danger">Refusé</span><% } %>
                  </td>
                  <td><%= p.date_paiement ? new Date(p.date_paiement).toLocaleDateString('fr-FR') : 'N/A' %></td>
                  <td>
                    <% if (p.type_paiement === 'credit') { %>
                      <small class="text-muted">
                        Avance: <%= p.montant_avance ? parseFloat(p.montant_avance).toLocaleString('fr-FR') : '0' %> MAD<br>
                        <%= p.nombre_mensualites || 0 %> × <%= p.mensualite ? parseFloat(p.mensualite).toLocaleString('fr-FR') : '0' %> MAD
                      </small>
                    <% } else { %><span class="text-muted">—</span><% } %>
                  </td>
                  <td>
                    <% if (p.statut === 'en_attente') { %>
                    <div class="d-flex gap-1">
                      <form action="/seller/payments/approve/<%= p.id_paiement %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-success" style="border-radius:6px;" onclick="return confirmApprove(event)" title="Confirmer"><i class="fas fa-check"></i></button>
                      </form>
                      <form action="/seller/payments/reject/<%= p.id_paiement %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger" style="border-radius:6px;" onclick="return confirmReject(event)" title="Refuser"><i class="fas fa-times"></i></button>
                      </form>
                    </div>
                    <% } else { %>
                    <div class="dropdown">
                      <button class="btn btn-sm btn-outline-secondary dropdown-toggle" style="border-radius:6px;font-size:0.75rem;" type="button" data-bs-toggle="dropdown" title="Modifier Statut">
                        <i class="fas fa-edit"></i>
                      </button>
                      <ul class="dropdown-menu">
                        <li>
                          <form action="/seller/payments/approve/<%= p.id_paiement %>" method="POST">
                            <button type="submit" class="dropdown-item text-success" onclick="return confirmApprove(event)">
                              <i class="fas fa-check me-2"></i>Confirmer
                            </button>
                          </form>
                        </li>
                        <li>
                          <form action="/seller/payments/reject/<%= p.id_paiement %>" method="POST">
                            <button type="submit" class="dropdown-item text-danger" onclick="return confirmReject(event)">
                              <i class="fas fa-times me-2"></i>Refuser
                            </button>
                          </form>
                        </li>
                      </ul>
                    </div>
                    <% } %>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="empty-state">
            <i class="fas fa-credit-card"></i>
            <h5>Aucun paiement</h5>
          </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/print.js"></script>
  <script src="/js/export.js"></script>
  <script>
    $(document).ready(function() {
      if ($('#paymentsTable').length && !$.fn.DataTable.isDataTable('#paymentsTable')) {
        $('#paymentsTable').DataTable({
          language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json' },
          scrollX: true, scrollCollapse: true, autoWidth: true, responsive: false,
          columnDefs: [{ orderable: false, targets: [8] }],
          order: [[6, 'desc']]
        });
      }
    });
    function confirmApprove(e) {
      e.preventDefault(); var form = e.target.closest('form');
      Swal.fire({ title: 'Confirmer ce paiement ?', icon: 'question', showCancelButton: true, confirmButtonColor: '#22c55e', cancelButtonColor: '#6b7280', confirmButtonText: 'Oui, confirmer', cancelButtonText: 'Annuler' }).then(function(r) { if (r.isConfirmed) form.submit(); });
      return false;
    }
    function confirmReject(e) {
      e.preventDefault(); var form = e.target.closest('form');
      Swal.fire({ title: 'Refuser ce paiement ?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#ef4444', cancelButtonColor: '#6b7280', confirmButtonText: 'Oui, refuser', cancelButtonText: 'Annuler' }).then(function(r) { if (r.isConfirmed) form.submit(); });
      return false;
    }
  </script>
</body>
</html>
