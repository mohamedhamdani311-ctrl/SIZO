<%- include('../partials/head', {title: 'Ventes - Vendeur', extraCss: '<link rel="stylesheet" href="/css/dashboard.css"><link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">'}) %>
<style>
  .main-content { max-width: calc(100vw - 175px); box-sizing: border-box; overflow-x: hidden; }
  .dataTables_wrapper .dataTables_filter input,
  .dataTables_wrapper .dataTables_length select { background:#fff; border:1px solid #ced4da; color:#212529; border-radius:8px; padding:0.4rem 0.8rem; }
  .dataTables_wrapper .dataTables_info,
  .dataTables_wrapper .dataTables_paginate { color:#6c757d; margin-top:1rem; }
  .dataTables_wrapper .dataTables_paginate .paginate_button { color:#495057!important; background:#fff!important; border:1px solid #dee2e6!important; border-radius:6px!important; margin:0 2px; }
  .dataTables_wrapper .dataTables_paginate .paginate_button.current { background:linear-gradient(135deg,#6c5ce7,#a855f7)!important; border-color:#6c5ce7!important; color:#fff!important; }
  .dataTables_wrapper .dataTables_filter label,
  .dataTables_wrapper .dataTables_length label { color:#6c757d; }
  @media (max-width:991.98px) { .main-content { margin-left:0; max-width:100%; } }
</style>
<body data-theme="light">
<div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
        <div class="content-header">
            <button class="btn btn-link sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
            <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/seller'}, {name:'Ventes'}]}) %>
        </div>
        <div class="content-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold"><i class="fas fa-shopping-cart me-2"></i>Gestion des Ventes</h2>
                <div class="btn-group">
                    <button class="btn btn-outline-secondary" onclick="printTable('salesTable','Ventes')"><i class="fas fa-print me-1"></i>Imprimer</button>
                    <button class="btn btn-outline-danger" onclick="exportTableToPDF('salesTable','ventes','Liste des Ventes')"><i class="fas fa-file-pdf me-1"></i>PDF</button>
                    <button class="btn btn-outline-success" onclick="exportTableToExcel('salesTable','ventes')"><i class="fas fa-file-excel me-1"></i>Excel</button>
                </div>
            </div>
            <div class="card shadow-sm"><div class="card-body">
                <% if(typeof sales!=='undefined' && sales && sales.length>0){ %>
                <div class="table-responsive"><table id="salesTable" class="table table-striped table-hover datatable">
                    <thead class="table-dark"><tr><th>#</th><th>Client</th><th>Voiture</th><th>Montant</th><th>Type</th><th>Statut</th><th>Date</th><th>Actions</th></tr></thead>
                    <tbody><% sales.forEach(function(s){ %>
                    <tr>
                        <td><%= s.id_vente %></td>
                        <td><%= s.client_nom||'' %> <%= s.client_prenom||'' %></td>
                        <td><%= s.marque||'' %> <%= s.modele||'' %></td>
                        <td class="fw-bold text-primary"><%= s.montant_total?parseFloat(s.montant_total).toLocaleString('fr-FR'):'0' %> MAD</td>
                        <td><% if(s.type_paiement==='cash'){ %><span class="badge bg-info">Cash</span><% }else{ %><span class="badge bg-warning text-dark">Crédit</span><% } %></td>
                        <td><% if(s.statut_vente==='en_attente'){ %><span class="badge bg-warning text-dark">En attente</span><% }else if(s.statut_vente==='validee'){ %><span class="badge bg-success">Validée</span><% }else{ %><span class="badge bg-danger">Annulée</span><% } %></td>
                        <td><%= s.date_vente?new Date(s.date_vente).toLocaleDateString('fr-FR'):'N/A' %></td>
                        <td><% if(s.statut_vente==='en_attente'){ %>
                            <form action="/seller/sales/approve/<%= s.id_vente %>" method="POST" class="d-inline"><button type="submit" class="btn btn-sm btn-success" onclick="return confirmApprove(event)"><i class="fas fa-check"></i></button></form>
                            <form action="/seller/sales/reject/<%= s.id_vente %>" method="POST" class="d-inline"><button type="submit" class="btn btn-sm btn-danger" onclick="return confirmReject(event)"><i class="fas fa-times"></i></button></form>
                        <% }else{ %><span class="text-muted">-</span><% } %></td>
                    </tr><% }); %></tbody>
                </table></div>
                <% }else{ %><div class="text-center py-5"><i class="fas fa-shopping-cart fa-4x text-muted mb-3"></i><h4 class="text-muted">Aucune vente</h4></div><% } %>
            </div></div>
        </div>
    </main>
</div>
<%- include('../partials/flash') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/main.js"></script><script src="/js/dashboard.js"></script><script src="/js/print.js"></script><script src="/js/export.js"></script>
<script>
  $(document).ready(function() {
    if ($('#salesTable').length && !$.fn.DataTable.isDataTable('#salesTable')) {
      $('#salesTable').DataTable({
        language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json' },
        scrollX: true,
        scrollCollapse: true,
        autoWidth: true,
        responsive: false,
        order: [[6, 'desc']]
      });
    }
  });
</script>
</body></html>
