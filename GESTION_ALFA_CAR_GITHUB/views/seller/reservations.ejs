<%- include('../partials/head', {title: 'Réservations - Vendeur', extraCss: '<link rel="stylesheet" href="/css/dashboard.css"><link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">'}) %>
<body data-theme="light">
<div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
        <div class="content-header">
            <button class="btn btn-link sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
            <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/seller'}, {name:'Réservations'}]}) %>
        </div>
        <div class="content-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold"><i class="fas fa-calendar-alt me-2"></i>Réservations</h2>
                <div class="btn-group">
                    <button class="btn btn-outline-secondary" onclick="printTable('reservationsTable','Réservations')"><i class="fas fa-print me-1"></i>Imprimer</button>
                    <button class="btn btn-outline-danger" onclick="exportTableToPDF('reservationsTable','reservations','Réservations')"><i class="fas fa-file-pdf me-1"></i>PDF</button>
                    <button class="btn btn-outline-success" onclick="exportTableToExcel('reservationsTable','reservations')"><i class="fas fa-file-excel me-1"></i>Excel</button>
                </div>
            </div>
            <div class="card shadow-sm"><div class="card-body">
                <% if(typeof reservations!=='undefined' && reservations && reservations.length>0){ %>
                <div class="table-responsive"><table id="reservationsTable" class="table table-striped table-hover datatable">
                    <thead class="table-dark"><tr><th><input type="checkbox" id="selectAll" class="form-check-input"></th><th>#</th><th>Client</th><th>Voiture</th><th>Date</th><th>Expiration</th><th>Statut</th><th>Actions</th></tr></thead>
                    <tbody><% reservations.forEach(function(r){ %>
                    <tr>
                        <td><input type="checkbox" class="form-check-input row-checkbox" value="<%= r.id_reservation %>"></td>
                        <td><%= r.id_reservation %></td>
                        <td><%= r.client_nom||'' %> <%= r.client_prenom||'' %></td>
                        <td><%= r.marque||'' %> <%= r.modele||'' %></td>
                        <td><%= r.date_reservation?new Date(r.date_reservation).toLocaleDateString('fr-FR'):'N/A' %></td>
                        <td><%= r.date_expiration?new Date(r.date_expiration).toLocaleDateString('fr-FR'):'N/A' %></td>
                        <td><% if(r.statut==='en_attente'){ %><span class="badge bg-warning text-dark">En attente</span><% }else if(r.statut==='confirmee'){ %><span class="badge bg-success">Confirmée</span><% }else{ %><span class="badge bg-danger">Annulée</span><% } %></td>
                        <td><% if(r.statut==='en_attente'){ %>
                            <form action="/seller/reservations/approve/<%= r.id_reservation %>" method="POST" class="d-inline"><button type="submit" class="btn btn-sm btn-success" onclick="return confirmApprove(event)"><i class="fas fa-check"></i></button></form>
                            <form action="/seller/reservations/reject/<%= r.id_reservation %>" method="POST" class="d-inline"><button type="submit" class="btn btn-sm btn-danger" onclick="return confirmReject(event)"><i class="fas fa-times"></i></button></form>
                        <% }else{ %><span class="text-muted">-</span><% } %></td>
                    </tr><% }); %></tbody>
                </table></div>
                <% }else{ %><div class="text-center py-5"><i class="fas fa-calendar-alt fa-4x text-muted mb-3"></i><h4 class="text-muted">Aucune réservation</h4></div><% } %>
            </div></div>
        </div>
    </main>
</div>
<%- include('../partials/flash') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/main.js"></script><script src="/js/dashboard.js"></script><script src="/js/print.js"></script><script src="/js/export.js"></script>
</body></html>
