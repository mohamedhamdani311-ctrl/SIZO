<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', {title: 'Voitures - Vendeur', extraCss: ['/css/dashboard.css', 'https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css']}) %>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; color: #212529; margin: 0; }
    .main-content { margin-left: 175px; min-height: 100vh; padding: 2rem; max-width: calc(100vw - 175px); box-sizing: border-box; overflow-x: hidden; }
    .content-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #dee2e6; }
    .page-title { font-family: 'Poppins', sans-serif; font-weight: 700; color: #212529; margin: 0; font-size: 1.5rem; }
    .table-card { background: #ffffff; border: 1px solid #dee2e6; border-radius: 16px; padding: 1.5rem; }
    .table-card .table { color: #212529; font-size: 0.85rem; }
    .table-card .table thead th { background: #f0f0f5; color: #212529; border-color: #dee2e6; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
    .table-card .table td { border-color: #dee2e6; vertical-align: middle; color: #212529 !important; }
    .table-card .table tbody tr:hover { background: rgba(108,92,231,0.06); }
    .car-price { color: #6c5ce7 !important; font-weight: 700; }
    .dataTables_wrapper .dataTables_filter input,
    .dataTables_wrapper .dataTables_length select { background: #fff; border: 1px solid #ced4da; color: #212529; border-radius: 8px; padding: 0.4rem 0.8rem; }
    .dataTables_wrapper .dataTables_info, .dataTables_wrapper .dataTables_paginate { color: #6c757d; margin-top: 1rem; }
    .dataTables_wrapper .dataTables_paginate .paginate_button { color: #495057 !important; background: #fff !important; border: 1px solid #dee2e6 !important; border-radius: 6px !important; margin: 0 2px; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: linear-gradient(135deg,#6c5ce7,#a855f7) !important; border-color: #6c5ce7 !important; color: #fff !important; }
    .dataTables_wrapper .dataTables_filter label, .dataTables_wrapper .dataTables_length label { color: #6c757d; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: #6c757d; }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
    @media (max-width: 991.98px) { .main-content { margin-left: 0; padding: 1rem; padding-top: 4rem; max-width: 100%; } }
  </style>
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="content-header">
        <button class="btn btn-link sidebar-toggle" id="sidebarToggle" style="color:#495057;font-size:1.2rem;text-decoration:none;"><i class="fas fa-bars"></i></button>
        <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/seller/dashboard'}, {name:'Voitures'}]}) %>
      </div>
      <div class="content-body">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
          <h2 class="page-title"><i class="fas fa-car me-2" style="color:#0984e3;"></i>Gestion des Voitures</h2>
          <div class="d-flex gap-2 flex-wrap">
            <a href="/seller/cars/add" class="btn btn-primary" style="border-radius:10px;font-weight:600;"><i class="fas fa-plus me-1"></i>Ajouter Voiture</a>
            <button class="btn btn-outline-secondary" style="border-radius:10px;" onclick="printTable('carsTable','Voitures')"><i class="fas fa-print me-1"></i>Imprimer</button>
            <button class="btn btn-outline-danger" style="border-radius:10px;" onclick="exportTableToPDF('carsTable','voitures','Liste des Voitures')"><i class="fas fa-file-pdf me-1"></i>PDF</button>
            <button class="btn btn-outline-success" style="border-radius:10px;" onclick="exportTableToExcel('carsTable','voitures')"><i class="fas fa-file-excel me-1"></i>Excel</button>
          </div>
        </div>
        <div class="table-card">
          <% if (typeof cars !== 'undefined' && cars && cars.length > 0) { %>
          <div class="table-responsive">
            <table id="carsTable" class="table table-striped table-hover" style="width:100%">
              <thead>
                <tr>
                  <th><input type="checkbox" id="selectAll" class="form-check-input"></th>
                  <th>#</th>
                  <th>Image</th>
                  <th>Marque</th>
                  <th>Modèle</th>
                  <th>Année</th>
                  <th>Prix</th>
                  <th>Carburant</th>
                  <th>Boîte</th>
                  <th>Statut</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% cars.forEach(function(c) { %>
                <tr>
                  <td><input type="checkbox" class="form-check-input row-checkbox" value="<%= c.id_voiture %>"></td>
                  <td><%= c.id_voiture %></td>
                  <td>
                    <% if (c.image) { %>
                      <img src="<%= c.image %>" alt="" style="width:50px;height:35px;object-fit:cover;border-radius:6px;">
                    <% } else { %>
                      <div style="width:50px;height:35px;background:linear-gradient(135deg,#667eea,#764ba2);border-radius:6px;"></div>
                    <% } %>
                  </td>
                  <td><strong><%= c.marque %></strong></td>
                  <td><%= c.modele %></td>
                  <td><%= c.annee %></td>
                  <td><span class="car-price"><%= c.prix ? parseFloat(c.prix).toLocaleString('fr-FR') : '0' %> MAD</span></td>
                  <td><%= c.carburant %></td>
                  <td><%= c.boite_vitesse %></td>
                  <td>
                    <% if (c.statut === 'disponible') { %>
                      <span class="badge bg-success">Disponible</span>
                    <% } else { %>
                      <span class="badge bg-danger">Vendue</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/seller/cars/edit/<%= c.id_voiture %>" class="btn btn-sm btn-warning" style="border-radius:6px;"><i class="fas fa-edit"></i></a>
                      <form action="/seller/cars/delete/<%= c.id_voiture %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger" style="border-radius:6px;" onclick="return confirmDelete(event)"><i class="fas fa-trash"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="empty-state">
            <i class="fas fa-car"></i>
            <h5>Aucune voiture</h5>
            <a href="/seller/cars/add" class="btn btn-primary mt-2" style="border-radius:10px;"><i class="fas fa-plus me-1"></i>Ajouter une voiture</a>
          </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
  <%- include('../partials/flash') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/print.js"></script>
  <script src="/js/export.js"></script>
  <script>
    $(document).ready(function() {
      if ($('#carsTable').length && !$.fn.DataTable.isDataTable('#carsTable')) {
        $('#carsTable').DataTable({
          language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json' },
          scrollX: true, scrollCollapse: true, autoWidth: true, responsive: false,
          columnDefs: [{ orderable: false, targets: [0, 2, 10] }],
          order: [[1, 'desc']]
        });
      }
      $('#selectAll').on('change', function() { $('.row-checkbox').prop('checked', this.checked); });
    });
    function confirmDelete(e) {
      e.preventDefault();
      var form = e.target.closest('form');
      Swal.fire({ title: 'Supprimer cette voiture ?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#ef4444', cancelButtonColor: '#6b7280', confirmButtonText: 'Oui, supprimer', cancelButtonText: 'Annuler' }).then(function(r) { if (r.isConfirmed) form.submit(); });
      return false;
    }
  </script>
</body>
</html>
