<%- include('../partials/head', {title: 'Voitures - Vendeur', extraCss: '<link rel="stylesheet" href="/css/dashboard.css"><link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">'}) %>
<body data-theme="light">
<div class="dashboard-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
        <div class="content-header">
            <button class="btn btn-link sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
            <%- include('../partials/breadcrumb', {breadcrumbs: [{name:'Dashboard', url:'/seller'}, {name:'Voitures'}]}) %>
        </div>
        <div class="content-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold"><i class="fas fa-car me-2"></i>Gestion des Voitures</h2>
                <div>
                    <a href="/seller/cars/add" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Ajouter Voiture</a>
                    <button class="btn btn-outline-secondary" onclick="printTable('carsTable','Voitures')"><i class="fas fa-print me-1"></i></button>
                    <button class="btn btn-outline-danger" onclick="exportTableToPDF('carsTable','voitures','Liste des Voitures')"><i class="fas fa-file-pdf me-1"></i></button>
                    <button class="btn btn-outline-success" onclick="exportTableToExcel('carsTable','voitures')"><i class="fas fa-file-excel me-1"></i></button>
                </div>
            </div>
            <div class="card shadow-sm"><div class="card-body">
                <% if(typeof cars!=='undefined' && cars && cars.length>0){ %>
                <div class="table-responsive"><table id="carsTable" class="table table-striped table-hover datatable">
                    <thead class="table-dark"><tr><th><input type="checkbox" id="selectAll" class="form-check-input"></th><th>#</th><th>Image</th><th>Marque</th><th>Modèle</th><th>Année</th><th>Prix</th><th>Carburant</th><th>Boîte</th><th>Statut</th><th>Actions</th></tr></thead>
                    <tbody><% cars.forEach(function(c){ %>
                    <tr>
                        <td><input type="checkbox" class="form-check-input row-checkbox" value="<%= c.id_voiture %>"></td>
                        <td><%= c.id_voiture %></td>
                        <td><% if(c.image){ %><img src="<%= c.image %>" alt="" style="width:50px;height:35px;object-fit:cover;border-radius:4px"><% }else{ %><div style="width:50px;height:35px;background:linear-gradient(135deg,#667eea,#764ba2);border-radius:4px"></div><% } %></td>
                        <td><%= c.marque %></td><td><%= c.modele %></td><td><%= c.annee %></td>
                        <td class="fw-bold text-primary"><%= c.prix?parseFloat(c.prix).toLocaleString('fr-FR'):'0' %> MAD</td>
                        <td><%= c.carburant %></td><td><%= c.boite_vitesse %></td>
                        <td><% if(c.statut==='disponible'){ %><span class="badge bg-success">Disponible</span><% }else{ %><span class="badge bg-danger">Vendue</span><% } %></td>
                        <td>
                            <a href="/seller/cars/edit/<%= c.id_voiture %>" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i></a>
                            <form action="/seller/cars/delete/<%= c.id_voiture %>" method="POST" class="d-inline"><button type="submit" class="btn btn-sm btn-danger" onclick="return confirmDelete(event)"><i class="fas fa-trash"></i></button></form>
                        </td>
                    </tr><% }); %></tbody>
                </table></div>
                <% }else{ %><div class="text-center py-5"><i class="fas fa-car fa-4x text-muted mb-3"></i><h4 class="text-muted">Aucune voiture</h4><a href="/seller/cars/add" class="btn btn-primary mt-2">Ajouter une voiture</a></div><% } %>
            </div></div>
        </div>
    </main>
</div>
<%- include('../partials/flash') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/main.js"></script><script src="/js/dashboard.js"></script><script src="/js/print.js"></script><script src="/js/export.js"></script>
</body></html>
